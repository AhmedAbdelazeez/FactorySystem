@model IEnumerable<Bakery.Business.DTOs.SupplierSummaryDto>
@{
    ViewData["Title"] = "إدارة الموردين والفواتير";
    var summary = ViewBag.FinancialSummary as Bakery.Business.DTOs.SupplierFinancialSummaryDto ?? new Bakery.Business.DTOs.SupplierFinancialSummaryDto();
    var allInvoices = ViewBag.AllInvoices as IEnumerable<Bakery.Domain.Entities.SupplierInvoice> ?? new List<Bakery.Domain.Entities.SupplierInvoice>();
    var rawMaterials = ViewBag.RawMaterials as IEnumerable<Bakery.Domain.Entities.RawMaterial> ?? new List<Bakery.Domain.Entities.RawMaterial>();
}

<!-- Page Header -->
<div class="row mb-4 align-items-center">
    <div class="col">
        <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-truck-field text-warning me-2"></i> إدارة الموردين وفواتير التوريد</h2>
        <p class="text-muted mb-0">متابعة حسابات الموردين، الفواتير، المديونيات، والربط التلقائي بمخزن الخامات والخزينة</p>
    </div>
    <div class="col-auto d-flex gap-2">
        <button class="btn btn-success fw-bold" onclick="openAddInvoiceModal()">
            <i class="fa-solid fa-file-invoice-dollar me-1"></i> إضافة فاتورة جديدة
        </button>
        <button class="btn btn-bakery fw-bold" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
            <i class="fa-solid fa-user-plus me-1"></i> إضافة مورد جديد
        </button>
    </div>
</div>

<!-- 📊 Top Summary Cards 📊 -->
<div class="row g-3 mb-4">
    <!-- Total Inventory Value -->
    <div class="col-md-4">
        <div class="card card-custom border-0 bg-amber text-white p-3 shadow-sm h-100">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                    <i class="fa-solid fa-vault fs-2 text-white"></i>
                </div>
                <div>
                    <h6 class="text-white-50 fw-bold mb-1">إجمالي القيمة التي في المخزن</h6>
                    <h2 class="fw-extrabold mb-0">@summary.TotalInventoryValue.ToString("N2") <small class="fs-6">ج.م</small></h2>
                </div>
            </div>
        </div>
    </div>
    <!-- Total Indebtedness -->
    <div class="col-md-4">
        <div class="card card-custom border-0 bg-danger text-white p-3 shadow-sm h-100">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                    <i class="fa-solid fa-hand-holding-dollar fs-2 text-white"></i>
                </div>
                <div>
                    <h6 class="text-white-50 fw-bold mb-1">إجمالي المديونية للموردين</h6>
                    <h2 class="fw-extrabold mb-0">@summary.TotalIndebtedness.ToString("N2") <small class="fs-6">ج.م</small></h2>
                </div>
            </div>
        </div>
    </div>
    <!-- Total Paid -->
    <div class="col-md-4">
        <div class="card card-custom border-0 bg-success text-white p-3 shadow-sm h-100">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                    <i class="fa-solid fa-circle-check fs-2 text-white"></i>
                </div>
                <div>
                    <h6 class="text-white-50 fw-bold mb-1">إجمالي المدفوع للموردين</h6>
                    <h2 class="fw-extrabold mb-0">@summary.TotalPaidToSuppliers.ToString("N2") <small class="fs-6">ج.م</small></h2>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Nav Tabs -->
<ul class="nav nav-pills custom-pills mb-3" id="supplierTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold fs-6 px-4" id="suppliers-tab" data-bs-toggle="tab" data-bs-target="#suppliers-pane" type="button" role="tab">
            <i class="fa-solid fa-users me-2"></i> جدول الموردين الرئيسي (@Model.Count())
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold fs-6 px-4" id="invoices-tab" data-bs-toggle="tab" data-bs-target="#invoices-pane" type="button" role="tab">
            <i class="fa-solid fa-clock-rotate-left me-2"></i> سجل كافة الفواتير (History Log) (@allInvoices.Count())
        </button>
    </li>
</ul>

<div class="tab-content" id="supplierTabsContent">
    <!-- TAB 1: Main Suppliers Table (1 Row per Supplier, Updates automatically) -->
    <div class="tab-pane fade show active" id="suppliers-pane" role="tabpanel">
        <div class="card card-custom">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bakery mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>اسم المورد ورقم الهاتف</th>
                                <th>قائمة خامات المورد (Check List)</th>
                                <th>إجمالي الفواتير</th>
                                <th>إجمالي المدفوع</th>
                                <th>المتبقي (المديونية)</th>
                                <th>تاريخ آخر تعامل</th>
                                <th class="text-center">الإجراءات والتفاصيل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                foreach (var sup in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark fs-6">
                                                <i class="fa-solid fa-building text-primary me-2"></i> @sup.Name
                                            </div>
                                            @if (!string.IsNullOrEmpty(sup.Phone))
                                            {
                                                <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i> @sup.Phone</div>
                                            }
                                        </td>
                                        <td>
                                            @if (sup.SuppliedMaterialNames.Any())
                                            {
                                                foreach (var mat in sup.SuppliedMaterialNames)
                                                {
                                                    <span class="badge bg-light text-dark border me-1 mb-1"><i class="fa-solid fa-check text-success me-1"></i>@mat</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">لم تحدد خامات</span>
                                            }
                                        </td>
                                        <td class="fw-bold text-dark">@sup.TotalInvoicesValue.ToString("N2") ج.م</td>
                                        <td class="fw-bold text-success">@sup.TotalPaidAmount.ToString("N2") ج.م</td>
                                        <td>
                                            <span class="fw-bold fs-6 @(sup.TotalRemainingAmount > 0 ? "text-danger" : "text-success")">
                                                @sup.TotalRemainingAmount.ToString("N2") ج.م
                                            </span>
                                        </td>
                                        <td class="small text-muted">
                                            @(sup.LastTransactionDate?.ToString("yyyy/MM/dd") ?? "-")
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-success" title="إضافة فاتورة" onclick="openAddInvoiceModalForSupplier(@sup.Id)">
                                                    <i class="fa-solid fa-plus me-1"></i> فاتورة
                                                </button>
                                                <a asp-action="Details" asp-route-id="@sup.Id" class="btn btn-outline-primary" title="عرض التفاصيل وسجل الفواتير">
                                                    <i class="fa-solid fa-eye me-1"></i> التفاصيل
                                                </a>
                                                <button type="button"
                                                        class="btn btn-outline-secondary"
                                                        title="تعديل المورد وقائمة الخامات"
                                                        data-id="@sup.Id"
                                                        data-name="@sup.Name"
                                                        data-phone="@sup.Phone"
                                                        data-notes="@sup.Notes"
                                                        data-materials="@System.Text.Json.JsonSerializer.Serialize(sup.SuppliedMaterialIds ?? new List<int>())"
                                                        onclick="openEditSupplierModal(this)">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        title="حذف المورد"
                                                        onclick="confirmDelete(@sup.Id, '@Url.Action("DeleteSupplier", "Suppliers")', 'هل أنت متأكد من حذف المورد وكافة فواتيره؟ لا يمكن التراجع عن هذا الإجراء.')">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center p-4 text-muted">لا يوجد موردين مسجلين حالياً. اضغط على إضافة مورد جديد للبدء.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 2: All Invoices Log (History Table for every single invoice) -->
    <div class="tab-pane fade" id="invoices-pane" role="tabpanel">
        <div class="card card-custom">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bakery mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>رقم الفاتورة</th>
                                <th>اسم المورد</th>
                                <th>تاريخ الفاتورة</th>
                                <th>بيان الأصناف الموردة</th>
                                <th>إجمالي قيمة الفاتورة</th>
                                <th>المدفوع</th>
                                <th>المتبقي</th>
                                <th>حالة الدفع</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (allInvoices.Any())
                            {
                                foreach (var inv in allInvoices)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">
                                            <i class="fa-solid fa-receipt me-1"></i> @inv.InvoiceNumber
                                        </td>
                                        <td class="fw-bold text-dark">@(inv.Supplier?.Name ?? "-")</td>
                                        <td class="small">@inv.InvoiceDate.ToString("yyyy/MM/dd")</td>
                                        <td>
                                            @if (inv.Items != null && inv.Items.Any())
                                            {
                                                foreach (var item in inv.Items)
                                                {
                                                    <span class="badge bg-light text-dark border me-1">
                                                        @(item.RawMaterial?.MaterialName ?? "خامة") x @item.Quantity.ToString("0.###") (@item.UnitPrice.ToString("N0") ج.م)
                                                    </span>

                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">لا توجد بنود</span>
                                            }
                                        </td>
                                        <td class="fw-bold text-dark fs-6">@inv.TotalAmount.ToString("N2") ج.م</td>
                                        <td class="fw-bold text-success">@inv.PaidAmount.ToString("N2") ج.م</td>
                                        <td class="fw-bold @(inv.RemainingAmount > 0 ? "text-danger" : "text-muted")">
                                            @inv.RemainingAmount.ToString("N2") ج.م
                                        </td>
                                        <td>
                                            @if (inv.RemainingAmount == 0)
                                            {
                                                <span class="badge bg-success"><i class="fa-solid fa-check-double me-1"></i>مدفوع بالكامل</span>
                                            }
                                            else if (inv.PaidAmount > 0)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i>مدفوع جزئياً</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i>غير مدفوع</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Details" asp-route-id="@inv.SupplierId" class="btn btn-outline-primary" title="عرض تفاصيل فاتورة المورد">
                                                    <i class="fa-solid fa-eye"></i> التفاصيل
                                                </a>
                                                <button class="btn btn-outline-secondary" title="تعديل الفاتورة" onclick="openEditInvoiceModal(@inv.Id)">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        title="حذف الفاتورة"
                                                        onclick="confirmDelete('@inv.Id', '@Url.Action("DeleteInvoice", "Suppliers", new { id = inv.Id })', 'هل أنت متأكد من حذف الفاتورة رقم (#@inv.InvoiceNumber)؟ سيتم عكس جميع الكميات المضافة للمخازن، وحذف المصروفات وحركات الخزينة التابعة لها بالكامل.')">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                                @if (inv.RemainingAmount > 0)
                                                {
                                                    <button class="btn btn-outline-success" onclick="openPayInvoiceModal(@inv.Id, '@inv.InvoiceNumber', '@(inv.Supplier?.Name)', @inv.RemainingAmount)">
                                                        <i class="fa-solid fa-money-bill-wave me-1"></i> سداد
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center p-4 text-muted">لا توجد فواتير مسجلة حتى الآن.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🟢 Modal: Add Supplier (مع Check List للأصناف) 🟢 -->
<div class="modal fade" id="addSupplierModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-amber text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-1"></i> إضافة مورد جديد وتعيين الأصناف</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateSupplier" method="post">
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">اسم المورد / الشركة <span class="text-danger">*</span></label>
                        <input type="text" name="Name" required class="form-control" placeholder="مثال: شركة النيل للمطاحن" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">رقم الهاتف</label>
                        <input type="text" name="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">ملاحظات / العنوان</label>
                        <input type="text" name="Notes" class="form-control" placeholder="أي معلومات إضافية عن المورد..." />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold text-dark">
                            <i class="fa-solid fa-list-check text-warning me-1"></i> قائمة فحص الأصناف التي يوردها المورد (Check List)
                        </label>
                        <p class="small text-muted mb-2">اختر المواد الخام التي يمكن لهذا المورد التوريد منها للمصنع:</p>
                        <div class="row g-2 border rounded p-3 bg-light">
                            @foreach (var mat in rawMaterials)
                            {
                                <div class="col-md-4 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedRawMaterialIds" value="@mat.Id" id="add_mat_@mat.Id">
                                        <label class="form-check-label fw-bold text-dark" for="add_mat_@mat.Id">
                                            @mat.MaterialName <small class="text-muted">(@(mat.MeasurementUnit?.Name ?? ""))</small>
                                        </label>

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-bakery fw-bold">حفظ المورد والقائمة</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 🔵 Modal: Edit Supplier 🔵 -->
<div class="modal fade" id="editSupplierModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen me-1"></i> تعديل بيانات المورد وقائمة الأصناف</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditSupplier" method="post">
                <input type="hidden" name="Id" id="editSupplierId" />
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">اسم المورد / الشركة <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="editSupplierName" required class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">رقم الهاتف</label>
                        <input type="text" name="Phone" id="editSupplierPhone" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">ملاحظات / العنوان</label>
                        <input type="text" name="Notes" id="editSupplierNotes" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold text-dark">
                            <i class="fa-solid fa-list-check text-warning me-1"></i> قائمة فحص الأصناف (Check List)
                        </label>
                        <div class="row g-2 border rounded p-3 bg-light">
                            @foreach (var mat in rawMaterials)
                            {
                                <div class="col-md-4 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input edit-mat-checkbox" type="checkbox" name="SelectedRawMaterialIds" value="@mat.Id" id="edit_mat_@mat.Id">
                                        <label class="form-check-label fw-bold text-dark" for="edit_mat_@mat.Id">
                                            @mat.MaterialName <small class="text-muted">(@(mat.MeasurementUnit?.Name ?? ""))</small>
                                        </label>

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary fw-bold">تعديل البيانات</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 📜 Modal: Add Invoice (إضافة فاتورة توريد جديدة ينعكس أثرها فوراً على المخزن) 📜 -->
<div class="modal fade" id="addInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice-dollar me-1"></i> تسجيل فاتورة توريد جديدة للمورد</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateInvoice" method="post" id="addInvoiceForm" onsubmit="return validateInvoiceForm('addInvoiceForm')">
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">اختر المورد <span class="text-danger">*</span></label>
                        <select name="SupplierId" id="invoiceSupplierSelect" required class="form-select fs-6 fw-bold">
                            <option value="">-- اختر المورد --</option>
                            @foreach (var sup in Model)
                            {
                                <option value="@sup.Id">@sup.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">رقم الفاتورة</label>
                        <input type="text" name="InvoiceNumber" class="form-control" placeholder="تلقائي إن ترك فارغاً" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">تاريخ الفاتورة <span class="text-danger">*</span></label>
                        <input type="date" name="InvoiceDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required class="form-control" />
                    </div>

                    <!-- Line Items Table -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark mb-0">
                                <i class="fa-solid fa-boxes-stacked text-success me-1"></i> بنود الاصناف الموردة بالفاتورة (قائمة فحص المواد الخام)
                            </label>
                        </div>
                        <div class="table-responsive border rounded" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-bordered mb-0 align-middle" id="invoiceItemsTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;"></th>
                                        <th>اسم الخامة</th>
                                        <th style="width: 140px;">الكمية</th>
                                        <th style="width: 150px;">سعر الوحدة</th>
                                        <th style="width: 150px;">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody id="invoiceItemsTbody">
                                    <!-- Populated statically via JS on modal load -->
                                </tbody>
                                <tfoot>
                                    <tr class="table-warning fw-bold">
                                        <td colspan="4" class="text-end">إجمالي قيمة الفاتورة الكلي:</td>
                                        <td id="invoiceTotalDisplay" class="fs-5 text-dark">0.00 ج.م</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Payment Information -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
                        <select name="PaymentMethod" id="invoicePaymentMethod" class="form-select fw-bold" onchange="toggleInvoicePaidInput('add')">
                            <option value="@((int)PaymentMethod.Cash)">كاش (مدفوع بالكامل)</option>
                            <option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي (مدفوع بالكامل)</option>
                            <option value="@((int)PaymentMethod.PartiallyPaid)">مدفوع جزئياً</option>
                            <option value="@((int)PaymentMethod.Unpaid)" selected>غير مدفوع (آجل بالكامل)</option>
                        </select>
                    </div>
                    <div class="col-md-4" id="addInvoicePaidAmountContainer" style="display: none;">
                        <label class="form-label fw-bold">المبلغ المدفوع الآن (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" name="PaidAmount" id="invoicePaidAmount" value="0" class="form-control fw-bold text-success" autocomplete="off" oninput="validateInvoicePartialPayment('add')" />
                        <div id="invoicePaidAmountError" class="text-danger small fw-bold mt-1 d-none">
                            المبلغ المدفوع يجب أن يكون أقل من إجمالي الفاتورة وأكبر من صفر.
                        </div>
                    </div>
                    <div class="col-md-4" id="invoiceRemainingContainer" style="display: none;">
                        <label class="form-label fw-bold">المتبقي (المديونية)</label>
                        <div class="p-2 bg-danger bg-opacity-10 rounded text-center border border-danger">
                            <span id="invoiceRemainingDisplay" class="fs-6 fw-bold text-danger">0.00</span> ج.م
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">ملاحظات عن الفاتورة</label>
                        <input type="text" name="Notes" class="form-control" placeholder="تفاصيل أذونات الاستلام أو شروط السداد..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success fw-bold">حفظ الفاتورة وتحديث المخزن فوراً</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 💰 Modal: Pay Remaining Invoice Balance 💰 -->
<div class="modal fade" id="payInvoiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-money-bill-wave me-1"></i> سداد جزء من مديونية الفاتورة</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="PayInvoice" method="post">
                <input type="hidden" name="invoiceId" id="payInvoiceId" />
                <div class="modal-body row g-3">
                    <div class="col-12">
                        <p class="fw-bold mb-1">الفاتورة: <span id="payInvoiceNum" class="text-primary fs-5"></span></p>
                        <p class="fw-bold mb-1">المورد: <span id="paySupplierName" class="text-dark fs-6"></span></p>
                        <p class="fw-bold mb-0">المبلغ المتبقي الحالي: <span id="payRemainingAmount" class="text-danger fs-5"></span> ج.م</p>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">المبلغ المدفوع الآن (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="amountPaidNow" id="payAmountInput" required class="form-control fs-5 fw-bold text-success" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">طريقة السداد <span class="text-danger">*</span></label>
                        <select name="paymentMethod" class="form-select fw-bold">
                            <option value="@((int)PaymentMethod.Cash)">كاش</option>
                            <option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success fw-bold">تأكيد السداد وتسجيل الحركة بالخزينة</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 📜 Modal: Edit Invoice 📜 -->
<div class="modal fade" id="editInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-1"></i> تعديل فاتورة التوريد</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditInvoice" method="post" id="editInvoiceForm" onsubmit="return validateInvoiceForm('editInvoiceForm')">
                <input type="hidden" name="Id" id="editInvoiceId" />
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">اختر المورد <span class="text-danger">*</span></label>
                        <select name="SupplierId" id="editInvoiceSupplierSelect" required class="form-select fs-6 fw-bold">
                            <option value="">-- اختر المورد --</option>
                            @foreach (var sup in Model)
                            {
                                <option value="@sup.Id">@sup.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">رقم الفاتورة <span class="text-danger">*</span></label>
                        <input type="text" name="InvoiceNumber" id="editInvoiceNumber" required class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">تاريخ الفاتورة <span class="text-danger">*</span></label>
                        <input type="date" name="InvoiceDate" id="editInvoiceDate" required class="form-control" />
                    </div>

                    <!-- Line Items Table -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark mb-0">
                                <i class="fa-solid fa-boxes-stacked text-primary me-1"></i> بنود الاصناف الموردة بالفاتورة (قائمة فحص المواد الخام)
                            </label>
                        </div>
                        <div class="table-responsive border rounded" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-bordered mb-0 align-middle" id="editInvoiceItemsTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;"></th>
                                        <th>اسم الخامة</th>
                                        <th style="width: 140px;">الكمية</th>
                                        <th style="width: 150px;">سعر الوحدة</th>
                                        <th style="width: 150px;">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody id="editInvoiceItemsTbody">
                                    <!-- Populated statically via JS on modal load -->
                                </tbody>
                                <tfoot>
                                    <tr class="table-warning fw-bold">
                                        <td colspan="4" class="text-end">إجمالي قيمة الفاتورة الكلي:</td>
                                        <td id="editInvoiceTotalDisplay" class="fs-5 text-dark">0.00 ج.م</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Payment Information -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
                        <select name="PaymentMethod" id="editInvoicePaymentMethod" class="form-select fw-bold" onchange="toggleInvoicePaidInput('edit')">
                            <option value="@((int)PaymentMethod.Cash)">كاش (مدفوع بالكامل)</option>
                            <option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي (مدفوع بالكامل)</option>
                            <option value="@((int)PaymentMethod.PartiallyPaid)">مدفوع جزئياً</option>
                            <option value="@((int)PaymentMethod.Unpaid)" selected>غير مدفوع (آجل بالكامل)</option>
                        </select>
                    </div>
                    <div class="col-md-4" id="editInvoicePaidAmountContainer" style="display: none;">
                        <label class="form-label fw-bold">المبلغ المدفوع حالياً (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" name="PaidAmount" id="editInvoicePaidAmount" value="0" class="form-control fw-bold text-success" autocomplete="off" oninput="validateInvoicePartialPayment('edit')" />
                        <div id="editInvoicePaidAmountError" class="text-danger small fw-bold mt-1 d-none">
                            المبلغ المدفوع يجب أن يكون أقل من إجمالي الفاتورة وأكبر من صفر.
                        </div>
                    </div>
                    <div class="col-md-4" id="editInvoiceRemainingContainer" style="display: none;">
                        <label class="form-label fw-bold">المتبقي (المديونية)</label>
                        <div class="p-2 bg-danger bg-opacity-10 rounded text-center border border-danger">
                            <span id="editInvoiceRemainingDisplay" class="fs-6 fw-bold text-danger">0.00</span> ج.م
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">ملاحظات عن الفاتورة</label>
                        <input type="text" name="Notes" id="editInvoiceNotes" class="form-control" placeholder="تفاصيل إضافية..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary fw-bold">حفظ التعديلات وتحديث المخزن والخزينة</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. البيانات الأساسية للمواد الخام
        const rawMaterialsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rawMaterials.Select(m => new { id = m.Id, name = m.MaterialName, unit = m.MeasurementUnit?.Name ?? "", unitPrice = m.UnitPrice })));

        // 2. قيم Enum طرق الدفع
        const pmCash = "@((int)PaymentMethod.Cash)";
        const pmBank = "@((int)PaymentMethod.BankTransfer)";
        const pmPartial = "@((int)PaymentMethod.PartiallyPaid)";
        const pmUnpaid = "@((int)PaymentMethod.Unpaid)";

        // 3. فتح مودال تعديل بيانات المورد وقائمة الخامات (جديد 🟢)
        function openEditSupplierModal(btn) {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name') || '';
            const phone = btn.getAttribute('data-phone') || '';
            const notes = btn.getAttribute('data-notes') || '';

            let materials = [];
            try {
                materials = JSON.parse(btn.getAttribute('data-materials') || '[]');
            } catch (e) {
                console.error("Error parsing materials data", e);
            }

            // تعبئة البيانات في الحقول
            document.getElementById('editSupplierId').value = id;
            document.getElementById('editSupplierName').value = name;
            document.getElementById('editSupplierPhone').value = phone;
            document.getElementById('editSupplierNotes').value = notes;

            // إعادة ضبط الخانات وتحديد الخامات الخاصة بالمورد فقط
            document.querySelectorAll('.edit-mat-checkbox').forEach(chk => chk.checked = false);
            materials.forEach(matId => {
                const chk = document.getElementById('edit_mat_' + matId);
                if (chk) {
                    chk.checked = true;
                }
            });

            // إظهار المودال
            new bootstrap.Modal(document.getElementById('editSupplierModal')).show();
        }

        // 4. فتح مودال إضافة فاتورة جديدة
        function openAddInvoiceModal() {
            document.getElementById('invoiceSupplierSelect').value = '';

            const tbody = document.getElementById('invoiceItemsTbody');
            tbody.innerHTML = '';

            rawMaterialsData.forEach(m => {
                const tr = document.createElement('tr');
                tr.className = 'invoice-item-row';
                tr.id = `item_row_${m.id}`;
                tr.innerHTML = `
                                    <td class="text-center">
                                        <input class="form-check-input mat-checkbox" type="checkbox" id="chk_${m.id}" onchange="toggleRowInputs(${m.id}, 'add')" />
                                    </td>
                                    <td>
                                        <label class="fw-bold text-dark mb-0" for="chk_${m.id}">
                                            ${m.name} <small class="text-muted">(${m.unit})</small>
                                        </label>
                                        <input type="hidden" class="mat-id-input" value="${m.id}" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.001" class="form-control form-control-sm qty-input text-center fw-bold" value="0" disabled oninput="recalculateInvoiceTotal('add')" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm price-input text-center fw-bold text-success" value="${m.unitPrice}" disabled oninput="recalculateInvoiceTotal('add')" />
                                    </td>
                                    <td class="fw-bold line-total text-dark text-center fs-7">0.00 ج.م</td>
                                `;
                tbody.appendChild(tr);
            });

            recalculateInvoiceTotal('add');
            new bootstrap.Modal(document.getElementById('addInvoiceModal')).show();
        }

        // 5. فتح مودال إضافة فاتورة لمورد محدد
        function openAddInvoiceModalForSupplier(supplierId) {
            openAddInvoiceModal();
            document.getElementById('invoiceSupplierSelect').value = supplierId;
        }

        // 6. فتح مودال سداد مديونية الفاتورة
        function openPayInvoiceModal(invoiceId, invoiceNumber, supplierName, remainingAmount) {
            document.getElementById('payInvoiceId').value = invoiceId;
            document.getElementById('payInvoiceNum').innerText = '#' + invoiceNumber;
            document.getElementById('paySupplierName').innerText = supplierName || 'غير محدد';
            document.getElementById('payRemainingAmount').innerText = parseFloat(remainingAmount).toFixed(2);

            const payInput = document.getElementById('payAmountInput');
            if (payInput) {
                payInput.value = parseFloat(remainingAmount).toFixed(2);
                payInput.max = remainingAmount;
            }

            const modalElem = document.getElementById('payInvoiceModal');
            if (modalElem) {
                new bootstrap.Modal(modalElem).show();
            }
        }

        // 7. تفعيل / إيقاف مدخلات الصف عند الضغط على Checkbox
        function toggleRowInputs(matId, mode = 'add') {
            const tbodyId = mode === 'add' ? 'invoiceItemsTbody' : 'editInvoiceItemsTbody';
            const row = document.querySelector(`#${tbodyId} #item_row_${matId}`);
            if (!row) return;

            const checkbox = row.querySelector('.mat-checkbox');
            const qtyInput = row.querySelector('.qty-input');
            const priceInput = row.querySelector('.price-input');

            if (checkbox.checked) {
                qtyInput.disabled = false;
                priceInput.disabled = false;
                if (parseFloat(qtyInput.value) === 0) {
                    qtyInput.value = 1;
                }
            } else {
                qtyInput.disabled = true;
                priceInput.disabled = true;
                qtyInput.value = 0;
            }

            recalculateInvoiceTotal(mode);
        }

        // 8. إعادة حساب إجمالي الفاتورة وقيم البنود
        function recalculateInvoiceTotal(mode = 'add') {
            let total = 0;
            const tbodyId = mode === 'add' ? 'invoiceItemsTbody' : 'editInvoiceItemsTbody';
            const displayId = mode === 'add' ? 'invoiceTotalDisplay' : 'editInvoiceTotalDisplay';

            const rows = document.querySelectorAll(`#${tbodyId} .invoice-item-row`);
            rows.forEach(r => {
                const checkbox = r.querySelector('.mat-checkbox');
                if (checkbox && checkbox.checked) {
                    const qty = parseFloat(r.querySelector('.qty-input')?.value || 0);
                    const price = parseFloat(r.querySelector('.price-input')?.value || 0);
                    const lineTotal = qty * price;
                    total += lineTotal;
                    const lineTotalCell = r.querySelector('.line-total');
                    if (lineTotalCell) {
                        lineTotalCell.innerText = lineTotal.toFixed(2) + ' ج.م';
                    }
                } else {
                    const lineTotalCell = r.querySelector('.line-total');
                    if (lineTotalCell) {
                        lineTotalCell.innerText = '0.00 ج.م';
                    }
                }
            });

            const displayElem = document.getElementById(displayId);
            if (displayElem) {
                displayElem.innerText = total.toFixed(2) + ' ج.م';
            }

            toggleInvoicePaidInput(mode);
        }

        // 9. التحكم في إظهار وحساب حقول طرق الدفع والمتبقي
        function toggleInvoicePaidInput(mode = 'add') {
            const isAdd = mode === 'add';
            const pmSelect = document.getElementById(isAdd ? 'invoicePaymentMethod' : 'editInvoicePaymentMethod');
            if (!pmSelect) return;

            const pm = pmSelect.value;
            const totalDisplay = document.getElementById(isAdd ? 'invoiceTotalDisplay' : 'editInvoiceTotalDisplay');
            const total = parseFloat((totalDisplay?.innerText || '0').replace(/[^\d.-]/g, '')) || 0;

            const paidInp = document.getElementById(isAdd ? 'invoicePaidAmount' : 'editInvoicePaidAmount');
            const paidContainer = document.getElementById(isAdd ? 'addInvoicePaidAmountContainer' : 'editInvoicePaidAmountContainer');
            const remainingContainer = document.getElementById(isAdd ? 'invoiceRemainingContainer' : 'editInvoiceRemainingContainer');

            if (!paidInp) return;

            // كاش أو تحويل بنكي (مدفوع بالكامل)
            if (pm === pmCash || pm === pmBank) {
                if (paidContainer) paidContainer.style.display = "none";
                if (remainingContainer) remainingContainer.style.display = "none";
                paidInp.value = total > 0 ? total.toFixed(2) : '0.00';
                paidInp.required = false;
                clearInvoicePaymentError(mode);
                return;
            }

            // آجل (غير مدفوع)
            if (pm === pmUnpaid) {
                if (paidContainer) paidContainer.style.display = "none";
                if (remainingContainer) remainingContainer.style.display = "none";
                paidInp.value = '0.00';
                paidInp.required = false;
                clearInvoicePaymentError(mode);
                return;
            }

            // دفع جزئي
            if (pm === pmPartial) {
                if (paidContainer) paidContainer.style.display = "block";
                if (remainingContainer) remainingContainer.style.display = "block";
                paidInp.required = true;

                let currentPaid = parseFloat(paidInp.value) || 0;

                // في حالة الإضافة فقط أو عند عدم وجود قيمة سابقة يتم وضع نصف الإجمالي افتراضياً
                if (isAdd && (currentPaid === 0 || currentPaid >= total)) {
                    paidInp.value = total > 0 ? (total / 2).toFixed(2) : "0.00";
                }

                validateInvoicePartialPayment(mode);
            }
        }

        // 10. التحقق من الدفع الجزئي للحقول
        function validateInvoicePartialPayment(mode = 'add') {
            const isAdd = mode === 'add';
            const totalDisplay = document.getElementById(isAdd ? 'invoiceTotalDisplay' : 'editInvoiceTotalDisplay');
            const total = parseFloat((totalDisplay?.innerText || '0').replace(/[^\d.-]/g, '')) || 0;
            const paidInp = document.getElementById(isAdd ? 'invoicePaidAmount' : 'editInvoicePaidAmount');
            const paid = parseFloat(paidInp?.value || 0);

            if (paid <= 0) {
                showInvoicePaymentError("يجب إدخال مبلغ مدفوع أكبر من صفر.", mode);
                return false;
            }

            if (paid >= total && total > 0) {
                showInvoicePaymentError("في الدفع الجزئي، المبلغ المدفوع يجب أن يكون أقل من إجمالي الفاتورة.", mode);
                return false;
            }

            clearInvoicePaymentError(mode);

            const remaining = Math.max(total - paid, 0);
            const remElem = document.getElementById(isAdd ? 'invoiceRemainingDisplay' : 'editInvoiceRemainingDisplay');
            if (remElem) {
                remElem.innerText = remaining.toFixed(2);
            }

            return true;
        }

        // 11. إظهار وإخفاء رسائل أخطاء الدفع وتجميد زر الحفظ
        function showInvoicePaymentError(msg, mode = 'add') {
            const isAdd = mode === 'add';
            const err = document.getElementById(isAdd ? 'invoicePaidAmountError' : 'editInvoicePaidAmountError');
            const formId = isAdd ? 'addInvoiceForm' : 'editInvoiceForm';
            const btn = document.querySelector(`#${formId} button[type="submit"]`);

            if (err) {
                err.innerText = msg;
                err.classList.remove('d-none');
            }
            if (btn) btn.disabled = true;
        }

        function clearInvoicePaymentError(mode = 'add') {
            const isAdd = mode === 'add';
            const err = document.getElementById(isAdd ? 'invoicePaidAmountError' : 'editInvoicePaidAmountError');
            const formId = isAdd ? 'addInvoiceForm' : 'editInvoiceForm';
            const btn = document.querySelector(`#${formId} button[type="submit"]`);

            if (err) err.classList.add('d-none');
            if (btn) btn.disabled = false;
        }

        // 12. فتح مودال تعديل الفاتورة وتعبئة بياناتها
        async function openEditInvoiceModal(id) {
            try {
                const response = await fetch(`/Suppliers/GetInvoiceDetailsJson/${id}`);
                if (!response.ok) {
                    alert('خطأ أثناء تحميل بيانات الفاتورة.');
                    return;
                }
                const data = await response.json();

                document.getElementById('editInvoiceId').value = data.id;

                const supplierSelect = document.getElementById('editInvoiceSupplierSelect');
                if (supplierSelect) {
                    supplierSelect.value = data.supplierId;
                }

                document.getElementById('editInvoiceNumber').value = data.invoiceNumber;
                document.getElementById('editInvoiceDate').value = data.invoiceDate;
                document.getElementById('editInvoicePaymentMethod').value = data.paymentMethod;
                document.getElementById('editInvoicePaidAmount').value = data.paidAmount;
                document.getElementById('editInvoiceNotes').value = data.notes || '';

                const tbody = document.getElementById('editInvoiceItemsTbody');
                tbody.innerHTML = '';

                const invoiceItemsMap = {};
                data.items.forEach(item => {
                    invoiceItemsMap[item.rawMaterialId] = item;
                });

                rawMaterialsData.forEach(m => {
                    const invoiceItem = invoiceItemsMap[m.id];
                    const isChecked = invoiceItem !== undefined;

                    const tr = document.createElement('tr');
                    tr.className = 'invoice-item-row';
                    tr.id = `item_row_${m.id}`;
                    tr.innerHTML = `
                                        <td class="text-center">
                                            <input class="form-check-input mat-checkbox" type="checkbox" id="edit_chk_${m.id}" ${isChecked ? 'checked' : ''} onchange="toggleRowInputs(${m.id}, 'edit')" />
                                        </td>
                                        <td>
                                            <label class="fw-bold text-dark mb-0" for="edit_chk_${m.id}">
                                                ${m.name} <small class="text-muted">(${m.unit})</small>
                                            </label>
                                            <input type="hidden" class="mat-id-input" value="${m.id}" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.001" class="form-control form-control-sm qty-input text-center fw-bold" value="${isChecked ? invoiceItem.quantity : 0}" ${isChecked ? '' : 'disabled'} oninput="recalculateInvoiceTotal('edit')" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control form-control-sm price-input text-center fw-bold text-success" value="${isChecked ? invoiceItem.unitPrice : m.unitPrice}" ${isChecked ? '' : 'disabled'} oninput="recalculateInvoiceTotal('edit')" />
                                        </td>
                                        <td class="fw-bold line-total text-dark text-center fs-7">0.00 ج.م</td>
                                    `;
                    tbody.appendChild(tr);
                });

                recalculateInvoiceTotal('edit');
                new bootstrap.Modal(document.getElementById('editInvoiceModal')).show();
            } catch (err) {
                console.error(err);
                alert('خطأ في الاتصال بالخادم.');
            }
        }

        // 13. التحقق من صحة الفاتورة قبل الإرسال
        function validateInvoiceForm(formId) {
            const form = document.getElementById(formId);
            if (!form) return false;

            const mode = formId === 'addInvoiceForm' ? 'add' : 'edit';
            const pmSelect = form.querySelector('[name="PaymentMethod"]');
            const pm = pmSelect ? pmSelect.value : '';

            let hasChecked = false;
            const checkboxes = form.querySelectorAll('.mat-checkbox');
            checkboxes.forEach(chk => {
                if (chk.checked) hasChecked = true;
            });

            if (!hasChecked) {
                alert("خطأ: يجب اختيار مادة خام واحدة على الأقل وتوريدها بالفاتورة!");
                return false;
            }

            if (pm === pmPartial) {
                const isValid = validateInvoicePartialPayment(mode);
                if (!isValid) return false;
            }

            prepareInvoiceSubmit(formId);
            return true;
        }

        // 14. تجهيز أسماء مدخلات البنود للإرسال بأسماء مصفوفة C# (Items[i].Prop)
        function prepareInvoiceSubmit(formId) {
            const form = document.getElementById(formId);
            let seqIndex = 0;

            const rows = form.querySelectorAll('.invoice-item-row');
            rows.forEach(row => {
                const checkbox = row.querySelector('.mat-checkbox');
                const matSelect = row.querySelector('.mat-id-input');
                const qtyInput = row.querySelector('.qty-input');
                const priceInput = row.querySelector('.price-input');

                if (checkbox && checkbox.checked) {
                    matSelect.name = `Items[${seqIndex}].RawMaterialId`;
                    qtyInput.name = `Items[${seqIndex}].Quantity`;
                    priceInput.name = `Items[${seqIndex}].UnitPrice`;
                    seqIndex++;
                } else {
                    matSelect.removeAttribute('name');
                    qtyInput.removeAttribute('name');
                    priceInput.removeAttribute('name');
                }
            });
            return true;
        }

        
    </script>
}