@model Bakery.Domain.Entities.Supplier
@{
    ViewData["Title"] = $"تفاصيل المورد - {Model.Name}";
    var summary = ViewBag.Summary as Bakery.Business.DTOs.SupplierSummaryDto ?? new Bakery.Business.DTOs.SupplierSummaryDto();
    var rawMaterials = ViewBag.RawMaterials as IEnumerable<Bakery.Domain.Entities.RawMaterial> ?? new List<Bakery.Domain.Entities.RawMaterial>();
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <a asp-action="Index" class="btn btn-outline-secondary mb-2"><i class="fa-solid fa-arrow-right me-1"></i> العودة لقائمة الموردين</a>
        <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-building text-warning me-2"></i> @Model.Name</h2>
        <p class="text-muted mb-0">سجل فواتير التوريد، كشف الحساب والمديونية، وقائمة الأصناف المعتمدة للمورد</p>
    </div>
    <div class="col-auto d-flex gap-2">
        <button class="btn btn-success fw-bold" onclick="openAddInvoiceModalForSupplier(@Model.Id)">
            <i class="fa-solid fa-plus me-1"></i> إضافة فاتورة جديدة لهذا المورد
        </button>
    </div>
</div>

<!-- Supplier Header Profile & Financial Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom h-100 p-4 border-start border-primary border-4">
            <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-id-card text-primary me-2"></i> بيانات المورد</h5>
            <p class="mb-1"><strong>رقم الهاتف:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "غير مسجل" : Model.Phone)</p>
            <p class="mb-1"><strong>تاريخ الإضافة:</strong> @Model.CreatedAt.ToString("yyyy/MM/dd")</p>
            <p class="mb-2"><strong>ملاحظات:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "لا توجد" : Model.Notes)</p>
            <hr class="my-2" />
            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-list-check text-warning me-1"></i> الأصناف التي يوردها (Check List):</h6>
            <div>
                @if (Model.SuppliedMaterials != null && Model.SuppliedMaterials.Any())
                {
                    foreach (var sm in Model.SuppliedMaterials)
                    {
                        <span class="badge bg-light text-dark border me-1 mb-1 fs-6">
                            <i class="fa-solid fa-circle-check text-success me-1"></i>@(sm.RawMaterial?.MaterialName ?? "-")
                        </span>

                    }
                }
                else
                {
                    <span class="text-muted small">لم يتم تحديد قائمة أصناف لهذا المورد بعد.</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card card-custom p-3 bg-light-primary border-0 text-center h-100">
                    <h6 class="text-muted fw-bold mb-1">إجمالي الفواتير الموردة</h6>
                    <h3 class="fw-extrabold text-primary mb-0">@summary.TotalInvoicesValue.ToString("N2") <small class="fs-6">ج.م</small></h3>
                    <span class="small text-muted mt-1">عدد الفواتير: (@Model.Invoices.Count)</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-custom p-3 bg-light-success border-0 text-center h-100">
                    <h6 class="text-muted fw-bold mb-1">إجمالي ما تم سداده</h6>
                    <h3 class="fw-extrabold text-success mb-0">@summary.TotalPaidAmount.ToString("N2") <small class="fs-6">ج.م</small></h3>
                    <span class="small text-muted mt-1">المسدد للخزينة</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-custom p-3 bg-light-danger border-0 text-center h-100">
                    <h6 class="text-muted fw-bold mb-1">المديونية المتبقية</h6>
                    <h3 class="fw-extrabold text-danger mb-0">@summary.TotalRemainingAmount.ToString("N2") <small class="fs-6">ج.م</small></h3>
                    <span class="small text-muted mt-1">مستحق للمورد</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 📜 History log of all Invoices for this Supplier 📜 -->
<div class="card card-custom">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-clock-rotate-left text-warning me-2"></i> سجل الفواتير وحسابات المورد (History)
        </h5>
        <span class="badge bg-secondary">@Model.Invoices.Count() فاتورة</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Invoices != null && Model.Invoices.Any())
        {
            <div class="accordion accordion-flush" id="supplierInvoicesAccordion">
                @foreach (var inv in Model.Invoices)
                {
                    var accordionId = $"inv_collapse_{inv.Id}";
                    <div class="accordion-item border-bottom">
                        <h2 class="accordion-header" id="heading_@inv.Id">
                            <button class="accordion-button collapsed py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@accordionId">
                                <div class="row w-100 align-items-center me-2">
                                    <div class="col-md-3">
                                        <span class="fw-bold text-primary fs-6"><i class="fa-solid fa-file-invoice me-2"></i>#@inv.InvoiceNumber</span>
                                    </div>
                                    <div class="col-md-2 small text-muted">
                                        <i class="fa-solid fa-calendar me-1"></i>@inv.InvoiceDate.ToString("yyyy/MM/dd")
                                    </div>
                                    <div class="col-md-3 fw-bold text-dark">
                                        الإجمالي: @inv.TotalAmount.ToString("N2") ج.م
                                    </div>
                                    <div class="col-md-2">
                                        @if (inv.RemainingAmount == 0)
                                        {
                                            <span class="badge bg-success"><i class="fa-solid fa-check-double me-1"></i>خالصة بالكامل</span>
                                        }
                                        else if (inv.PaidAmount > 0)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i>متبقي: @inv.RemainingAmount.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>غير مدفوعة</span>
                                        }
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <span class="small text-decoration-underline text-primary">عرض تفاصيل الفاتورة <i class="fa-solid fa-chevron-down ms-1"></i></span>
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="@accordionId" class="accordion-collapse collapse" data-bs-parent="#supplierInvoicesAccordion">
                            <div class="accordion-body bg-light p-4">
                                <div class="row mb-3">
                                    <div class="col-md-8">
                                        <h6 class="fw-bold text-dark mb-1">تفاصيل الأصناف والكميات الواردة بالفاتورة:</h6>
                                        <p class="small text-muted mb-0">تم انعكاس الكميات والأسعار فورياً بـ <a asp-controller="Inventory" asp-action="Index">مخزن المواد الخام</a></p>
                                    </div>
                                    <div class="col-md-4 text-md-end">
                                        <button class="btn btn-sm btn-outline-primary fw-bold me-1" onclick="openEditInvoiceModal(@inv.Id)">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> تعديل الفاتورة
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger fw-bold me-1"
                                                onclick="confirmDelete('@inv.Id', '@Url.Action("DeleteInvoice", "Suppliers", new { id = inv.Id, returnSupplierId = Model.Id })', 'هل أنت متأكد من حذف الفاتورة رقم (#@inv.InvoiceNumber)؟ سيتم عكس جميع الكميات المضافة للمخازن، وحذف المصروفات وحركات الخزينة التابعة لها بالكامل.')"
                                                title="حذف الفاتورة">
                                            <i class="fa-solid fa-trash me-1"></i> حذف الفاتورة
                                        </button>
                                        @if (inv.RemainingAmount > 0)
                                        {
                                            <button class="btn btn-sm btn-success fw-bold" onclick="openPayInvoiceModal(@inv.Id, '@inv.InvoiceNumber', '@Model.Name', @inv.RemainingAmount)">
                                                <i class="fa-solid fa-money-bill-wave me-1"></i> سداد مديونية الفاتورة
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- Items Table -->
                                <div class="table-responsive border rounded bg-white mb-3">
                                    <table class="table table-sm table-striped mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>اسم المادة الخام الموردة</th>
                                                <th>الكمية الموردة</th>
                                                <th>وحدة القياس</th>
                                                <th>سعر الشكارة / الوحدة</th>
                                                <th>إجمالي بند المادة الخام</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (inv.Items != null && inv.Items.Any())
                                            {
                                                foreach (var item in inv.Items)
                                                {
                                                    <tr>
                                                        <td class="fw-bold text-dark">
                                                            <i class="fa-solid fa-box text-warning me-2"></i>@(item.RawMaterial?.MaterialName ?? "-")
                                                        </td>

                                                        <td class="fw-bold fs-6">@item.Quantity.ToString("0.###")</td>
                                                        <td><span class="badge bg-light text-dark border">@(item.RawMaterial?.MeasurementUnit?.Name ?? "-")</span></td>
                                                        <td>@item.UnitPrice.ToString("N2") ج.م</td>
                                                        <td class="fw-bold text-primary">@item.TotalAmount.ToString("N2") ج.م</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted">لا توجد بنود مسجلة هذه الفاتورة.</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="table-warning fw-bold">
                                                <td colspan="4" class="text-end">إجمالي الفاتورة:</td>
                                                <td class="fs-6 text-dark">@inv.TotalAmount.ToString("N2") ج.م</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                <!-- Financial Breakdown of Invoice -->
                                <div class="row g-2 bg-white p-3 rounded border">
                                    <div class="col-md-4">
                                        <span class="text-muted">المبلغ المدفوع:</span>
                                        <span class="fw-bold text-success ms-1">@inv.PaidAmount.ToString("N2") ج.م</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="text-muted">المبلغ المتبقي:</span>
                                        <span class="fw-bold text-danger ms-1">@inv.RemainingAmount.ToString("N2") ج.م</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="text-muted">ملاحظات:</span>
                                        <span class="text-dark ms-1">@(string.IsNullOrEmpty(inv.Notes) ? "لا توجد" : inv.Notes)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center p-5 text-muted">
                <i class="fa-solid fa-receipt fs-1 text-muted opacity-50 mb-3 d-block"></i>
                لا توجد فواتير مسجلة لهذا المورد حالياً.
                <div class="mt-3">
                    <button class="btn btn-success fw-bold" onclick="openAddInvoiceModalForSupplier(@Model.Id)">
                        <i class="fa-solid fa-plus me-1"></i> تسجيل الفاتورة الأولى
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Add Invoice for Supplier -->
<div class="modal fade" id="addInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice-dollar me-1"></i> تسجيل فاتورة توريد جديدة لـ (@Model.Name)</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateInvoice" method="post" id="addInvoiceForm" onsubmit="return validateInvoiceForm('addInvoiceForm')">
                <input type="hidden" name="SupplierId" value="@Model.Id" />
                <input type="hidden" name="returnSupplierId" value="@Model.Id" />
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">رقم الفاتورة</label>
                        <input type="text" name="InvoiceNumber" class="form-control" placeholder="تلقائي إن ترك فارغاً" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">تاريخ الفاتورة <span class="text-danger">*</span></label>
                        <input type="date" name="InvoiceDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required class="form-control" />
                    </div>

                    <!-- Line Items Table -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark mb-0">
                                <i class="fa-solid fa-boxes-stacked text-success me-1"></i> بنود أصناف الفاتورة (قائمة فحص المواد الخام)
                            </label>
                        </div>
                        <div class="table-responsive border rounded" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-bordered mb-0 align-middle" id="invoiceItemsTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;"></th>
                                        <th>اسم الخامة</th>
                                        <th style="width: 140px;">الكمية</th>
                                        <th style="width: 150px;">سعر الوحدة</th>
                                        <th style="width: 150px;">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody id="invoiceItemsTbody">
                                </tbody>
                                <tfoot>
                                    <tr class="table-warning fw-bold">
                                        <td colspan="4" class="text-end">إجمالي قيمة الفاتورة الكلي:</td>
                                        <td id="invoiceTotalDisplay" class="fs-5 text-dark">0.00 ج.م</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Payment Details -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
                        <select name="PaymentMethod" id="invoicePaymentMethod" class="form-select fw-bold" onchange="toggleInvoicePaidInput('add')">
                            <option value="@((int)PaymentMethod.Cash)">كاش (مدفوع بالكامل)</option>
                            <option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي (مدفوع بالكامل)</option>
                            <option value="@((int)PaymentMethod.PartiallyPaid)">مدفوع جزئياً</option>
                            <option value="@((int)PaymentMethod.Unpaid)" selected>غير مدفوع (آجل بالكامل)</option>
                        </select>
                    </div>
                    <div class="col-md-4" id="addInvoicePaidAmountContainer" style="display: none;">
                        <label class="form-label fw-bold">المبلغ المدفوع الآن (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" name="PaidAmount" id="invoicePaidAmount" value="0" class="form-control fw-bold text-success" autocomplete="off" oninput="validateInvoicePartialPayment('add')" />
                        <div id="invoicePaidAmountError" class="text-danger small fw-bold mt-1 d-none">
                            المبلغ المدفوع يجب أن يكون أقل من إجمالي الفاتورة وأكبر من صفر.
                        </div>
                    </div>
                    <div class="col-md-4" id="invoiceRemainingContainer" style="display: none;">
                        <label class="form-label fw-bold">المتبقي (المديونية)</label>
                        <div class="p-2 bg-danger bg-opacity-10 rounded text-center border border-danger">
                            <span id="invoiceRemainingDisplay" class="fs-6 fw-bold text-danger">0.00</span> ج.م
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">ملاحظات عن الفاتورة</label>
                        <input type="text" name="Notes" class="form-control" placeholder="تفاصيل أذونات الاستلام..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success fw-bold">حفظ الفاتورة وتحديث المخزن فوراً</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Pay Invoice Remaining -->
<div class="modal fade" id="payInvoiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-money-bill-wave me-1"></i> سداد مديونية فاتورة</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="PayInvoice" method="post">
                <input type="hidden" name="invoiceId" id="payInvoiceId" />
                <input type="hidden" name="returnSupplierId" value="@Model.Id" />
                <div class="modal-body row g-3">
                    <div class="col-12">
                        <p class="fw-bold mb-1">رقم الفاتورة: <span id="payInvoiceNum" class="text-primary fs-5"></span></p>
                        <p class="fw-bold mb-0">المبلغ المتبقي الحالي: <span id="payRemainingAmount" class="text-danger fs-5"></span> ج.م</p>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">المبلغ المدفوع الآن (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="amountPaidNow" id="payAmountInput" required class="form-control fs-5 fw-bold text-success" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">طريقة السداد <span class="text-danger">*</span></label>
                        <select name="paymentMethod" class="form-select fw-bold">
                            <option value="@((int)PaymentMethod.Cash)">كاش</option>
                            <option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success fw-bold">تأكيد السداد وتسجيل الحركة بالخزينة</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 📜 Modal: Edit Invoice 📜 -->
<div class="modal fade" id="editInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-1"></i> تعديل فاتورة التوريد</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditInvoice" method="post" id="editInvoiceForm" onsubmit="return validateInvoiceForm('editInvoiceForm')">
                <input type="hidden" name="Id" id="editInvoiceId" />
                <input type="hidden" name="SupplierId" value="@Model.Id" />
                <input type="hidden" name="returnSupplierId" value="@Model.Id" />
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">المورد</label>
                        <input type="text" readonly class="form-control bg-light fw-bold" value="@Model.Name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">رقم الفاتورة <span class="text-danger">*</span></label>
                        <input type="text" name="InvoiceNumber" id="editInvoiceNumber" required class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">تاريخ الفاتورة <span class="text-danger">*</span></label>
                        <input type="date" name="InvoiceDate" id="editInvoiceDate" required class="form-control" />
                    </div>

                    <!-- Line Items Table -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark mb-0">
                                <i class="fa-solid fa-boxes-stacked text-primary me-1"></i> بنود الاصناف الموردة بالفاتورة (قائمة فحص المواد الخام)
                            </label>
                        </div>
                        <div class="table-responsive border rounded" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-bordered mb-0 align-middle" id="editInvoiceItemsTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;"></th>
                                        <th>اسم الخامة</th>
                                        <th style="width: 140px;">الكمية</th>
                                        <th style="width: 150px;">سعر الوحدة</th>
                                        <th style="width: 150px;">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody id="editInvoiceItemsTbody">
                                    <!-- Populated statically via JS on modal load -->
                                </tbody>
                                <tfoot>
                                    <tr class="table-warning fw-bold">
                                        <td colspan="4" class="text-end">إجمالي قيمة الفاتورة الكلي:</td>
                                        <td id="editInvoiceTotalDisplay" class="fs-5 text-dark">0.00 ج.م</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Payment Information -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
                        <select name="PaymentMethod" id="editInvoicePaymentMethod" class="form-select fw-bold" onchange="toggleInvoicePaidInput('edit')">
                            <option value="@((int)PaymentMethod.Cash)">كاش (مدفوع بالكامل)</option>
                            <option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي (مدفوع بالكامل)</option>
                            <option value="@((int)PaymentMethod.PartiallyPaid)">مدفوع جزئياً</option>
                            <option value="@((int)PaymentMethod.Unpaid)" selected>غير مدفوع (آجل بالكامل)</option>
                        </select>
                    </div>
                    <div class="col-md-4" id="editInvoicePaidAmountContainer" style="display: none;">
                        <label class="form-label fw-bold">المبلغ المدفوع حالياً (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" name="PaidAmount" id="editInvoicePaidAmount" value="0" class="form-control fw-bold text-success" autocomplete="off" oninput="validateInvoicePartialPayment('edit')" />
                        <div id="editInvoicePaidAmountError" class="text-danger small fw-bold mt-1 d-none">
                            المبلغ المدفوع يجب أن يكون أقل من إجمالي الفاتورة وأكبر من صفر.
                        </div>
                    </div>
                    <div class="col-md-4" id="editInvoiceRemainingContainer" style="display: none;">
                        <label class="form-label fw-bold">المتبقي (المديونية)</label>
                        <div class="p-2 bg-danger bg-opacity-10 rounded text-center border border-danger">
                            <span id="editInvoiceRemainingDisplay" class="fs-6 fw-bold text-danger">0.00</span> ج.م
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">ملاحظات عن الفاتورة</label>
                        <input type="text" name="Notes" id="editInvoiceNotes" class="form-control" placeholder="تفاصيل إضافية..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary fw-bold">حفظ التعديلات وتحديث المخزن والخزينة</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. البيانات الأساسية للمواد الخام
        const rawMaterialsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rawMaterials.Select(m => new { id = m.Id, name = m.MaterialName, unit = m.MeasurementUnit?.Name ?? "", unitPrice = m.UnitPrice })));

        // 2. قيم Enum طرق الدفع
        const pmCash = "@((int)PaymentMethod.Cash)";
        const pmBank = "@((int)PaymentMethod.BankTransfer)";
        const pmPartial = "@((int)PaymentMethod.PartiallyPaid)";
        const pmUnpaid = "@((int)PaymentMethod.Unpaid)";

        // 3. فتح مودال إضافة فاتورة جديدة لهذا المورد
        function openAddInvoiceModalForSupplier(supplierId) {
            const tbody = document.getElementById('invoiceItemsTbody');
            tbody.innerHTML = '';

            rawMaterialsData.forEach(m => {
                const tr = document.createElement('tr');
                tr.className = 'invoice-item-row';
                tr.id = `item_row_${m.id}`;
                tr.innerHTML = `
                    <td class="text-center">
                        <input class="form-check-input mat-checkbox" type="checkbox" id="chk_${m.id}" onchange="toggleRowInputs(${m.id}, 'add')" />
                    </td>
                    <td>
                        <label class="fw-bold text-dark mb-0" for="chk_${m.id}">
                            ${m.name} <small class="text-muted">(${m.unit})</small>
                        </label>
                        <input type="hidden" class="mat-id-input" value="${m.id}" />
                    </td>
                    <td>
                        <input type="number" step="0.001" class="form-control form-control-sm qty-input text-center fw-bold" value="0" disabled oninput="recalculateInvoiceTotal('add')" />
                    </td>
                    <td>
                        <input type="number" step="0.01" class="form-control form-control-sm price-input text-center fw-bold text-success" value="${m.unitPrice}" disabled oninput="recalculateInvoiceTotal('add')" />
                    </td>
                    <td class="fw-bold line-total text-dark text-center fs-7">0.00 ج.م</td>
                `;
                tbody.appendChild(tr);
            });

            recalculateInvoiceTotal('add');
            new bootstrap.Modal(document.getElementById('addInvoiceModal')).show();
        }

        // 4. تفعيل / إيقاف مدخلات الصف عند الضغط على Checkbox
        function toggleRowInputs(matId, mode = 'add') {
            const tbodyId = mode === 'add' ? 'invoiceItemsTbody' : 'editInvoiceItemsTbody';
            const row = document.querySelector(`#${tbodyId} #item_row_${matId}`);
            if (!row) return;

            const checkbox = row.querySelector('.mat-checkbox');
            const qtyInput = row.querySelector('.qty-input');
            const priceInput = row.querySelector('.price-input');

            if (checkbox.checked) {
                qtyInput.disabled = false;
                priceInput.disabled = false;
                if (parseFloat(qtyInput.value) === 0) {
                    qtyInput.value = 1;
                }
            } else {
                qtyInput.disabled = true;
                priceInput.disabled = true;
                qtyInput.value = 0;
            }

            recalculateInvoiceTotal(mode);
        }

        // 5. إعادة حساب إجمالي الفاتورة وقيم البنود
        function recalculateInvoiceTotal(mode = 'add') {
            let total = 0;
            const tbodyId = mode === 'add' ? 'invoiceItemsTbody' : 'editInvoiceItemsTbody';
            const displayId = mode === 'add' ? 'invoiceTotalDisplay' : 'editInvoiceTotalDisplay';

            const rows = document.querySelectorAll(`#${tbodyId} .invoice-item-row`);
            rows.forEach(r => {
                const checkbox = r.querySelector('.mat-checkbox');
                if (checkbox && checkbox.checked) {
                    const qty = parseFloat(r.querySelector('.qty-input')?.value || 0);
                    const price = parseFloat(r.querySelector('.price-input')?.value || 0);
                    const lineTotal = qty * price;
                    total += lineTotal;
                    const lineTotalCell = r.querySelector('.line-total');
                    if (lineTotalCell) {
                        lineTotalCell.innerText = lineTotal.toFixed(2) + ' ج.م';
                    }
                } else {
                    const lineTotalCell = r.querySelector('.line-total');
                    if (lineTotalCell) {
                        lineTotalCell.innerText = '0.00 ج.م';
                    }
                }
            });

            const displayElem = document.getElementById(displayId);
            if (displayElem) {
                displayElem.innerText = total.toFixed(2) + ' ج.م';
            }

            toggleInvoicePaidInput(mode);
        }

        // 6. التحكم في إظهار وحساب حقول طرق الدفع والمتبقي
        function toggleInvoicePaidInput(mode = 'add') {
            const isAdd = mode === 'add';
            const pmSelect = document.getElementById(isAdd ? 'invoicePaymentMethod' : 'editInvoicePaymentMethod');
            if (!pmSelect) return;

            const pm = pmSelect.value;
            const totalDisplay = document.getElementById(isAdd ? 'invoiceTotalDisplay' : 'editInvoiceTotalDisplay');
            const total = parseFloat((totalDisplay?.innerText || '0').replace(/[^\d.-]/g, '')) || 0;

            const paidInp = document.getElementById(isAdd ? 'invoicePaidAmount' : 'editInvoicePaidAmount');
            const paidContainer = document.getElementById(isAdd ? 'addInvoicePaidAmountContainer' : 'editInvoicePaidAmountContainer');
            const remainingContainer = document.getElementById(isAdd ? 'invoiceRemainingContainer' : 'editInvoiceRemainingContainer');

            if (!paidInp) return;

            // كاش أو تحويل بنكي (مدفوع بالكامل)
            if (pm === pmCash || pm === pmBank) {
                if (paidContainer) paidContainer.style.display = "none";
                if (remainingContainer) remainingContainer.style.display = "none";
                paidInp.value = total > 0 ? total.toFixed(2) : '0.00';
                paidInp.required = false;
                clearInvoicePaymentError(mode);
                return;
            }

            // آجل (غير مدفوع)
            if (pm === pmUnpaid) {
                if (paidContainer) paidContainer.style.display = "none";
                if (remainingContainer) remainingContainer.style.display = "none";
                paidInp.value = '0.00';
                paidInp.required = false;
                clearInvoicePaymentError(mode);
                return;
            }

            // دفع جزئي
            if (pm === pmPartial) {
                if (paidContainer) paidContainer.style.display = "block";
                if (remainingContainer) remainingContainer.style.display = "block";
                paidInp.required = true;

                let currentPaid = parseFloat(paidInp.value) || 0;

                // في حالة الإضافة فقط أو عند عدم وجود قيمة سابقة يتم وضع نصف الإجمالي افتراضياً
                if (isAdd && (currentPaid === 0 || currentPaid >= total)) {
                    paidInp.value = total > 0 ? (total / 2).toFixed(2) : "0.00";
                }

                validateInvoicePartialPayment(mode);
            }
        }

        // 7. التحقق من الدفع الجزئي للحقول
        function validateInvoicePartialPayment(mode = 'add') {
            const isAdd = mode === 'add';
            const totalDisplay = document.getElementById(isAdd ? 'invoiceTotalDisplay' : 'editInvoiceTotalDisplay');
            const total = parseFloat((totalDisplay?.innerText || '0').replace(/[^\d.-]/g, '')) || 0;
            const paidInp = document.getElementById(isAdd ? 'invoicePaidAmount' : 'editInvoicePaidAmount');
            const paid = parseFloat(paidInp?.value || 0);

            if (paid <= 0) {
                showInvoicePaymentError("يجب إدخال مبلغ مدفوع أكبر من صفر.", mode);
                return false;
            }

            if (paid >= total && total > 0) {
                showInvoicePaymentError("في الدفع الجزئي، المبلغ المدفوع يجب أن يكون أقل من إجمالي الفاتورة.", mode);
                return false;
            }

            clearInvoicePaymentError(mode);

            const remaining = Math.max(total - paid, 0);
            const remElem = document.getElementById(isAdd ? 'invoiceRemainingDisplay' : 'editInvoiceRemainingDisplay');
            if (remElem) {
                remElem.innerText = remaining.toFixed(2);
            }

            return true;
        }

        // 8. إظهار وإخفاء رسائل أخطاء الدفع وتجميد زر الحفظ
        function showInvoicePaymentError(msg, mode = 'add') {
            const isAdd = mode === 'add';
            const err = document.getElementById(isAdd ? 'invoicePaidAmountError' : 'editInvoicePaidAmountError');
            const formId = isAdd ? 'addInvoiceForm' : 'editInvoiceForm';
            const btn = document.querySelector(`#${formId} button[type="submit"]`);

            if (err) {
                err.innerText = msg;
                err.classList.remove('d-none');
            }
            if (btn) btn.disabled = true;
        }

        function clearInvoicePaymentError(mode = 'add') {
            const isAdd = mode === 'add';
            const err = document.getElementById(isAdd ? 'invoicePaidAmountError' : 'editInvoicePaidAmountError');
            const formId = isAdd ? 'addInvoiceForm' : 'editInvoiceForm';
            const btn = document.querySelector(`#${formId} button[type="submit"]`);

            if (err) err.classList.add('d-none');
            if (btn) btn.disabled = false;
        }

        // 9. فتح مودال تعديل الفاتورة وتعبئة بياناتها
        async function openEditInvoiceModal(id) {
            try {
                const response = await fetch(`/Suppliers/GetInvoiceDetailsJson/${id}`);
                if (!response.ok) {
                    alert('خطأ أثناء تحميل بيانات الفاتورة.');
                    return;
                }
                const data = await response.json();

                document.getElementById('editInvoiceId').value = data.id;
                document.getElementById('editInvoiceNumber').value = data.invoiceNumber;
                document.getElementById('editInvoiceDate').value = data.invoiceDate;
                document.getElementById('editInvoicePaymentMethod').value = data.paymentMethod;
                document.getElementById('editInvoicePaidAmount').value = data.paidAmount;
                document.getElementById('editInvoiceNotes').value = data.notes || '';

                const tbody = document.getElementById('editInvoiceItemsTbody');
                tbody.innerHTML = '';

                // Create a map of raw material ID to invoice item details
                const invoiceItemsMap = {};
                data.items.forEach(item => {
                    invoiceItemsMap[item.rawMaterialId] = item;
                });

                rawMaterialsData.forEach(m => {
                    const invoiceItem = invoiceItemsMap[m.id];
                    const isChecked = invoiceItem !== undefined;

                    const tr = document.createElement('tr');
                    tr.className = 'invoice-item-row';
                    tr.id = `item_row_${m.id}`;
                    tr.innerHTML = `
                        <td class="text-center">
                            <input class="form-check-input mat-checkbox" type="checkbox" id="edit_chk_${m.id}" ${isChecked ? 'checked' : ''} onchange="toggleRowInputs(${m.id}, 'edit')" />
                        </td>
                        <td>
                            <label class="fw-bold text-dark mb-0" for="edit_chk_${m.id}">
                                ${m.name} <small class="text-muted">(${m.unit})</small>
                            </label>
                            <input type="hidden" class="mat-id-input" value="${m.id}" />
                        </td>
                        <td>
                            <input type="number" step="0.001" class="form-control form-control-sm qty-input text-center fw-bold" value="${isChecked ? invoiceItem.quantity : 0}" ${isChecked ? '' : 'disabled'} oninput="recalculateInvoiceTotal('edit')" />
                        </td>
                        <td>
                            <input type="number" step="0.01" class="form-control form-control-sm price-input text-center fw-bold text-success" value="${isChecked ? invoiceItem.unitPrice : m.unitPrice}" ${isChecked ? '' : 'disabled'} oninput="recalculateInvoiceTotal('edit')" />
                        </td>
                        <td class="fw-bold line-total text-dark text-center fs-7">0.00 ج.م</td>
                    `;
                    tbody.appendChild(tr);
                });

                recalculateInvoiceTotal('edit');
                new bootstrap.Modal(document.getElementById('editInvoiceModal')).show();
            } catch (err) {
                console.error(err);
                alert('خطأ في الاتصال بالخادم.');
            }
        }

        // 10. التحقق من صحة الفاتورة قبل الإرسال
        function validateInvoiceForm(formId) {
            const form = document.getElementById(formId);
            if (!form) return false;

            const mode = formId === 'addInvoiceForm' ? 'add' : 'edit';
            const pmSelect = form.querySelector('[name="PaymentMethod"]');
            const pm = pmSelect ? pmSelect.value : '';

            let hasChecked = false;
            const checkboxes = form.querySelectorAll('.mat-checkbox');
            checkboxes.forEach(chk => {
                if (chk.checked) hasChecked = true;
            });

            if (!hasChecked) {
                alert("خطأ: يجب اختيار مادة خام واحدة على الأقل وتوريدها بالفاتورة!");
                return false;
            }

            if (pm === pmPartial) {
                const isValid = validateInvoicePartialPayment(mode);
                if (!isValid) return false;
            }

            prepareInvoiceSubmit(formId);
            return true;
        }

        // 11. تجهيز أسماء مدخلات البنود للإرسال بأسماء مصفوفة C# (Items[i].Prop)
        function prepareInvoiceSubmit(formId) {
            const form = document.getElementById(formId);
            let seqIndex = 0;

            const rows = form.querySelectorAll('.invoice-item-row');
            rows.forEach(row => {
                const checkbox = row.querySelector('.mat-checkbox');
                const matSelect = row.querySelector('.mat-id-input');
                const qtyInput = row.querySelector('.qty-input');
                const priceInput = row.querySelector('.price-input');

                if (checkbox && checkbox.checked) {
                    matSelect.name = `Items[${seqIndex}].RawMaterialId`;
                    qtyInput.name = `Items[${seqIndex}].Quantity`;
                    priceInput.name = `Items[${seqIndex}].UnitPrice`;
                    seqIndex++;
                } else {
                    matSelect.removeAttribute('name');
                    qtyInput.removeAttribute('name');
                    priceInput.removeAttribute('name');
                }
            });
            return true;
        }

        // 12. فتح مودال سداد مديونية فاتورة
        function openPayInvoiceModal(id, num, supplierName, remaining) {
            document.getElementById('payInvoiceId').value = id;
            document.getElementById('payInvoiceNum').innerText = num;
            document.getElementById('payRemainingAmount').innerText = remaining.toFixed(2);
            document.getElementById('payAmountInput').value = remaining;
            document.getElementById('payAmountInput').max = remaining;
            new bootstrap.Modal(document.getElementById('payInvoiceModal')).show();
        }

    
       
    </script>
}