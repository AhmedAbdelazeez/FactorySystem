@model Bakery.Domain.Entities.Supplier
@{
    ViewData["Title"] = $"تفاصيل المورد - {Model.Name}";
    var summary = ViewBag.Summary as Bakery.Business.DTOs.SupplierSummaryDto ?? new Bakery.Business.DTOs.SupplierSummaryDto();
    var rawMaterials = ViewBag.RawMaterials as IEnumerable<Bakery.Domain.Entities.RawMaterial> ?? new List<Bakery.Domain.Entities.RawMaterial>();
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <a asp-action="Index" class="btn btn-outline-secondary mb-2"><i class="fa-solid fa-arrow-right me-1"></i> العودة لقائمة الموردين</a>
        <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-building text-warning me-2"></i> @Model.Name</h2>
        <p class="text-muted mb-0">سجل فواتير التوريد، كشف الحساب والمديونية، وقائمة الأصناف المعتمدة للمورد</p>
    </div>
    <div class="col-auto d-flex gap-2">
        <button class="btn btn-success fw-bold" onclick="openAddInvoiceModalForSupplier(@Model.Id)">
            <i class="fa-solid fa-plus me-1"></i> إضافة فاتورة جديدة لهذا المورد
        </button>
    </div>
</div>

<!-- Supplier Header Profile & Financial Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom h-100 p-4 border-start border-primary border-4">
            <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-id-card text-primary me-2"></i> بيانات المورد</h5>
            <p class="mb-1"><strong>رقم الهاتف:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "غير مسجل" : Model.Phone)</p>
            <p class="mb-1"><strong>تاريخ الإضافة:</strong> @Model.CreatedAt.ToString("yyyy/MM/dd")</p>
            <p class="mb-2"><strong>ملاحظات:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "لا توجد" : Model.Notes)</p>
            <hr class="my-2" />
            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-list-check text-warning me-1"></i> الأصناف التي يوردها (Check List):</h6>
            <div>
                @if (Model.SuppliedMaterials != null && Model.SuppliedMaterials.Any())
                {
                    foreach (var sm in Model.SuppliedMaterials)
                    {
                        <span class="badge bg-light text-dark border me-1 mb-1 fs-6">
                            <i class="fa-solid fa-circle-check text-success me-1"></i>@(sm.RawMaterial?.MaterialName ?? "-")
                        </span>

                    }
                }
                else
                {
                    <span class="text-muted small">لم يتم تحديد قائمة أصناف لهذا المورد بعد.</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card card-custom p-3 bg-light-primary border-0 text-center h-100">
                    <h6 class="text-muted fw-bold mb-1">إجمالي الفواتير الموردة</h6>
                    <h3 class="fw-extrabold text-primary mb-0">@summary.TotalInvoicesValue.ToString("N2") <small class="fs-6">ج.م</small></h3>
                    <span class="small text-muted mt-1">عدد الفواتير: (@Model.Invoices.Count)</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-custom p-3 bg-light-success border-0 text-center h-100">
                    <h6 class="text-muted fw-bold mb-1">إجمالي ما تم سداده</h6>
                    <h3 class="fw-extrabold text-success mb-0">@summary.TotalPaidAmount.ToString("N2") <small class="fs-6">ج.م</small></h3>
                    <span class="small text-muted mt-1">المسدد للخزينة</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-custom p-3 bg-light-danger border-0 text-center h-100">
                    <h6 class="text-muted fw-bold mb-1">المديونية المتبقية</h6>
                    <h3 class="fw-extrabold text-danger mb-0">@summary.TotalRemainingAmount.ToString("N2") <small class="fs-6">ج.م</small></h3>
                    <span class="small text-muted mt-1">مستحق للمورد</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 📜 History log of all Invoices for this Supplier 📜 -->
<div class="card card-custom">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-clock-rotate-left text-warning me-2"></i> سجل الفواتير وحسابات المورد (History)
        </h5>
        <span class="badge bg-secondary">@Model.Invoices.Count() فاتورة</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Invoices != null && Model.Invoices.Any())
        {
            <div class="accordion accordion-flush" id="supplierInvoicesAccordion">
                @foreach (var inv in Model.Invoices)
                {
                    var accordionId = $"inv_collapse_{inv.Id}";
                    <div class="accordion-item border-bottom">
                        <h2 class="accordion-header" id="heading_@inv.Id">
                            <button class="accordion-button collapsed py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@accordionId">
                                <div class="row w-100 align-items-center me-2">
                                    <div class="col-md-3">
                                        <span class="fw-bold text-primary fs-6"><i class="fa-solid fa-file-invoice me-2"></i>#@inv.InvoiceNumber</span>
                                    </div>
                                    <div class="col-md-2 small text-muted">
                                        <i class="fa-solid fa-calendar me-1"></i>@inv.InvoiceDate.ToString("yyyy/MM/dd")
                                    </div>
                                    <div class="col-md-3 fw-bold text-dark">
                                        الإجمالي: @inv.TotalAmount.ToString("N2") ج.م
                                    </div>
                                    <div class="col-md-2">
                                        @if (inv.RemainingAmount == 0)
                                        {
                                            <span class="badge bg-success"><i class="fa-solid fa-check-double me-1"></i>خالصة بالكامل</span>
                                        }
                                        else if (inv.PaidAmount > 0)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i>متبقي: @inv.RemainingAmount.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>غير مدفوعة</span>
                                        }
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <span class="small text-decoration-underline text-primary">عرض تفاصيل الفاتورة <i class="fa-solid fa-chevron-down ms-1"></i></span>
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="@accordionId" class="accordion-collapse collapse" data-bs-parent="#supplierInvoicesAccordion">
                            <div class="accordion-body bg-light p-4">
                                <div class="row mb-3">
                                    <div class="col-md-8">
                                        <h6 class="fw-bold text-dark mb-1">تفاصيل الأصناف والكميات الواردة بالفاتورة:</h6>
                                        <p class="small text-muted mb-0">تم انعكاس الكميات والأسعار فورياً بـ <a asp-controller="Inventory" asp-action="Index">مخزن المواد الخام</a></p>
                                    </div>
                                    <div class="col-md-4 text-md-end">
                                        <button class="btn btn-sm btn-outline-primary fw-bold me-1" onclick="openEditInvoiceModal(@inv.Id)">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> تعديل الفاتورة
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger fw-bold me-1" onclick="confirmDeleteInvoice(@inv.Id, '@inv.InvoiceNumber', @Model.Id)">
                                            <i class="fa-solid fa-trash me-1"></i> حذف الفاتورة
                                        </button>
                                        @if (inv.RemainingAmount > 0)
                                        {
                                            <button class="btn btn-sm btn-success fw-bold" onclick="openPayInvoiceModal(@inv.Id, '@inv.InvoiceNumber', '@Model.Name', @inv.RemainingAmount)">
                                                <i class="fa-solid fa-money-bill-wave me-1"></i> سداد مديونية الفاتورة
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- Items Table -->
                                <div class="table-responsive border rounded bg-white mb-3">
                                    <table class="table table-sm table-striped mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>اسم المادة الخام الموردة</th>
                                                <th>الكمية الموردة</th>
                                                <th>وحدة القياس</th>
                                                <th>سعر الشكارة / الوحدة</th>
                                                <th>إجمالي بند المادة الخام</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (inv.Items != null && inv.Items.Any())
                                            {
                                                foreach (var item in inv.Items)
                                                {
                                                    <tr>
                                                        <td class="fw-bold text-dark">
                                                            <i class="fa-solid fa-box text-warning me-2"></i>@(item.RawMaterial?.MaterialName ?? "-")
                                                        </td>

                                                        <td class="fw-bold fs-6">@item.Quantity.ToString("0.###")</td>
                                                        <td><span class="badge bg-light text-dark border">@(item.RawMaterial?.MeasurementUnit?.Name ?? "-")</span></td>
                                                        <td>@item.UnitPrice.ToString("N2") ج.م</td>
                                                        <td class="fw-bold text-primary">@item.TotalAmount.ToString("N2") ج.م</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted">لا توجد بنود مسجلة هذه الفاتورة.</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="table-warning fw-bold">
                                                <td colspan="4" class="text-end">إجمالي الفاتورة:</td>
                                                <td class="fs-6 text-dark">@inv.TotalAmount.ToString("N2") ج.م</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                <!-- Financial Breakdown of Invoice -->
                                <div class="row g-2 bg-white p-3 rounded border">
                                    <div class="col-md-4">
                                        <span class="text-muted">المبلغ المدفوع:</span>
                                        <span class="fw-bold text-success ms-1">@inv.PaidAmount.ToString("N2") ج.م</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="text-muted">المبلغ المتبقي:</span>
                                        <span class="fw-bold text-danger ms-1">@inv.RemainingAmount.ToString("N2") ج.م</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="text-muted">ملاحظات:</span>
                                        <span class="text-dark ms-1">@(string.IsNullOrEmpty(inv.Notes) ? "لا توجد" : inv.Notes)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center p-5 text-muted">
                <i class="fa-solid fa-receipt fs-1 text-muted opacity-50 mb-3 d-block"></i>
                لا توجد فواتير مسجلة لهذا المورد حالياً.
                <div class="mt-3">
                    <button class="btn btn-success fw-bold" onclick="openAddInvoiceModalForSupplier(@Model.Id)">
                        <i class="fa-solid fa-plus me-1"></i> تسجيل الفاتورة الأولى
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Add Invoice for Supplier -->
<div class="modal fade" id="addInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice-dollar me-1"></i> تسجيل فاتورة توريد جديدة لـ (@Model.Name)</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateInvoice" method="post">
                <input type="hidden" name="SupplierId" value="@Model.Id" />
                <input type="hidden" name="returnSupplierId" value="@Model.Id" />
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">رقم الفاتورة</label>
                        <input type="text" name="InvoiceNumber" class="form-control" placeholder="تلقائي إن ترك فارغاً" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">تاريخ الفاتورة <span class="text-danger">*</span></label>
                        <input type="date" name="InvoiceDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required class="form-control" />
                    </div>

                    <!-- Line Items Table -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark mb-0">
                                <i class="fa-solid fa-boxes-stacked text-success me-1"></i> بنود أصناف الفاتورة
                            </label>
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="addInvoiceItemRow()">
                                <i class="fa-solid fa-plus me-1"></i> إضافة صنف بالفاتورة
                            </button>
                        </div>
                        <div class="table-responsive border rounded">
                            <table class="table table-bordered mb-0 align-middle" id="invoiceItemsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم الخامة</th>
                                        <th style="width: 140px;">الكمية</th>
                                        <th style="width: 150px;">السعر</th>
                                        <th style="width: 150px;">الإجمالي</th>
                                        <th style="width: 50px;"></th>
                                    </tr>

                                </thead>
                                <tbody id="invoiceItemsTbody">
                                </tbody>
                                <tfoot>
                                    <tr class="table-warning fw-bold">
                                        <td colspan="3" class="text-end">إجمالي قيمة الفاتورة الكلي:</td>
                                        <td id="invoiceTotalDisplay" class="fs-5 text-dark">0.00 ج.م</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Payment Details -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
                        <select name="PaymentMethod" id="invoicePaymentMethod" class="form-select fw-bold" onchange="toggleInvoicePaidInput()">
                            <option value="1">كاش (مدفوع بالكامل)</option>
                            <option value="2">تحويل بنكي (مدفوع بالكامل)</option>
                            <option value="3" selected>مدفوع جزئياً</option>
                            <option value="4">غير مدفوع (آجل بالكامل)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">المبلغ المدفوع الآن (ج.م)</label>
                        <input type="number" step="0.01" name="PaidAmount" id="invoicePaidAmount" value="0" class="form-control fw-bold text-success" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">المتبقي (المديونية)</label>
                        <input type="text" id="invoiceRemainingDisplay" readonly class="form-control fw-bold text-danger bg-light" value="0.00 ج.م" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">ملاحظات عن الفاتورة</label>
                        <input type="text" name="Notes" class="form-control" placeholder="تفاصيل أذونات الاستلام..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success fw-bold">حفظ الفاتورة وتحديث المخزن فوراً</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Pay Invoice Remaining -->
<div class="modal fade" id="payInvoiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-money-bill-wave me-1"></i> سداد مديونية فاتورة</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="PayInvoice" method="post">
                <input type="hidden" name="invoiceId" id="payInvoiceId" />
                <input type="hidden" name="returnSupplierId" value="@Model.Id" />
                <div class="modal-body row g-3">
                    <div class="col-12">
                        <p class="fw-bold mb-1">رقم الفاتورة: <span id="payInvoiceNum" class="text-primary fs-5"></span></p>
                        <p class="fw-bold mb-0">المبلغ المتبقي الحالي: <span id="payRemainingAmount" class="text-danger fs-5"></span> ج.م</p>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">المبلغ المدفوع الآن (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="amountPaidNow" id="payAmountInput" required class="form-control fs-5 fw-bold text-success" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">طريقة السداد <span class="text-danger">*</span></label>
                        <select name="paymentMethod" class="form-select fw-bold">
                            <option value="1">كاش</option>
                            <option value="2">تحويل بنكي</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success fw-bold">تأكيد السداد وتسجيل الحركة بالخزينة</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 📜 Modal: Edit Invoice 📜 -->
<div class="modal fade" id="editInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-1"></i> تعديل فاتورة التوريد</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditInvoice" method="post">
                <input type="hidden" name="Id" id="editInvoiceId" />
                <input type="hidden" name="SupplierId" value="@Model.Id" />
                <input type="hidden" name="returnSupplierId" value="@Model.Id" />
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">المورد</label>
                        <input type="text" readonly class="form-control bg-light fw-bold" value="@Model.Name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">رقم الفاتورة <span class="text-danger">*</span></label>
                        <input type="text" name="InvoiceNumber" id="editInvoiceNumber" required class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">تاريخ الفاتورة <span class="text-danger">*</span></label>
                        <input type="date" name="InvoiceDate" id="editInvoiceDate" required class="form-control" />
                    </div>

                    <!-- Line Items Table -->
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark mb-0">
                                <i class="fa-solid fa-boxes-stacked text-primary me-1"></i> بنود الاصناف الموردة بالفاتورة
                            </label>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addEditInvoiceItemRow()">
                                <i class="fa-solid fa-plus me-1"></i> إضافة صنف بالفاتورة
                            </button>
                        </div>
                        <div class="table-responsive border rounded">
                            <table class="table table-bordered mb-0 align-middle" id="editInvoiceItemsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم الخامة</th>
                                        <th style="width: 140px;">الكمية</th>
                                        <th style="width: 150px;">السعر</th>
                                        <th style="width: 150px;">الإجمالي</th>
                                        <th style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="editInvoiceItemsTbody">
                                    <!-- Dynamic rows inserted by JS -->
                                </tbody>
                                <tfoot>
                                    <tr class="table-warning fw-bold">
                                        <td colspan="3" class="text-end">إجمالي قيمة الفاتورة الكلي:</td>
                                        <td id="editInvoiceTotalDisplay" class="fs-5 text-dark">0.00 ج.م</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Payment Information -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
                        <select name="PaymentMethod" id="editInvoicePaymentMethod" class="form-select fw-bold" onchange="toggleEditInvoicePaidInput()">
                            <option value="1">كاش (مدفوع بالكامل)</option>
                            <option value="2">تحويل بنكي (مدفوع بالكامل)</option>
                            <option value="3">مدفوع جزئياً</option>
                            <option value="4">غير مدفوع (آجل بالكامل)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">المبلغ المدفوع (ج.م)</label>
                        <input type="number" step="0.01" name="PaidAmount" id="editInvoicePaidAmount" value="0" class="form-control fw-bold text-success" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">المتبقي (المديونية)</label>
                        <input type="text" id="editInvoiceRemainingDisplay" readonly class="form-control fw-bold text-danger bg-light" value="0.00 ج.م" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">ملاحظات عن الفاتورة</label>
                        <input type="text" name="Notes" id="editInvoiceNotes" class="form-control" placeholder="تفاصيل إضافية..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary fw-bold">حفظ التعديلات وتحديث المخزن والخزينة</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rawMaterialsData = [
            @foreach (var mat in rawMaterials)
            {
                @:{ id: @mat.Id, name: '@mat.MaterialName', unit: '@(mat.MeasurementUnit?.Name ?? "")', unitPrice: @mat.UnitPrice },
            }
        ];


        let itemRowIndex = 0;

        function openAddInvoiceModalForSupplier(supplierId) {
            document.getElementById('invoiceItemsTbody').innerHTML = '';
            itemRowIndex = 0;
            addInvoiceItemRow();
            recalculateInvoiceTotal();
            new bootstrap.Modal(document.getElementById('addInvoiceModal')).show();
        }

        function addInvoiceItemRow() {
            const tbody = document.getElementById('invoiceItemsTbody');
            const rowId = `item_row_${itemRowIndex}`;

            let matOptions = '<option value="">-- اختر الخامة --</option>';
            rawMaterialsData.forEach(m => {
                matOptions += `<option value="${m.id}" data-price="${m.unitPrice}">${m.name} (${m.unit})</option>`;
            });

            const tr = document.createElement('tr');
            tr.id = rowId;
            tr.innerHTML = `
                <td>
                    <select name="Items[${itemRowIndex}].RawMaterialId" class="form-select mat-select" required onchange="onMatSelectChange('${rowId}')">
                        ${matOptions}
                    </select>
                </td>
                <td>
                    <input type="number" step="0.001" name="Items[${itemRowIndex}].Quantity" class="form-control qty-input" value="1" required oninput="recalculateInvoiceTotal()" />
                </td>
                <td>
                    <input type="number" step="0.01" name="Items[${itemRowIndex}].UnitPrice" class="form-control price-input" value="0" required oninput="recalculateInvoiceTotal()" />
                </td>
                <td class="fw-bold line-total text-dark">0.00 ج.م</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeInvoiceItemRow('${rowId}')"><i class="fa-solid fa-xmark"></i></button>
                </td>
            `;
            tbody.appendChild(tr);
            itemRowIndex++;
            recalculateInvoiceTotal();
        }

        function removeInvoiceItemRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
                recalculateInvoiceTotal();
            }
        }

        function onMatSelectChange(rowId) {
            const row = document.getElementById(rowId);
            if (!row) return;
            const select = row.querySelector('.mat-select');
            const selectedOption = select.options[select.selectedIndex];
            const priceInput = row.querySelector('.price-input');

            if (selectedOption && selectedOption.dataset.price) {
                priceInput.value = selectedOption.dataset.price;
            }
            recalculateInvoiceTotal();
        }

        function recalculateInvoiceTotal() {
            let total = 0;
            const rows = document.querySelectorAll('#invoiceItemsTbody tr');
            rows.forEach(r => {
                const qty = parseFloat(r.querySelector('.qty-input')?.value || 0);
                const price = parseFloat(r.querySelector('.price-input')?.value || 0);
                const lineTotal = qty * price;
                total += lineTotal;
                const lineTotalCell = r.querySelector('.line-total');
                if (lineTotalCell) {
                    lineTotalCell.innerText = lineTotal.toFixed(2) + ' ج.م';
                }
            });

            document.getElementById('invoiceTotalDisplay').innerText = total.toFixed(2) + ' ج.م';

            const methodSelect = document.getElementById('invoicePaymentMethod');
            const paidInput = document.getElementById('invoicePaidAmount');

            if (methodSelect.value === "1" || methodSelect.value === "2") {
                paidInput.value = total;
                paidInput.readOnly = true;
            } else if (methodSelect.value === "4") {
                paidInput.value = 0;
                paidInput.readOnly = true;
            } else {
                paidInput.readOnly = false;
            }

            const paidVal = parseFloat(paidInput.value || 0);
            const remaining = Math.max(0, total - paidVal);
            document.getElementById('invoiceRemainingDisplay').value = remaining.toFixed(2) + ' ج.م';
        }

        function toggleInvoicePaidInput() {
            recalculateInvoiceTotal();
        }

        document.getElementById('invoicePaidAmount').addEventListener('input', recalculateInvoiceTotal);

        function openPayInvoiceModal(id, num, supplierName, remaining) {
            document.getElementById('payInvoiceId').value = id;
            document.getElementById('payInvoiceNum').innerText = num;
            document.getElementById('payRemainingAmount').innerText = remaining.toFixed(2);
            document.getElementById('payAmountInput').value = remaining;
            document.getElementById('payAmountInput').max = remaining;
            new bootstrap.Modal(document.getElementById('payInvoiceModal')).show();
        }

        let editItemRowIndex = 0;

        async function openEditInvoiceModal(id) {
            try {
                const response = await fetch(`/Suppliers/GetInvoiceDetailsJson/${id}`);
                if (!response.ok) {
                    alert('خطأ أثناء تحميل بيانات الفاتورة.');
                    return;
                }
                const data = await response.json();

                document.getElementById('editInvoiceId').value = data.id;
                document.getElementById('editInvoiceNumber').value = data.invoiceNumber;
                document.getElementById('editInvoiceDate').value = data.invoiceDate;
                document.getElementById('editInvoicePaymentMethod').value = data.paymentMethod;
                document.getElementById('editInvoicePaidAmount').value = data.paidAmount;
                document.getElementById('editInvoiceNotes').value = data.notes || '';

                const tbody = document.getElementById('editInvoiceItemsTbody');
                tbody.innerHTML = '';
                editItemRowIndex = 0;

                data.items.forEach(item => {
                    addEditInvoiceItemRow(item.rawMaterialId, item.quantity, item.unitPrice);
                });

                if (data.items.length === 0) {
                    addEditInvoiceItemRow();
                }

                recalculateEditInvoiceTotal();
                new bootstrap.Modal(document.getElementById('editInvoiceModal')).show();
            } catch (err) {
                console.error(err);
                alert('خطأ في الاتصال بالخادم.');
            }
        }

        function addEditInvoiceItemRow(selectedMatId = '', quantity = 1, unitPrice = 0) {
            const tbody = document.getElementById('editInvoiceItemsTbody');
            const rowId = `edit_item_row_${editItemRowIndex}`;
            
            let matOptions = '<option value="">-- اختر الخامة --</option>';
            rawMaterialsData.forEach(m => {
                const selected = m.id == selectedMatId ? 'selected' : '';
                matOptions += `<option value="${m.id}" data-price="${m.unitPrice}" ${selected}>${m.name} (${m.unit})</option>`;
            });

            const tr = document.createElement('tr');
            tr.id = rowId;
            tr.innerHTML = `
                <td>
                    <select name="Items[${editItemRowIndex}].RawMaterialId" class="form-select edit-mat-select" required onchange="onEditMatSelectChange('${rowId}')">
                        ${matOptions}
                    </select>
                </td>
                <td>
                    <input type="number" step="0.001" name="Items[${editItemRowIndex}].Quantity" class="form-control edit-qty-input" value="${quantity}" required oninput="recalculateEditInvoiceTotal()" />
                </td>
                <td>
                    <input type="number" step="0.01" name="Items[${editItemRowIndex}].UnitPrice" class="form-control edit-price-input" value="${unitPrice}" required oninput="recalculateEditInvoiceTotal()" />
                </td>
                <td class="fw-bold edit-line-total text-dark">0.00 ج.م</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeEditInvoiceItemRow('${rowId}')"><i class="fa-solid fa-xmark"></i></button>
                </td>
            `;
            tbody.appendChild(tr);
            editItemRowIndex++;
            recalculateEditInvoiceTotal();
        }

        function removeEditInvoiceItemRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
                recalculateEditInvoiceTotal();
            }
        }

        function onEditMatSelectChange(rowId) {
            const row = document.getElementById(rowId);
            if (!row) return;
            const select = row.querySelector('.edit-mat-select');
            const selectedOption = select.options[select.selectedIndex];
            const priceInput = row.querySelector('.edit-price-input');
            
            if (selectedOption && selectedOption.dataset.price) {
                priceInput.value = selectedOption.dataset.price;
            }
            recalculateEditInvoiceTotal();
        }

        function recalculateEditInvoiceTotal() {
            let total = 0;
            const rows = document.querySelectorAll('#editInvoiceItemsTbody tr');
            rows.forEach(r => {
                const qty = parseFloat(r.querySelector('.edit-qty-input')?.value || 0);
                const price = parseFloat(r.querySelector('.edit-price-input')?.value || 0);
                const lineTotal = qty * price;
                total += lineTotal;
                const lineTotalCell = r.querySelector('.edit-line-total');
                if (lineTotalCell) {
                    lineTotalCell.innerText = lineTotal.toFixed(2) + ' ج.م';
                }
            });

            document.getElementById('editInvoiceTotalDisplay').innerText = total.toFixed(2) + ' ج.م';

            const methodSelect = document.getElementById('editInvoicePaymentMethod');
            const paidInput = document.getElementById('editInvoicePaidAmount');

            if (methodSelect.value === "1" || methodSelect.value === "2") {
                paidInput.value = total;
                paidInput.readOnly = true;
            } else if (methodSelect.value === "4") {
                paidInput.value = 0;
                paidInput.readOnly = true;
            } else {
                paidInput.readOnly = false;
            }

            const paidVal = parseFloat(paidInput.value || 0);
            const remaining = Math.max(0, total - paidVal);
            document.getElementById('editInvoiceRemainingDisplay').value = remaining.toFixed(2) + ' ج.م';
        }

        function toggleEditInvoicePaidInput() {
            recalculateEditInvoiceTotal();
        }

        document.getElementById('editInvoicePaidAmount').addEventListener('input', recalculateEditInvoiceTotal);

        function confirmDeleteInvoice(id, invoiceNumber, supplierId) {
            if (confirm(`هل أنت متأكد من حذف الفاتورة رقم #${invoiceNumber}؟\nسيتم عكس جميع الكميات المضافة للمخازن، وحذف المصروفات وحركات الخزينة التابعة لها بالكامل.`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Suppliers/DeleteInvoice';
                
                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = id;
                form.appendChild(idInput);

                const returnSupplierIdInput = document.createElement('input');
                returnSupplierIdInput.type = 'hidden';
                returnSupplierIdInput.name = 'returnSupplierId';
                returnSupplierIdInput.value = supplierId;
                form.appendChild(returnSupplierIdInput);

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
