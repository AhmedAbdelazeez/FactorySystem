@model IEnumerable<Bakery.Domain.Entities.Expense>
@{
	ViewData["Title"] = "إدارة المصروفات";
	var categories = ViewBag.Categories as IEnumerable<Bakery.Domain.Entities.ExpenseCategory> ?? new List<Bakery.Domain.Entities.ExpenseCategory>();
	var rawMaterials = ViewBag.RawMaterials as IEnumerable<Bakery.Domain.Entities.RawMaterial> ?? new List<Bakery.Domain.Entities.RawMaterial>();

	decimal totalAll = Model.Sum(e => e.TotalAmount);
	decimal paidAll = Model.Sum(e => e.PaidAmount);
	decimal remainingAll = Model.Sum(e => e.RemainingAmount);

	// نجيب Id بتاع فئة "مواد خام" عشان نستخدمه في الـ JS
	var rawMaterialCategoryId = categories.FirstOrDefault(c => c.Name == "مواد خام")?.Id;
}

<div class="page-header-box mb-4 p-3 bg-white rounded-4 border shadow-sm">
	<div class="row align-items-center gy-3">
		<!-- العنوان والأيقونة على اليمين -->
		<div class="col-md d-flex align-items-center gap-3">
			<!-- مربع الأيقونة الأصفر -->
			<div class="rounded-3 d-flex align-items-center justify-content-center"
				 style="width: 52px; height: 52px; background-color: #fff3cd; color: #ffc107; flex-shrink: 0;">
				<i class="fa-solid fa-receipt fs-3"></i>
			</div>

			<!-- النصوص -->
			<div>
				<h3 class="fw-bold text-dark mb-1 fs-4">المصروفات اليومية والشهرية</h3>
				<p class="text-muted mb-0 small">
					تسجيل ومتابعة مصروفات المواد الخام والمصاريف التشغيلية
				</p>
			</div>
		</div>

		<!-- زر إضافة مصروف جديد أقصى الشمال -->
		<div class="col-md-auto ms-auto">
			<button class="btn btn-bakery rounded-3 shadow-sm px-3 py-2 fw-bold d-flex align-items-center gap-2"
					data-bs-toggle="modal"
					data-bs-target="#addExpenseModal">
				<i class="fa-solid fa-plus"></i>
				<span>إضافة مصروف جديد</span>
			</button>
		</div>
	</div>
</div>

<!-- Summary Bar -->
<div class="row g-3 mb-4">
	<div class="col-md-4">
		<div class="card card-custom p-3 text-center border-start border-primary border-4">
			<div class="text-muted small fw-bold">إجمالي المصروفات المعروضة</div>
			<div class="fs-4 fw-extrabold text-primary">@totalAll.ToString("N2") ج.م</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card card-custom p-3 text-center border-start border-success border-4">
			<div class="text-muted small fw-bold">إجمالي المدفوع بالفعل</div>
			<div class="fs-4 fw-extrabold text-success">@paidAll.ToString("N2") ج.م</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card card-custom p-3 text-center border-start border-danger border-4">
			<div class="text-muted small fw-bold">إجمالي المتبقي (غير مدفوع)</div>
			<div class="fs-4 fw-extrabold text-danger">@remainingAll.ToString("N2") ج.م</div>
		</div>
	</div>
</div>

<!-- Filter Bar -->
<div class="card card-custom p-3 mb-4">
	<form method="get" class="row g-3 align-items-end">
		<div class="col-md-3">
			<label class="form-label fw-bold small">من تاريخ</label>
			<input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
		</div>
		<div class="col-md-3">
			<label class="form-label fw-bold small">إلى تاريخ</label>
			<input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
		</div>
		<div class="col-md-3">
			<label class="form-label fw-bold small">تصنيف المصروف</label>
			<select name="categoryId" class="form-select">
				<option value="">جميع التصنيفات</option>
				@foreach (var cat in categories)
				{
					<option value="@cat.Id" selected="@(ViewBag.SelectedCategoryId == cat.Id)">@cat.Name</option>
				}
			</select>
		</div>
		<div class="col-md-3 d-flex gap-2">
			<button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i> تصفية</button>
			<a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate"></i></a>
		</div>
	</form>
</div>

<!-- Expenses Table -->
<div class="card card-custom">
	<div class="card-body p-0">
		<div class="table-custom">
			<table class="table table-bakery mb-0">
				<thead>
					<tr>
						<th>التاريخ</th>
						<th>اسم المصروف</th>
						<th>التصنيف</th>
						<th>الكمية</th>
						<th>سعر الوحدة</th>
						<th>الإجمالي</th>
						<th>طريقة الدفع</th>
						<th>المدفوع</th>
						<th>المتبقي</th>
						<th>ملاحظات</th>
						<th class="text-center">الإجراءات</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Any())
					{
						foreach (var item in Model)
						{
							<tr>
								<td class="fw-bold text-muted">@item.Date.ToString("yyyy/MM/dd")</td>
								<td class="fw-bold">@item.Name</td>
								<td><span class="badge bg-light text-dark border">@(item.ExpenseCategory?.Name ?? "-")</span></td>
								<td>@item.Quantity</td>
								<td>@item.UnitPrice.ToString("N2")</td>
								<td class="fw-bold text-primary">@item.TotalAmount.ToString("N2")</td>
								<td>
									@switch (item.PaymentMethod)
									{
										case PaymentMethod.Cash:
											<span class="badge bg-success">كاش</span>
											break;
										case PaymentMethod.BankTransfer:
											<span class="badge bg-info text-dark">تحويل بنكي</span>
											break;
										case PaymentMethod.PartiallyPaid:
											<span class="badge bg-warning text-dark">مدفوع جزئياً</span>
											break;
										case PaymentMethod.Unpaid:
											<span class="badge bg-danger">غير مدفوع</span>
											break;
									}
								</td>
								<td class="text-success fw-bold">@item.PaidAmount.ToString("N2")</td>
								<td class="@(item.RemainingAmount > 0 ? "text-danger fw-bold" : "text-muted")">@item.RemainingAmount.ToString("N2")</td>
								<td>
									<small class="d-block text-secondary">@item.Notes</small>
								</td>
								<td class="text-center">
									@if (item.RemainingAmount > 0)
									{
										<button class="btn btn-sm btn-outline-success" onclick="openPayModal(@item.Id, '@item.Name', @item.RemainingAmount)">
											<i class="fa-solid fa-hand-holding-dollar"></i> سداد
										</button>
									}
									<button type="button" class="btn btn-sm btn-outline-danger"
											onclick="confirmDelete(@item.Id, '@Url.Action("Delete", "Expenses")', 'هل أنت متأكد من حذف المصروف &quot;@item.Name&quot;؟')">
										<i class="fa-solid fa-trash"></i>
									</button>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="11" class="text-center p-4 text-muted">لا توجد مصروفات مسجلة للفترة المحددة.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- Modal Add Expense -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-amber text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-plus me-1"></i> إضافة مصروف جديد</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="Create" method="post" id="addExpenseForm">
				<div class="modal-body row g-3">
					<div class="col-md-6">
						<label class="form-label fw-bold">اسم المصروف <span class="text-danger">*</span></label>
						<input type="text" name="Name" required class="form-control" placeholder="مثال: فاتورة كهرباء / شراء دقيق" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">تصنيف المصروف <span class="text-danger">*</span></label>
						<select name="ExpenseCategoryId" required class="form-select" id="expCategorySelect" onchange="toggleExpenseFields()">
							<option value="">-- اختر التصنيف --</option>
							@foreach (var cat in categories.Where(c => c.Name != "عمالة"))
							{
								<option value="@cat.Id">@cat.Name</option>
							}
						</select>
					</div>

					<!-- ====== حقول تظهر بس لو التصنيف = مواد خام ====== -->
					<div id="rawMaterialFields" class="col-12 row g-3 d-none">
						<div class="col-md-4">
							<label class="form-label fw-bold">الكمية</label>
							<input type="number" step="0.001" name="Quantity" id="expQty" value="1" class="form-control" oninput="calcExpTotal()" autocomplete="off" />
						</div>
						<div class="col-md-4">
							<label class="form-label fw-bold">سعر الوحدة</label>
							<input type="number" step="0.01" name="UnitPrice" id="expPrice" value="0" class="form-control" oninput="calcExpTotal()" autocomplete="off" />
						</div>
						<div class="col-md-4">
							<label class="form-label fw-bold">المبلغ الإجمالي</label>
							<input type="number" step="0.01" name="TotalAmount" id="expTotalFromQty" readonly class="form-control bg-light fw-bold text-primary" />
						</div>
						<div class="col-12">
							<label class="form-label fw-bold">ربط بمادة خام لزيادة المخزن <span class="text-danger">*</span></label>
							<select name="linkedRawMaterialId" id="linkedMaterialSelect" class="form-select">
								<option value="">-- اختر المادة الخام --</option>
								@foreach (var mat in rawMaterials)
								{
									<option value="@mat.Id">@mat.MaterialType?.Name (@mat.MeasurementUnit?.Name)</option>
								}
							</select>
						</div>
					</div>

					<!-- ====== حقول تظهر بس لو التصنيف مصروف تشغيلي عادي ====== -->
					<div id="operatingFields" class="col-12 row g-3 d-none">
						<div class="col-md-6">
							<label class="form-label fw-bold">المبلغ الإجمالي <span class="text-danger">*</span></label>
							<input type="number" step="0.01" name="TotalAmountOperating" id="expTotalDirect" min="0.01" required class="form-control fw-bold" oninput="syncOperatingTotal()" autocomplete="off" />
						</div>
					</div>

					<!-- ====== حقول مشتركة تظهر دايمًا بعد اختيار أي تصنيف ====== -->
					<div id="commonFields" class="col-12 row g-3 d-none">
						<div class="col-md-6">
							<label class="form-label fw-bold">طريقة الدفع</label>
							<select name="PaymentMethod" id="expPaymentMethod" class="form-select" onchange="togglePaidAmount()">
								<option value="1">كاش (مدفوع بالكامل)</option>
								<option value="2">تحويل بنكي (مدفوع بالكامل)</option>
								<option value="3">مدفوع جزئياً</option>
								<option value="4">غير مدفوع (آجل)</option>
							</select>
						</div>
						<div class="col-md-6">
							<label class="form-label fw-bold">المبلغ المدفوع</label>
							<input type="number" step="0.01" name="PaidAmount" id="expPaidAmount" value="0" class="form-control" autocomplete="off" />
						</div>
						<div class="col-md-6">
							<label class="form-label fw-bold">تاريخ المصروف</label>
							<input type="date" name="Date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
						</div>
						<div class="col-md-6">
							<label class="form-label fw-bold">ملاحظات</label>
							<input type="text" name="Notes" class="form-control" placeholder="ملاحظات تفصيلية..." />
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-bakery">حفظ المصروف</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modal Pay Remaining -->
<div class="modal fade" id="payModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-1"></i> سداد متبقي مصروف</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="PayRemaining" method="post">
				<input type="hidden" name="expenseId" id="payExpenseId" />
				<div class="modal-body g-3">
					<p class="fw-bold mb-2">اسم المصروف: <span id="payExpenseName" class="text-primary"></span></p>
					<div class="mb-3">
						<label class="form-label fw-bold">المبلغ المتبقي المستحق</label>
						<input type="text" id="payRemainingDisp" readonly class="form-control bg-light fw-bold text-danger" />
					</div>
					<div class="mb-3">
						<label class="form-label fw-bold">المبلغ المدفوع الآن <span class="text-danger">*</span></label>
						<input type="number" step="0.01" name="amountPaidNow" id="payNowVal" required class="form-control fw-bold" />
					</div>
					<div class="mb-3">
						<label class="form-label fw-bold">طريقة السداد</label>
						<select name="paymentMethod" class="form-select">
							<option value="1">كاش</option>
							<option value="2">تحويل بنكي</option>
						</select>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-success fw-bold">تأكيد السداد</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		const RAW_MATERIAL_CATEGORY_ID = "@rawMaterialCategoryId";

		function toggleExpenseFields() {
			const catSelect = document.getElementById('expCategorySelect');
			const selectedId = catSelect.value;

			const rawFields = document.getElementById('rawMaterialFields');
			const opFields = document.getElementById('operatingFields');
			const commonFields = document.getElementById('commonFields');

			const rawInputs = rawFields.querySelectorAll('input, select');
			const opInputs = opFields.querySelectorAll('input, select');

			if (!selectedId) {
				rawFields.classList.add('d-none');
				opFields.classList.add('d-none');
				commonFields.classList.add('d-none');
				rawInputs.forEach(el => el.disabled = true);
				opInputs.forEach(el => el.disabled = true);
				return;
			}

			commonFields.classList.remove('d-none');

			if (selectedId === RAW_MATERIAL_CATEGORY_ID) {
				// مواد خام
				rawFields.classList.remove('d-none');
				opFields.classList.add('d-none');

				rawInputs.forEach(el => el.disabled = false);
				opInputs.forEach(el => el.disabled = true);

				document.getElementById('linkedMaterialSelect').required = true;
				calcExpTotal();
			} else {
				// مصروف تشغيلي عادي
				opFields.classList.remove('d-none');
				rawFields.classList.add('d-none');

				opInputs.forEach(el => el.disabled = false);
				rawInputs.forEach(el => el.disabled = true);

				document.getElementById('linkedMaterialSelect').required = false;
				syncOperatingTotal();
			}
		}

		function calcExpTotal() {
			const qty = parseFloat(document.getElementById('expQty').value) || 0;
			const price = parseFloat(document.getElementById('expPrice').value) || 0;
			const total = qty * price;
			document.getElementById('expTotalFromQty').value = total.toFixed(2);
			togglePaidAmount();
		}

		function syncOperatingTotal() {
			togglePaidAmount();
		}

		function getCurrentTotal() {
			const rawFieldsVisible = !document.getElementById('rawMaterialFields').classList.contains('d-none');
			if (rawFieldsVisible) {
				return parseFloat(document.getElementById('expTotalFromQty').value) || 0;
			} else {
				return parseFloat(document.getElementById('expTotalDirect').value) || 0;
			}
		}

		function togglePaidAmount() {
			const pm = document.getElementById('expPaymentMethod').value;
			const total = getCurrentTotal();
			const paidInp = document.getElementById('expPaidAmount');

			if (pm === '1' || pm === '2') {
				paidInp.value = total.toFixed(2);
				paidInp.readOnly = true;
			} else if (pm === '4') {
				paidInp.value = '0.00';
				paidInp.readOnly = true;
			} else {
				paidInp.readOnly = false;
			}
		}

		function openPayModal(id, name, remaining) {
			document.getElementById('payExpenseId').value = id;
			document.getElementById('payExpenseName').innerText = name;
			document.getElementById('payRemainingDisp').value = remaining.toFixed(2) + " ج.م";
			document.getElementById('payNowVal').value = remaining.toFixed(2);
			document.getElementById('payNowVal').max = remaining;
			new bootstrap.Modal(document.getElementById('payModal')).show();
		}
	</script>
}