@model IEnumerable<Bakery.Domain.Entities.Expense>
@using Bakery.Domain.Enums

@{
	ViewData["Title"] = "إدارة المصروفات";

	// 1. تحديد الرواتب والسُلف
	var salaryExpenses = Model.Where(e => e.ExpenseCategory != null &&
										 (e.ExpenseCategory.Name.Contains("عمالة") ||
										  e.ExpenseCategory.Name.Contains("أجور") ||
										  e.ExpenseCategory.Name.Contains("رواتب")));

	// 2. تحديد توريدات المواد الخام
	var rawMaterialExpenses = Model.Where(e => e.ExpenseCategory != null &&
											  e.ExpenseCategory.Name.Contains("مواد خام"));

	// 3. المصاريف التشغيلية: استبعاد المواد الخام والرواتب بالكامل
	var operationalExpenses = Model.Where(e => !salaryExpenses.Contains(e) && !rawMaterialExpenses.Contains(e));

	
	decimal totalAll = Model.Sum(e => e.TotalAmount);
	decimal paidAll = Model.Sum(e => e.PaidAmount);
	decimal remainingAll = Model.Sum(e => e.RemainingAmount);
}

<!-- Header Box -->
<div class="page-header-box mb-4 p-3 bg-white rounded-4 border shadow-sm">
	<div class="row align-items-center gy-3">
		<div class="col-md d-flex align-items-center gap-3">
			<div class="rounded-3 d-flex align-items-center justify-content-center"
				 style="width: 52px; height: 52px; background-color: #fff3cd; color: #ffc107; flex-shrink: 0;">
				<i class="fa-solid fa-receipt fs-3"></i>
			</div>
			<div>
				<h3 class="fw-bold text-dark mb-1 fs-4">المصروفات اليومية والشهرية</h3>
				<p class="text-muted mb-0 small">
					تسجيل ومتابعة مصروفات المواد الخام والمصاريف التشغيلية ورعاية الرواتب
				</p>
			</div>
		</div>

		<div class="col-md-auto ms-auto">
			<button class="btn btn-bakery rounded-3 shadow-sm px-3 py-2 fw-bold d-flex align-items-center gap-2"
					data-bs-toggle="modal"
					data-bs-target="#addExpenseModal">
				<i class="fa-solid fa-plus"></i>
				<span>إضافة مصروف جديد</span>
			</button>
		</div>
	</div>
</div>

<!-- Summary Bar -->
<div class="row g-3 mb-4">
	<div class="col-md-4">
		<div class="card card-custom p-3">
			<div class="d-flex align-items-center">
				<div class="stat-icon-wrapper bg-primary-subtle text-primary me-3">
					<i class="fa-solid fa-receipt"></i>
				</div>
				<div>
					<span class="text-muted small d-block mb-1">إجمالي المصروفات المعروضة</span>
					<span class="fs-4 fw-bold text-dark">@totalAll.ToString("N2") <small class="fs-6 text-muted fw-normal">ج.م</small></span>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card card-custom p-3">
			<div class="d-flex align-items-center">
				<div class="stat-icon-wrapper bg-success-subtle text-success me-3">
					<i class="fa-solid fa-circle-check"></i>
				</div>
				<div>
					<span class="text-muted small d-block mb-1">إجمالي المدفوع بالفعل</span>
					<span class="fs-4 fw-bold text-success">@paidAll.ToString("N2") <small class="fs-6 text-muted fw-normal">ج.م</small></span>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card card-custom p-3">
			<div class="d-flex align-items-center">
				<div class="stat-icon-wrapper bg-danger-subtle text-danger me-3">
					<i class="fa-solid fa-clock"></i>
				</div>
				<div>
					<span class="text-muted small d-block mb-1">إجمالي المتبقي (غير مدفوع)</span>
					<span class="fs-4 fw-bold text-danger">@remainingAll.ToString("N2") <small class="fs-6 text-muted fw-normal">ج.م</small></span>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Filter Bar  -->
<div class="card card-custom p-3 mb-4">
	<form method="get" class="row g-3 align-items-end">
		<div class="col-md-5">
			<label class="form-label fw-bold small">من تاريخ</label>
			<input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
		</div>
		<div class="col-md-5">
			<label class="form-label fw-bold small">إلى تاريخ</label>
			<input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
		</div>
		<div class="col-md-2 d-flex gap-2">
			<button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i> تصفية</button>
			<a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate"></i></a>
		</div>
	</form>
</div>

<!-- Tabs Bar -->
<ul class="nav nav-tabs nav-tabs-custom mb-3" id="expensesTab" role="tablist">
	<li class="nav-item">
		<button class="nav-link active fw-bold" id="operational-tab" data-bs-toggle="tab" data-bs-target="#operational" type="button">
			<i class="fa-solid fa-file-invoice-dollar me-1"></i> المصاريف التشغيلية (@operationalExpenses.Count())
		</button>
	</li>
	<li class="nav-item">
		<button class="nav-link fw-bold" id="materials-tab" data-bs-toggle="tab" data-bs-target="#materials" type="button">
			<i class="fa-solid fa-wheat-awn me-1"></i> مصروفات المواد الخام (@rawMaterialExpenses.Count())
		</button>
	</li>
	<li class="nav-item">
		<button class="nav-link fw-bold" id="salaries-tab" data-bs-toggle="tab" data-bs-target="#salaries" type="button">
			<i class="fa-solid fa-users me-1"></i> رواتب العمال والسلف (@salaryExpenses.Count())
		</button>
	</li>
</ul>

<div class="tab-content" id="expensesTabContent">

	<!-- Tab 1: المصاريف التشغيلية -->
	<div class="tab-pane fade show active" id="operational">
		<div class="card card-custom p-0">
			<div class="table-responsive">
				<table class="table table-bakery mb-0">
					<thead>
						<tr>
							<th>التاريخ</th>
							<th>اسم المصروف</th>
							<th>التصنيف</th>
							<th>الإجمالي</th>
							<th>طريقة الدفع</th>
							<th>المدفوع</th>
							<th>المتبقي</th>
							<th>ملاحظات</th>
							<th class="text-center">الإجراءات</th>
						</tr>
					</thead>
					<tbody>
						@if (operationalExpenses.Any())
						{
							foreach (var item in operationalExpenses)
							{
								<tr>
									<td class="fw-bold text-muted">@item.Date.ToString("yyyy/MM/dd")</td>
									<td class="fw-bold">@item.Name</td>
									<td><span class="badge bg-light text-dark border">@(item.ExpenseCategory?.Name ?? "-")</span></td>
									<td class="fw-bold text-primary">@item.TotalAmount.ToString("N2")</td>
									<td>
										@switch (item.PaymentMethod)
										{
											case PaymentMethod.Cash:
												<span class="badge bg-success-subtle text-success border border-success-subtle">كاش</span>
												break;
											case PaymentMethod.BankTransfer:
												<span class="badge bg-primary-subtle text-primary border border-primary-subtle">تحويل بنكي</span>
												break;
											case PaymentMethod.PartiallyPaid:
												<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">مدفوع جزئياً</span>
												break;
											case PaymentMethod.Unpaid:
												<span class="badge bg-danger-subtle text-danger border border-danger-subtle">آجل</span>
												break;
										}
									</td>
									<td class="text-success fw-bold">@item.PaidAmount.ToString("N2")</td>
									<td class="@(item.RemainingAmount > 0 ? "text-danger fw-bold" : "text-muted")">@item.RemainingAmount.ToString("N2")</td>
									<td><small class="text-secondary">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</small></td>
									<td class="text-center">
										@if (item.RemainingAmount > 0)
										{
											<button class="btn btn-sm btn-outline-success me-1" onclick="openPayModal(@item.Id, '@item.Name', @item.RemainingAmount)">
												<i class="fa-solid fa-hand-holding-dollar"></i> سداد
											</button>
										}
										<button type="button" class="btn btn-sm btn-outline-danger"
												onclick="confirmDelete('@item.Id', '@Url.Action("Delete", "Expenses")', 'هل أنت متأكد من حذف المصروف &quot;@item.Name&quot;؟')">
											<i class="fa-solid fa-trash"></i>
										</button>
										<button type="button" class="btn btn-sm btn-outline-primary me-1"
												onclick="openEditModal(@item.Id, '@item.Name', @item.TotalAmount, @((int)item.PaymentMethod), @item.PaidAmount, '@item.Date.ToString("yyyy-MM-dd")', '@item.Notes', @item.ExpenseCategoryId)"
												title="تعديل المصروف">
											<i class="fa-solid fa-pen"></i>
										</button>
									</td>
								</tr>
							}
						}
						else
						{
							<tr><td colspan="9" class="text-center p-4 text-muted">لا توجد مصاريف تشغيلية مسجلة.</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- Tab 2: توريدات المواد الخام -->
	<div class="tab-pane fade" id="materials">
		<div class="card card-custom p-0">
			<div class="table-responsive">
				<table class="table table-bakery mb-0">
					<thead>
						<tr>
							<th>التاريخ</th>
							<th>اسم المصروف / المادة</th>
							<th>الكمية</th>
							<th>سعر الوحدة</th>
							<th>طريقة الدفع</th>
							<th>الإجمالي</th>
							<th>المدفوع</th>
							<th>المتبقي</th>
							<th class="text-center">ملاحظات</th>
							<th class="text-center">الإجراءات</th>
						</tr>
					</thead>
					<tbody>
						@if (rawMaterialExpenses.Any())
						{
							foreach (var item in rawMaterialExpenses)
							{
								<tr>
									<td class="fw-bold text-muted">@item.Date.ToString("yyyy/MM/dd")</td>
									<td class="fw-bold">@item.Name</td>
									<td>@item.Quantity</td>
									<td>@item.UnitPrice.ToString("N2")</td>
									<td>
										@switch (item.PaymentMethod)
										{
											case PaymentMethod.Cash:
												<span class="badge bg-success-subtle text-success border border-success-subtle">كاش</span>
												break;
											case PaymentMethod.BankTransfer:
												<span class="badge bg-primary-subtle text-primary border border-primary-subtle">تحويل بنكي</span>
												break;
											case PaymentMethod.PartiallyPaid:
												<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">مدفوع جزئياً</span>
												break;
											case PaymentMethod.Unpaid:
												<span class="badge bg-danger-subtle text-danger border border-danger-subtle">آجل</span>
												break;
										}
									</td>
									<td class="fw-bold text-primary">@item.TotalAmount.ToString("N2")</td>
									<td class="text-success fw-bold">@item.PaidAmount.ToString("N2")</td>
									<td class="@(item.RemainingAmount > 0 ? "text-danger fw-bold" : "text-muted")">@item.RemainingAmount.ToString("N2")</td>
									<td class="text-center small text-muted">
										تتم إدارتها وتعديلها من سجل حركة المخزن
									</td>
									<td class="text-center">
										<span class="badge bg-light text-muted border px-2 py-1" title="مرتبطة بفاتورة مورد. الإجراءات تتم من صفحة الموردين.">
											<i class="fa-solid fa-lock me-1"></i> فاتورة مورد
										</span>
									</td>
								</tr>
							}
						}
						else
						{
							<tr><td colspan="10" class="text-center p-4 text-muted">لا توجد توريدات مواد خام مسجلة.</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- Tab 3: رواتب العمال -->
	<div class="tab-pane fade" id="salaries">
		<div class="card card-custom p-0">
			<div class="table-responsive">
				<table class="table table-bakery mb-0">
					<thead>
						<tr>
							<th>تاريخ الصرف</th>
							<th>البيان / اسم العامل</th>
							<th>المبلغ الصافي</th>
							<th>طريقة الدفع</th>
							<th>ملاحظات وتفاصيل الحساب</th>
							<th class="text-center">الإجراءات</th>
						</tr>
					</thead>
					<tbody>
						@if (salaryExpenses.Any())
						{
							foreach (var item in salaryExpenses)
							{
								<tr>
									<td class="fw-bold text-muted">@item.Date.ToString("yyyy/MM/dd HH:mm")</td>
									<td class="fw-bold text-dark">@item.Name</td>
									<td class="fw-bold text-success">@item.TotalAmount.ToString("N2") ج.م</td>
									<td>
										@switch (item.PaymentMethod)
										{
											case PaymentMethod.Cash:
												<span class="badge bg-success-subtle text-success border border-success-subtle">كاش</span>
												break;
											case PaymentMethod.BankTransfer:
												<span class="badge bg-primary-subtle text-primary border border-primary-subtle">تحويل بنكي</span>
												break;
											default:
												<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">أخرى</span>
												break;
										}
									</td>
									<td><small class="text-secondary">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</small></td>
									<td class="text-center">
										<button type="button" class="btn btn-sm btn-outline-danger"
												onclick="confirmDelete('@item.Id', '@Url.Action("Delete", "Expenses")', 'هل أنت متأكد من حذف حركة الراتب &quot;@item.Name&quot;؟')">
											<i class="fa-solid fa-trash"></i>
										</button>
									</td>
								</tr>
							}
						}
						else
						{
							<tr><td colspan="6" class="text-center p-4 text-muted">لا توجد رواتب مصروفة مسجلة.</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

</div>


<!-- Modal Add Expense -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-amber text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-plus me-1"></i> إضافة مصروف جديد</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="Create" method="post" id="addExpenseForm">
				<input type="hidden" name="ExpenseCategoryId" value="@ViewBag.OperationalCategoryId" />

				<div class="modal-body row g-3">
					<div class="col-md-12">
						<label class="form-label fw-bold">اسم المصروف <span class="text-danger">*</span></label>
						<input type="text" name="Name" required class="form-control" placeholder="مثال: فاتورة كهرباء / إيجار / صيانة" />
					</div>

					<div class="col-md-6">
						<label class="form-label fw-bold">المبلغ الإجمالي <span class="text-danger">*</span></label>
						<input type="number" step="0.01" name="TotalAmount" id="expTotalAmount" min="0.01" required class="form-control fw-bold" oninput="togglePaidAmount()" autocomplete="off" />
					</div>

					<div class="col-md-6">
						<label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
						<select name="PaymentMethod" id="expPaymentMethod" class="form-select fw-bold" onchange="togglePaidAmount()">
							<option value="@((int)PaymentMethod.Cash)">كاش (مدفوع بالكامل)</option>
							<option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي (مدفوع بالكامل)</option>
							<option value="@((int)PaymentMethod.PartiallyPaid)">مدفوع جزئياً</option>
							<option value="@((int)PaymentMethod.Unpaid)">غير مدفوع (آجل)</option>
						</select>
					</div>

					

					<div class="col-md-6">
						<label class="form-label fw-bold">تاريخ المصروف</label>
						<input type="date" name="Date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
					</div>
					<div class="col-md-6" id="addPaidAmountContainer" style="display: none;">
						<label class="form-label fw-bold">المبلغ المدفوع حالياً (ج.م) <span class="text-danger">*</span></label>
						<input type="number" step="0.01" min="0" name="PaidAmount" id="expPaidAmount" value="0" class="form-control fw-bold text-primary" autocomplete="off" oninput="validateExpensePartialPayment()" />

						<div id="expPaidAmountError" class="text-danger small fw-bold mt-1 d-none">
							المبلغ المدفوع يجب أن يكون أقل من الإجمالي وأكبر من صفر.
						</div>
						<div id="expPaidAmountHint" class="text-muted small mt-1"></div>
					</div>
					<div class="col-12" id="expRemainingContainer" style="display: none;">
						<div class="p-2 bg-danger bg-opacity-10 rounded text-center border border-danger">
							<span class="text-muted d-block small">المبلغ المتبقي (آجل)</span>
							<span id="expRemainingAmount" class="fs-6 fw-bold text-danger">0.00</span> ج.م
						</div>
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات</label>
						<input type="text" name="Notes" class="form-control" placeholder="ملاحظات تفصيلية..." />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-bakery">حفظ المصروف</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modal Pay Remaining -->
<div class="modal fade" id="payModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-1"></i> سداد متبقي مصروف</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="PayRemaining" method="post">
				<input type="hidden" name="expenseId" id="payExpenseId" />
				<div class="modal-body g-3">
					<p class="fw-bold mb-2">اسم المصروف: <span id="payExpenseName" class="text-primary"></span></p>
					<div class="mb-3">
						<label class="form-label fw-bold">المبلغ المتبقي المستحق</label>
						<input type="text" id="payRemainingDisp" readonly class="form-control bg-light fw-bold text-danger" />
					</div>
					<div class="mb-3">
						<label class="form-label fw-bold">المبلغ المدفوع الآن <span class="text-danger">*</span></label>
						<input type="number" step="0.01" min="0.01" name="amountPaidNow" id="payNowVal" required class="form-control fw-bold" />
					</div>
					<div class="mb-3">
						<label class="form-label fw-bold">طريقة السداد</label>
						<select name="paymentMethod" class="form-select">
							<option value="@((int)PaymentMethod.Cash)">كاش</option>
							<option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي</option>
						</select>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-success fw-bold">تأكيد السداد</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modal Edit Expense -->
<div class="modal fade" id="editExpenseModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-1"></i> تعديل بيانات المصروف</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="Edit" method="post" id="editExpenseForm">
				<input type="hidden" name="Id" id="editExpenseId" />
				<input type="hidden" name="ExpenseCategoryId" id="editExpenseCategoryId" />

				<div class="modal-body row g-3">
					<div class="col-md-12">
						<label class="form-label fw-bold">اسم المصروف <span class="text-danger">*</span></label>
						<input type="text" name="Name" id="editName" required class="form-control" />
					</div>

					<div class="col-md-6">
						<label class="form-label fw-bold">المبلغ الإجمالي <span class="text-danger">*</span></label>
						<input type="number" step="0.01" name="TotalAmount" id="editTotalAmount" min="0.01" required class="form-control fw-bold" oninput="toggleEditPaidAmount()" autocomplete="off" />
					</div>

					<div class="col-md-6">
						<label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
						<select name="PaymentMethod" id="editPaymentMethod" class="form-select fw-bold" onchange="toggleEditPaidAmount()">
							<option value="@((int)PaymentMethod.Cash)">كاش (مدفوع بالكامل)</option>
							<option value="@((int)PaymentMethod.BankTransfer)">تحويل بنكي (مدفوع بالكامل)</option>
							<option value="@((int)PaymentMethod.PartiallyPaid)">مدفوع جزئياً</option>
							<option value="@((int)PaymentMethod.Unpaid)">غير مدفوع (آجل)</option>
						</select>
					</div>

					

					<div class="col-md-6">
						<label class="form-label fw-bold">تاريخ المصروف</label>
						<input type="date" name="Date" id="editDate" class="form-control" required />
					</div>
					<div class="col-md-6" id="editPaidAmountContainer" style="display: none;">
						<label class="form-label fw-bold">المبلغ المدفوع حالياً (ج.م) <span class="text-danger">*</span></label>
						<input type="number" step="0.01" min="0" name="PaidAmount" id="editPaidAmount" value="0" class="form-control fw-bold text-primary" autocomplete="off" oninput="validateEditExpensePartialPayment()" />

						<div id="editPaidAmountError" class="text-danger small fw-bold mt-1 d-none">
							المبلغ المدفوع يجب أن يكون أقل من الإجمالي وأكبر من صفر.
						</div>
						<div id="editPaidAmountHint" class="text-muted small mt-1"></div>
					</div>
					<div class="col-12" id="editRemainingContainer" style="display: none;">
						<div class="p-2 bg-danger bg-opacity-10 rounded text-center border border-danger">
							<span class="text-muted d-block small">المبلغ المتبقي (آجل)</span>
							<span id="editRemainingAmount" class="fs-6 fw-bold text-danger">0.00</span> ج.م
						</div>
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات</label>
						<input type="text" name="Notes" id="editNotes" class="form-control" placeholder="ملاحظات تفصيلية..." />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-primary fw-bold">حفظ التعديلات</button>
				</div>
			</form>
		</div>
	</div>
</div>


@section Scripts {
	<script>

		// 1. Toggle & Calculate Paid Amount (Add Expense Modal)

		function togglePaidAmount() {
			const pm = document.getElementById('expPaymentMethod').value;
			const total = parseFloat(document.getElementById('expTotalAmount').value) || 0;
			const paidInp = document.getElementById('expPaidAmount');
			const paidContainer = document.getElementById('addPaidAmountContainer');
			const remainingContainer = document.getElementById('expRemainingContainer');

			const cashVal = "@((int)PaymentMethod.Cash)";
			const bankVal = "@((int)PaymentMethod.BankTransfer)";
			const unpaidVal = "@((int)PaymentMethod.Unpaid)";
			const partialVal = "@((int)PaymentMethod.PartiallyPaid)";

			// كاش أو تحويل بنكي (مدفوع بالكامل)
			if (pm === cashVal || pm === bankVal) {
				if (paidContainer) paidContainer.style.display = "none";
				if (remainingContainer) remainingContainer.style.display = "none";
				paidInp.value = total > 0 ? total.toFixed(2) : '0.00';
				paidInp.required = false;
				clearExpensePaymentError();
				return;
			}

			// آجل (غير مدفوع)
			if (pm === unpaidVal) {
				if (paidContainer) paidContainer.style.display = "none";
				if (remainingContainer) remainingContainer.style.display = "none";
				paidInp.value = '0.00';
				paidInp.required = false;
				clearExpensePaymentError();
				return;
			}

			// دفع جزئي
			if (pm === partialVal) {
				if (paidContainer) paidContainer.style.display = "block";
				if (remainingContainer) remainingContainer.style.display = "block";
				paidInp.required = true;

				let currentPaid = parseFloat(paidInp.value) || 0;

				if (currentPaid === 0 || currentPaid >= total) {
					paidInp.value = total > 0 ? (total / 2).toFixed(2) : "0.00";
				}

				validateExpensePartialPayment();
			}
		}

		// 2. Validate Partial Payment (Add Expense Modal)

		function validateExpensePartialPayment() {
			const total = parseFloat(document.getElementById('expTotalAmount').value) || 0;
			const paid = parseFloat(document.getElementById('expPaidAmount').value) || 0;

			if (paid <= 0) {
				showExpensePaymentError("يجب إدخال مبلغ مدفوع أكبر من صفر.");
				return false;
			}

			if (paid >= total && total > 0) {
				showExpensePaymentError("في الدفع الجزئي، المبلغ المدفوع يجب أن يكون أقل من إجمالي المصروف.");
				return false;
			}

			clearExpensePaymentError();

			const remaining = Math.max(total - paid, 0);
			const remElem = document.getElementById('expRemainingAmount');
			if (remElem) remElem.innerText = remaining.toFixed(2);

			const hintElem = document.getElementById('paidAmountHint');
			if (hintElem) hintElem.innerText = `الإجمالي: ${total.toFixed(2)} ج.م - المتبقي: ${remaining.toFixed(2)} ج.م`;

			return true;
		}

		
		// 3. Error Helpers (Add Expense)

		function showExpensePaymentError(msg) {
			const err = document.getElementById('expPaidAmountError');
			const btn = document.querySelector('#addExpenseForm button[type="submit"]');
			if (err) {
				err.innerText = msg;
				err.classList.remove('d-none');
			}
			if (btn) btn.disabled = true;
		}

		function clearExpensePaymentError() {
			const err = document.getElementById('expPaidAmountError');
			const btn = document.querySelector('#addExpenseForm button[type="submit"]');
			if (err) err.classList.add('d-none');
			if (btn) btn.disabled = false;
		}

		
		// 4. Form Submit Listener Validation (Add Expense)

		const addExpenseForm = document.getElementById('addExpenseForm');
		if (addExpenseForm) {
			addExpenseForm.addEventListener('submit', function(e) {
				const pm = document.getElementById('expPaymentMethod').value;
				const partialVal = "@((int)PaymentMethod.PartiallyPaid)";

				if (pm === partialVal) {
					const isValid = validateExpensePartialPayment();
					if (!isValid) {
						e.preventDefault();
						return false;
					}
				}
				return true;
			});
		}

		
		// 5. Toggle & Calculate Paid Amount (Edit Expense Modal)

		function toggleEditPaidAmount() {
			const pm = document.getElementById('editPaymentMethod').value;
			const total = parseFloat(document.getElementById('editTotalAmount').value) || 0;
			const paidInp = document.getElementById('editPaidAmount');
			const paidContainer = document.getElementById('editPaidAmountContainer');
			const remainingContainer = document.getElementById('editRemainingContainer');

			const cashVal = "@((int)PaymentMethod.Cash)";
			const bankVal = "@((int)PaymentMethod.BankTransfer)";
			const unpaidVal = "@((int)PaymentMethod.Unpaid)";
			const partialVal = "@((int)PaymentMethod.PartiallyPaid)";

			// كاش أو تحويل بنكي (مدفوع بالكامل)
			if (pm === cashVal || pm === bankVal) {
				if (paidContainer) paidContainer.style.display = "none";
				if (remainingContainer) remainingContainer.style.display = "none";
				paidInp.value = total > 0 ? total.toFixed(2) : '0.00';
				paidInp.required = false;
				clearEditExpensePaymentError();
				return;
			}

			// آجل (غير مدفوع)
			if (pm === unpaidVal) {
				if (paidContainer) paidContainer.style.display = "none";
				if (remainingContainer) remainingContainer.style.display = "none";
				paidInp.value = '0.00';
				paidInp.required = false;
				clearEditExpensePaymentError();
				return;
			}

			// دفع جزئي
			if (pm === partialVal) {
				if (paidContainer) paidContainer.style.display = "block";
				if (remainingContainer) remainingContainer.style.display = "block";
				paidInp.required = true;

				let currentPaid = parseFloat(paidInp.value) || 0;

				if (currentPaid === 0 || currentPaid >= total) {
					paidInp.value = total > 0 ? (total / 2).toFixed(2) : "0.00";
				}

				validateEditExpensePartialPayment();
			}
		}

		
		// 6. Validate Partial Payment (Edit Expense Modal)

		function validateEditExpensePartialPayment() {
			const total = parseFloat(document.getElementById('editTotalAmount').value) || 0;
			const paid = parseFloat(document.getElementById('editPaidAmount').value) || 0;

			if (paid <= 0) {
				showEditExpensePaymentError("يجب إدخال مبلغ مدفوع أكبر من صفر.");
				return false;
			}

			if (paid >= total && total > 0) {
				showEditExpensePaymentError("في الدفع الجزئي، المبلغ المدفوع يجب أن يكون أقل من إجمالي المصروف.");
				return false;
			}

			clearEditExpensePaymentError();

			const remaining = Math.max(total - paid, 0);
			const remElem = document.getElementById('editRemainingAmount');
			if (remElem) remElem.innerText = remaining.toFixed(2);

			const hintElem = document.getElementById('editPaidAmountHint');
			if (hintElem) hintElem.innerText = `الإجمالي: ${total.toFixed(2)} ج.م - المتبقي: ${remaining.toFixed(2)} ج.م`;

			return true;
		}

		
		// 7. Error Helpers (Edit Expense)

		function showEditExpensePaymentError(msg) {
			const err = document.getElementById('editPaidAmountError');
			const btn = document.querySelector('#editExpenseForm button[type="submit"]');
			if (err) {
				err.innerText = msg;
				err.classList.remove('d-none');
			}
			if (btn) btn.disabled = true;
		}

		function clearEditExpensePaymentError() {
			const err = document.getElementById('editPaidAmountError');
			const btn = document.querySelector('#editExpenseForm button[type="submit"]');
			if (err) err.classList.add('d-none');
			if (btn) btn.disabled = false;
		}

		
		// 8. Edit Form Submit Listener

		const editExpenseForm = document.getElementById('editExpenseForm');
		if (editExpenseForm) {
			editExpenseForm.addEventListener('submit', function(e) {
				const pm = document.getElementById('editPaymentMethod').value;
				const partialVal = "@((int)PaymentMethod.PartiallyPaid)";

				if (pm === partialVal) {
					const isValid = validateEditExpensePartialPayment();
					if (!isValid) {
						e.preventDefault();
						return false;
					}
				}
				return true;
			});
		}

		
		// 9. Modals Trigger Helpers

		function openPayModal(id, name, remaining) {
			document.getElementById('payExpenseId').value = id;
			document.getElementById('payExpenseName').innerText = name;
			document.getElementById('payRemainingDisp').value = remaining.toFixed(2) + " ج.م";
			document.getElementById('payNowVal').value = remaining.toFixed(2);
			document.getElementById('payNowVal').max = remaining;
			new bootstrap.Modal(document.getElementById('payModal')).show();
		}

		function openEditModal(id, name, totalAmount, paymentMethod, paidAmount, date, notes, categoryId) {
			document.getElementById('editExpenseId').value = id;
			document.getElementById('editName').value = name;
			document.getElementById('editTotalAmount').value = totalAmount;
			document.getElementById('editPaymentMethod').value = paymentMethod;
			document.getElementById('editPaidAmount').value = paidAmount;
			document.getElementById('editDate').value = date;
			document.getElementById('editNotes').value = notes || '';
			document.getElementById('editExpenseCategoryId').value = categoryId;

			toggleEditPaidAmount();

			new bootstrap.Modal(document.getElementById('editExpenseModal')).show();
		}
	</script>
}