@model Bakery.Domain.Entities.ProductionSetting
@{
    ViewData["Title"] = "إعدادات أسعار الباسكيت والإنتاج";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-sliders text-warning me-2"></i> إعدادات أسعار الباسكيت ومعدلات الإنتاج</h2>
        <p class="text-muted mb-0">التحكم في سعر بيع الباسكيت الافتراضي ومعدل القطع التي تنتجها شكارة الدقيق</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header bg-amber text-white fw-bold py-3">
                <i class="fa-solid fa-gear me-2"></i> إعدادات النظام الرئيسية
            </div>
            <form asp-action="Update" method="post" class="card-body p-4">
                <input type="hidden" name="Id" value="@Model.Id" />

                <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-basket-shopping me-2"></i> 1. سعر بيع الباسكيت</h5>
                <div class="mb-4">
                    <label class="form-label fw-bold">سعر بيع الباسكيت الواحد (ج.م) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" name="BasketSellingPrice" value="@Model.BasketSellingPrice" required class="form-control form-control-lg fw-bold text-success" />
                    <small class="text-muted d-block mt-1">يستخدم هذا السعر لحساب إجمالي القيمة المتوقعة والفعلية للمبيعات في الإنتاج واليومية.</small>
                </div>

                <hr class="my-4" />

                <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-wheat-awn me-2"></i> 2. معدل إنتاج القطع من شكارة الدقيق الواحدة</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">قطع المبروم لكل شكارة <span class="text-danger">*</span></label>
                        <input type="number" step="1" name="MabroumPiecesPerSack" value="@Model.MabroumPiecesPerSack" required class="form-control fw-bold" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">قطع البانيه لكل شكارة <span class="text-danger">*</span></label>
                        <input type="number" step="1" name="PanePiecesPerSack" value="@Model.PanePiecesPerSack" required class="form-control fw-bold" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">قطع الساندوتش لكل شكارة <span class="text-danger">*</span></label>
                        <input type="number" step="1" name="SandwichPiecesPerSack" value="@Model.SandwichPiecesPerSack" required class="form-control fw-bold" />
                    </div>
                </div>

                <hr class="my-4" />

                <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-box me-2"></i> 3. سعة الباسكيت (عدد القطع)</h5>
                <div class="mb-4">
                    <label class="form-label fw-bold">عدد القطع داخل الباسكيت الواحد <span class="text-danger">*</span></label>
                    <input type="number" step="1" name="PiecesPerBasket" value="@Model.PiecesPerBasket" required class="form-control fw-bold" />
                    <small class="text-muted d-block mt-1">افتراضياً 28 قطعة بكل باسيكت.</small>
                </div>

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-bakery btn-lg px-5">
                        <i class="fa-solid fa-floppy-disk me-1"></i> حفظ التعديلات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
