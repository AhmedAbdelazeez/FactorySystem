<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - مصنع الباتيه (نظام الإدارة)</title>
	<!-- Bootstrap 5 RTL CSS -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
	<!-- FontAwesome Icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
	<!-- Site CSS -->
	<link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
	<!-- Funny Bakery Loader Overlay -->
	<div id="bakeryLoader">
		<div class="loader-card">
			<div id="bakeryLoaderIcon" class="loader-icon">🥐</div>
			<div id="bakeryLoaderMessage" class="loader-text">جاري تجهيز البيانات...</div>
			<div class="loader-subtext">مصنع الباتيه السعيد 😄</div>
		</div>
	</div>

	<!-- Navigation Header -->
	<nav class="navbar navbar-expand-lg bakery-navbar sticky-top mb-4">
		<div class="container-fluid">
			<a class="navbar-brand" asp-controller="Home" asp-action="Index">
				<i class="fa-solid fa-bread-slice me-2"></i> مصنع الباتيه
			</a>
			<button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#bakeryNavbar">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="bakeryNavbar">
				<ul class="navbar-nav me-auto mb-2 mb-lg-0">
					<li class="nav-item">
						<a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-chart-line me-1"></i> لوحة التحكم</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" asp-controller="Production" asp-action="Index"><i class="fa-solid fa-industry me-1"></i> الإنتاج اليومي</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" asp-controller="Recipe" asp-action="Index"><i class="fa-solid fa-scroll me-1"></i> وصفة شكارة الدقيق</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" asp-controller="Inventory" asp-action="Index"><i class="fa-solid fa-boxes-stacked me-1"></i> مخزن الخامات</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" asp-controller="Expenses" asp-action="Index"><i class="fa-solid fa-receipt me-1"></i> المصروفات</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" asp-controller="Treasury" asp-action="Index"><i class="fa-solid fa-vault me-1"></i> الخزينة والأرباح</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" asp-controller="Employees" asp-action="Index"><i class="fa-solid fa-users me-1"></i> العاملين</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" asp-controller="Attendance" asp-action="Index"><i class="fa-solid fa-clipboard-user me-1"></i> حضور وانصراف</a>
					</li>
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="fa-solid fa-gear me-1"></i> الإعدادات والأكواد</a>
						<ul class="dropdown-menu dropdown-menu-end">
							<li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="fa-solid fa-tags me-1"></i> سعر الباسكيت والإنتاج</a></li>
							<li><a class="dropdown-item" asp-controller="Lookups" asp-action="Index"><i class="fa-solid fa-list me-1"></i> أكواد الجداول المرجعية</a></li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</nav>

	<!-- Main Content Container -->
	<div class="container-fluid px-4 pb-5">
		@if (TempData["SuccessMessage"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
				<i class="fa-solid fa-circle-check me-2 fs-5"></i>
				<div>@TempData["SuccessMessage"]</div>
				<button type="button" class="btn-close me-auto ms-0" data-bs-dismiss="alert"></button>
			</div>
		}
		@if (TempData["ErrorMessage"] != null)
		{
			<div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
				<i class="fa-solid fa-circle-exclamation me-2 fs-5"></i>
				<div>@TempData["ErrorMessage"]</div>
				<button type="button" class="btn-close me-auto ms-0" data-bs-dismiss="alert"></button>
			</div>
		}

		@RenderBody()
	</div>

	<!-- Bootstrap 5 JS Bundle -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js"></script>

   
	<!-- Generic Confirm Delete Modal - يستخدم في كل الصفحات -->
	<div class="modal fade" id="confirmDeleteModal" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header bg-danger text-white">
					<h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i> تأكيد الحذف</h5>
					<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body" id="confirmDeleteMessage">
					هل أنت متأكد من الحذف؟ لا يمكن التراجع عن هذا الإجراء.
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<form id="genericDeleteForm" method="post" class="d-inline">
						<input type="hidden" name="id" id="genericDeleteId" />
						<button type="submit" class="btn btn-danger fw-bold">نعم، احذف</button>
					</form>
				</div>
			</div>
		</div>
	</div>
	<script>
			function confirmDelete(id, actionUrl, message) {
				document.getElementById('genericDeleteId').value = id;
				document.getElementById('genericDeleteForm').action = actionUrl;

				if (message) {
					document.getElementById('confirmDeleteMessage').innerText = message;
				} else {
					document.getElementById('confirmDeleteMessage').innerText = 'هل أنت متأكد من الحذف؟ لا يمكن التراجع عن هذا الإجراء.';
				}

				new bootstrap.Modal(document.getElementById('confirmDeleteModal')).show();
			}
	</script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
