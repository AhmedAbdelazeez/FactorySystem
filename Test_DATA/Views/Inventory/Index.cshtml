@model IEnumerable<Bakery.Domain.Entities.RawMaterial>
@{
    ViewData["Title"] = "مخزن المواد الخام";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-boxes-stacked text-warning me-2"></i> مخزن المواد الخام واللوازم</h2>
        <p class="text-muted mb-0">متابعة أرصاد الخامات المتوفرة بالمخزن فقط (عرض الكميات المتاحة وسعر الشكارة/الوحدة)</p>
    </div>
    <div class="col-auto">
        <a asp-action="Transactions" class="btn btn-outline-secondary"><i class="fa-solid fa-clock-rotate-left me-1"></i> سجل حركة المخزن</a>
    </div>
</div>

<!-- Info Banner -->
<div class="alert alert-info d-flex align-items-center mb-4 shadow-sm border-0 bg-light-info" role="alert">
    <i class="fa-solid fa-circle-info fs-4 text-info me-3"></i>
    <div>
        هذه الصفحة مخصصة لـ <strong>الاطلاع والمتابعة على الكميات المتوفرة بالمخزن فقط</strong> قبيل دخول دورات الإنتاج.
        يتم تحديث وزيادة رصيد الخامات وأسعارها تلقائياً عبر إضافة الفواتير من صفحة <a asp-controller="Suppliers" asp-action="Index" class="fw-bold text-primary text-decoration-underline me-1">الموردين والفواتير</a>.
    </div>
</div>

<!-- Raw Materials Stock Table (Read-Only) -->
<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bakery mb-0 align-middle">
                <thead>
                    <tr>
                        <th>اسم المادة الخام</th>
                        <th>الكمية المتوفرة بالمخزن</th>
                        <th>وحدة القياس</th>
                        <th>سعر الشكارة / الوحدة</th>
                        <th>تاريخ آخر تحديث</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark fs-6">
                                    <i class="fa-solid fa-box text-warning me-2"></i> @item.MaterialName
                                </td>
                                <td>
                                    <span class="fs-5 fw-bold @(item.CurrentQuantity <= 10 ? "text-danger" : "text-dark")">
                                        @item.CurrentQuantity.ToString("0.###")
                                    </span>
                                    @if (item.CurrentQuantity <= 10)
                                    {
                                        <span class="badge bg-danger ms-1">كمية منخفضة</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border fs-6">@(item.MeasurementUnit?.Name ?? "-")</span></td>
                                <td class="fw-bold text-dark fs-6">@item.UnitPrice.ToString("N2") ج.م</td>
                                <td class="small text-muted">@item.LastUpdatedDate.ToString("yyyy/MM/dd HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center p-4 text-muted">لا توجد مواد خام مسجلة بالمخزن حالياً. يتم إضافة وتحديث الخامات فور تسجيل الفواتير بصفحة الموردين.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
