@model IEnumerable<Bakery.Domain.Entities.RawMaterial>
@{
	ViewData["Title"] = "مخزن المواد الخام";
	var units = ViewBag.MeasurementUnits as IEnumerable<Bakery.Domain.Entities.MeasurementUnit> ?? new List<Bakery.Domain.Entities.MeasurementUnit>();
	decimal totalInventoryVal = ViewBag.TotalInventoryValue != null ? (decimal)ViewBag.TotalInventoryValue : 0;
}

<div class="row mb-4 align-items-center">
	<div class="col">
		<h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-boxes-stacked text-warning me-2"></i> مخزن المواد الخام واللوازم</h2>
		<p class="text-muted mb-0">متابعة رصيد الدقيق والسكر والزبدة ومواد التغليف وإدارتها بكل سهولة</p>
	</div>
	<div class="col-auto d-flex gap-2">
		<a asp-action="Transactions" class="btn btn-outline-secondary"><i class="fa-solid fa-clock-rotate-left me-1"></i> سجل حركة المخزن</a>
		<button class="btn btn-bakery" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
			<i class="fa-solid fa-plus me-1"></i> إضافة مادة خام جديدة
		</button>
	</div>
</div>

<!-- Total Inventory Card Header -->
<div class="card card-custom p-4 mb-4 bg-amber text-white">
	<div class="row align-items-center">
		<div class="col-md-8">
			<h4 class="fw-bold mb-1"><i class="fa-solid fa-vault me-2"></i> إجمالي قيمة المخزون الحالي الفعلي</h4>
			<p class="mb-0 text-white-50">مجموع قيم كافة الخامات المتوفرة بالمخزن بناءً على الكمية الحالية وسعر الوحدة</p>
		</div>
		<div class="col-md-4 text-md-end mt-3 mt-md-0">
			<h1 class="display-6 fw-extrabold mb-0">@totalInventoryVal.ToString("N2") <small class="fs-4">ج.م</small></h1>
		</div>
	</div>
</div>

<!-- Raw Materials Table -->
<div class="card card-custom">
	<div class="card-body p-0">
		<div class="table-responsive">
			<table class="table table-bakery mb-0">
				<thead>
					<tr>
						<th>اسم المادة الخام</th>
						<th>الكمية الحالية</th>
						<th>وحدة القياس</th>
						<th>سعر الوحدة</th>
						<th>القيمة الإجمالية للمادة</th>
						<th>تاريخ آخر تحديث</th>
						<th class="text-center">الإجراءات والتوريد</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Any())
					{
						foreach (var item in Model)
						{
							<tr>
								<td class="fw-bold text-dark">
									<i class="fa-solid fa-box text-warning me-2"></i> @item.Name
								</td>
								<td>
									<span class="fs-6 fw-bold @(item.CurrentQuantity <= 10 ? "text-danger" : "text-dark")">
										@item.CurrentQuantity.ToString("0.###")
									</span>
									@if (item.CurrentQuantity <= 10)
									{
										<span class="badge bg-danger ms-1">كمية منخفضة</span>
									}
								</td>
								<td><span class="badge bg-light text-dark border">@(item.MeasurementUnit?.Name ?? "-")</span></td>
								<td>@item.UnitPrice.ToString("N2") ج.م</td>
								<td class="fw-bold text-primary">@item.TotalValue.ToString("N2") ج.م</td>
								<td class="small text-muted">@item.LastUpdatedDate.ToString("yyyy/MM/dd HH:mm")</td>
								<td class="text-center">
									<button class="btn btn-sm btn-success" onclick="openAddStockModal(@item.Id, '@item.Name', @item.UnitPrice)">
										<i class="fa-solid fa-truck-ramp-box me-1"></i> توريد كمية
									</button>

									<button class="btn btn-sm btn-outline-primary" onclick="openEditModal(@item.Id, '@item.Name', @item.MeasurementUnitId, @item.CurrentQuantity, @item.UnitPrice)">
										<i class="fa-solid fa-pen"></i>
									</button>

									<form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('هل أنت تأكد من حذف المادة الخام؟');">
										<input type="hidden" name="id" value="@item.Id" />
										<button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
									</form>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="7" class="text-center p-4 text-muted">لا توجد مواد خام مسجلة بالمخزن حالياً. اضغط على إضافة مادة خام لإضافة الصنف الأول.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- Modal Add New Raw Material -->
<div class="modal fade" id="addMaterialModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-amber text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-plus me-1"></i> إضافة مادة خام جديدة</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="Create" method="post">
				<div class="modal-body row g-3">
					<div class="col-12">
						<label class="form-label fw-bold">اسم المادة الخام <span class="text-danger">*</span></label>
						<input type="text" name="Name" required class="form-control" placeholder="مثال: دقيق فاخر / سكر ناعم / زبدة طبيعي / مواد حافظة" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">وحدة القياس <span class="text-danger">*</span></label>
						<select name="MeasurementUnitId" required class="form-select">
							@foreach (var unit in units)
							{
								<option value="@unit.Id">@unit.Name</option>
							}
						</select>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">الكمية الافتتاحية بالحزن</label>
						<input type="number" step="0.001" name="CurrentQuantity" value="0" class="form-control" />
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">سعر الوحدة الافتراضي (ج.م)</label>
						<input type="number" step="0.01" name="UnitPrice" value="0" class="form-control" />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-bakery">حفظ المادة الخام</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modal Add Stock / Supply -->
<div class="modal fade" id="addStockModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-truck-ramp-box me-1"></i> توريد كمية جديدة للمخزن</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="AddStock" method="post">
				<input type="hidden" name="rawMaterialId" id="stockMaterialId" />
				<div class="modal-body row g-3">
					<div class="col-12">
						<p class="fw-bold mb-1">المادة الخام: <span id="stockMaterialName" class="text-primary fs-5"></span></p>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">الكمية الموردة <span class="text-danger">*</span></label>
						<input type="number" step="0.001" name="quantity" required class="form-control" placeholder="أدخل الكمية المضافة" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">سعر شراء الوحدة (ج.م)</label>
						<input type="number" step="0.01" name="unitPrice" id="stockUnitPrice" class="form-control" />
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات / اسم المورد</label>
						<input type="text" name="notes" class="form-control" placeholder="تفاصيل أذونات الاستلام أو الفاتورة..." />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-success fw-bold">تأكيد التوريد وزيادة المخزن</button>
				</div>
			</form>
		</div>
	</div>
</div>


<!-- Modal Edit Raw Material -->
<div class="modal fade" id="editMaterialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen me-1"></i> تعديل بيانات المادة الخام</h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editMaterialId" />
                <div class="modal-body row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold">اسم المادة الخام <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="editMaterialName" required class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">وحدة القياس <span class="text-danger">*</span></label>
                        <select name="MeasurementUnitId" id="editMaterialUnitId" required class="form-select">
                            @foreach (var unit in units)
                            {
                                <option value="@unit.Id">@unit.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">الكمية الحالية</label>
                        <input type="number" step="0.001" name="CurrentQuantity" id="editMaterialQuantity" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">سعر الوحدة (ج.م)</label>
                        <input type="number" step="0.01" name="UnitPrice" id="editMaterialUnitPrice" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
	<script>
		function openAddStockModal(id, name, currentUnitPrice) {
				document.getElementById('stockMaterialId').value = id;
					document.getElementById('stockMaterialName').innerText = name;
					document.getElementById('stockUnitPrice').value = currentUnitPrice;
					new bootstrap.Modal(document.getElementById('addStockModal')).show();
				}

	   function openEditModal(id, name, unitId, quantity, unitPrice) {
            document.getElementById('editMaterialId').value = id;
            document.getElementById('editMaterialName').value = name;
            document.getElementById('editMaterialUnitId').value = unitId;
            document.getElementById('editMaterialQuantity').value = quantity;
            document.getElementById('editMaterialUnitPrice').value = unitPrice;
            new bootstrap.Modal(document.getElementById('editMaterialModal')).show();
        }
	</script>
}
