@using Bakery.Domain.Enums
@model IEnumerable<Bakery.Business.DTOs.ProductOrderSalesHistoryDto>
@{
	ViewData["Title"] = "شاشة وسجل المبيعات";
	var availableOrders = ViewBag.AvailableOrders as IEnumerable<Bakery.Business.DTOs.ProductionOrderDto> ?? new List<Bakery.Business.DTOs.ProductionOrderDto>();
	var settings = ViewBag.Settings as Bakery.Domain.Entities.ProductionSetting ?? new Bakery.Domain.Entities.ProductionSetting();
    int piecesPerBasket = settings.PiecesPerBasket > 0 ? settings.PiecesPerBasket : 28;
	// حساب إحصائيات الكروت
	decimal totalSales = Model?.Sum(s => s.TotalAmount) ?? 0;
	decimal totalPaid = Model?.Sum(s => s.PaidAmount) ?? 0;
	decimal totalRemaining = Model?.Sum(s => s.RemainingAmount) ?? 0;


}

<!-- Header -->
<div class="page-header-box mb-3 p-3 bg-white rounded-4 border shadow-sm">
	<div class="row align-items-center gy-3">
		<div class="col-md d-flex align-items-center gap-3">
			<div class="rounded-3 d-flex align-items-center justify-content-center"
				 style="width: 48px; height: 48px; background-color: #e3f2fd; color: #0d6efd; flex-shrink: 0;">
				<i class="fa-solid fa-cart-shopping fs-4"></i>
			</div>
			<div>
				<h3 class="fw-bold text-dark mb-1 fs-5">شاشة مبيعات الإنتاج</h3>
				<p class="text-muted mb-0 fs-7">
					تسجيل حركات البيع المباشرة والآجلة وتفريغ رصيد الباسكيت وتحصيل المتبقي
				</p>
			</div>
		</div>
		<div class="col-md-auto ms-auto d-flex gap-2">
			<a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-bold fs-7">
				<i class="fa-solid fa-industry me-1"></i> أوامر الإنتاج
			</a>
			<button class="btn btn-primary rounded-3 shadow-sm px-3 py-2 fw-bold fs-7 d-flex align-items-center gap-2"
					data-bs-toggle="modal"
					data-bs-target="#newSaleModal">
				<i class="fa-solid fa-cart-plus"></i>
				<span>تسجيل حركة بيع جديدة</span>
			</button>
		</div>
	</div>
</div>

<!-- Compact Date Filter Box -->
<div class="card border-0 shadow-sm rounded-4 mb-3">
	<div class="card-body p-2 px-3 bg-light rounded-4 border">
		<form asp-action="Sales" method="get" id="dateFilterForm" class="d-flex align-items-center justify-content-between flex-wrap gap-2">
			<div class="d-flex align-items-center gap-2">
				<label for="selectedDate" class="fw-bold fs-7 text-dark text-nowrap mb-0">
					<i class="fa-regular fa-calendar-days text-primary me-1"></i> اختر اليوم لعرض حركاته:
				</label>
				<input type="date"
					   name="selectedDate"
					   id="selectedDate"
					   class="form-control form-control-sm bg-white fw-bold shadow-sm"
					   style="max-width: 160px;"
					   value="@(Context.Request.Query["selectedDate"].ToString() ?? DateTime.Now.ToString("yyyy-MM-dd"))"
					   onchange="document.getElementById('dateFilterForm').submit();" />
			</div>

			<div class="d-flex gap-2 align-items-center">
				<button type="button" class="btn btn-sm btn-primary fw-bold px-3 fs-7" onclick="selectToday()">
					<i class="fa-solid fa-calendar-day me-1"></i> اليوم
				</button>
				<a asp-action="Sales" class="btn btn-sm btn-outline-secondary fw-bold px-3 fs-7" title="عرض كل الحركات">
					<i class="fa-solid fa-list me-1"></i> عرض كافة الحركات
				</a>
			</div>
		</form>
	</div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-3">
	<div class="col-md-4">
		<div class="card border-0 shadow-sm bg-primary text-white p-3 rounded-4">
			<div class="d-flex justify-content-between align-items-center">
				<div>
					<span class="d-block text-white-50 fs-7 fw-bold">إجمالي المبيعات</span>
					<h4 class="fw-bold mb-0">@totalSales.ToString("N2") <small class="fs-6">ج.م</small></h4>
				</div>
				<div class="fs-2 text-white-50"><i class="fa-solid fa-file-invoice-dollar"></i></div>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card border-0 shadow-sm bg-success text-white p-3 rounded-4">
			<div class="d-flex justify-content-between align-items-center">
				<div>
					<span class="d-block text-white-50 fs-7 fw-bold">المحصل فعلياً بالخزينة</span>
					<h4 class="fw-bold mb-0">@totalPaid.ToString("N2") <small class="fs-6">ج.م</small></h4>
				</div>
				<div class="fs-2 text-white-50"><i class="fa-solid fa-cash-register"></i></div>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card border-0 shadow-sm bg-danger text-white p-3 rounded-4">
			<div class="d-flex justify-content-between align-items-center">
				<div>
					<span class="d-block text-white-50 fs-7 fw-bold">المتبقي (الديون/الآجل)</span>
					<h4 class="fw-bold mb-0">@totalRemaining.ToString("N2") <small class="fs-6">ج.م</small></h4>
				</div>
				<div class="fs-2 text-white-50"><i class="fa-solid fa-hand-holding-dollar"></i></div>
			</div>
		</div>
	</div>
</div>

<!-- Sales History Table -->
<div class="card card-custom border-0 shadow-sm rounded-4">
	<div class="card-header bg-white py-3">
		<h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-history me-1 text-primary"></i> سجل حركات البيع والتسليم</h6>
	</div>
	<div class="card-body p-0">
		<div class="table-responsive">
			<table class="table table-hover table-bakery mb-0 align-middle text-center">
				<thead class="table-light text-nowrap">
					<tr>
						<th style="min-width: 120px;">التاريخ والوقت</th>
						<th style="min-width: 190px;" class="text-start">بيان الحركة والمنتج</th>
						<th style="min-width: 110px;">الإجمالي المنتج</th>
						<th style="min-width: 100px;">الكمية المباعة</th>
						<th style="min-width: 110px;">الكمية المتبقية</th>
						<th style="min-width: 90px;">سعر الباسكيت</th>
						<th style="min-width: 110px;">إجمالي قيمه البيع</th>
						<th style="min-width: 110px;">المدفوع (الخزينة)</th>
						<th style="min-width: 100px;">المتبقي (الآجل)</th>
						<th style="min-width: 140px;" class="text-center">الإجراءات</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.Any())
					{
						foreach (var sale in Model)
						{
							<tr>
								<!-- التاريخ والوقت -->
								<td class="text-nowrap">
									<div class="fw-bold text-primary fs-7"><i class="fa-regular fa-calendar me-1"></i>@sale.ProductSoldAt.ToString("yyyy/MM/dd")</div>
									<div class="small text-muted fs-7"><i class="fa-regular fa-clock me-1"></i>@sale.ProductSoldAt.ToString("hh:mm tt")</div>
								</td>

								<!-- بيان الحركة والمنتج -->
								<td class="text-start">
									<div class="fw-bold text-dark">بيع منتج <span class="badge bg-amber text-dark px-2 py-1">@sale.SelectedProductTypeName</span></div>
									<small class="text-muted">من أمر إنتاج رقم <span class="fw-bold text-secondary">#@sale.ProductionOrderId</span></small>
								</td>

								<!-- إلاجمالي المنتج -->
								<td>
									<div class="fw-bold text-dark">@sale.TotalActualBaskets.ToString("0.##") <small class="text-muted">باسكت</small></div>
									
								</td>

								<!-- الكمية المباعة -->
								<td>
									<span class="fw-bold text-primary fs-6">@sale.SoldBaskets.ToString("0.##")</span>
									<small class="text-muted d-block fs-7">باسكت</small>
								</td>

								<!-- الكمية المتبقية -->
								<td>
									<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-7">
										<i class="fa-solid fa-box me-1"></i>@sale.RemainingBasketsInOrder.ToString("0.##") باسكت
									</span>
								</td>

								<td class="text-nowrap fw-bold">@sale.BasketSellingPrice.ToString("N2") <small class="text-muted fs-7">ج.م</small></td>
								<td class="fw-bold text-dark text-nowrap">@sale.TotalAmount.ToString("N2") <small class="text-muted fs-7">ج.م</small></td>

								<!-- المدفوع (الخزينة) -->
								<td class="text-nowrap">
									<div class="fw-bold text-success">@sale.PaidAmount.ToString("N2") <small class="fs-7">ج.م</small></div>
									@switch (sale.PaymentMethod)
									{
										case PaymentMethod.Cash:
											<span class="badge bg-success-subtle text-success border border-success-subtle fs-7 px-2 py-0">كاش</span>
											break;
										case PaymentMethod.BankTransfer:
											<span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-7 px-2 py-0">تحويل</span>
											break;
										case PaymentMethod.PartiallyPaid:
											<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-7 px-2 py-0">جزئي</span>
											break;
										case PaymentMethod.Unpaid:
											<span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-7 px-2 py-0">آجل</span>
											break;
									}
								</td>

								<!-- المتبقي (الآجل) -->
								<td class="text-nowrap">
									@if (sale.RemainingAmount > 0)
									{
										<div class="fw-bold text-danger fs-7">@sale.RemainingAmount.ToString("N2") <small>ج.م</small></div>
									}
									else
									{
										<span class="badge bg-light text-muted border px-2 py-1 fs-7"><i class="fa-solid fa-check me-1"></i>خالص</span>
									}
								</td>

								<!-- الإجراءات -->
								<td class="text-center">
									<div class="d-flex justify-content-center gap-1 align-items-center">
										@if (sale.RemainingAmount > 0)
										{
											<button type="button"
													class="btn btn-sm btn-success fw-bold px-2 py-1 fs-7"
													title="تحصيل المتبقي"
													onclick="openCollectModal(@sale.Id, @sale.RemainingAmount)">
												<i class="fa-solid fa-hand-holding-dollar me-1"></i> تحصيل
											</button>
										}

										<button type="button"
												class="btn btn-sm btn-outline-danger px-2 py-1 fs-7"
												title="إلغاء الحركة"
												onclick="openConfirmCancelModal(@sale.Id, '@sale.SelectedProductTypeName', '@sale.SoldBaskets')">
											<i class="fa-solid fa-rotate-left"></i> إلغاء
										</button>
									</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="10" class="text-center p-4 text-muted">لا توجد حركات بيع مسجلة حالياً.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- Generic Cancel Confirmation Modal -->
<div class="modal fade" id="cancelConfirmModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-danger text-white">
				<h5 class="modal-title fs-6 fw-bold">
					<i class="fa-solid fa-triangle-exclamation me-1"></i> تأكيد إلغاء حركة البيع
				</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body text-center p-4">
				<div class="text-danger mb-3">
					<i class="fa-solid fa-circle-xmark fs-1"></i>
				</div>
				<h6 class="fw-bold text-dark mb-2">هل أنت متأكد من إلغاء حركة البيع هذه؟</h6>
				<p class="text-muted small mb-0" id="cancelModalDetailsText">
					سيتم خصم المبالغ من الخزينة وإعادة الباسكيتات المباعة لحساب أمر الإنتاج مرة أخرى.
				</p>
			</div>
			<div class="modal-footer bg-light justify-content-center">
				<form id="cancelSaleForm" asp-action="CancelSale" method="post">
					@Html.AntiForgeryToken()
					<input type="hidden" name="id" id="cancelSaleId" />
					<button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">تراجع</button>
					<button type="submit" class="btn btn-danger px-4 fw-bold">
						<i class="fa-solid fa-trash me-1"></i> تأكيد الإلغاء
					</button>
				</form>
			</div>
		</div>
	</div>
</div>

<!-- Modal Record New Sale -->
<div class="modal fade" id="newSaleModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title fw-bold">
					<i class="fa-solid fa-cart-plus me-1"></i>
					تسجيل عملية بيع جديدة
				</h5>

				<button type="button"
						class="btn-close btn-close-white ms-0 me-auto"
						data-bs-dismiss="modal">
				</button>
			</div>

			<form asp-action="RecordSale"
				  method="post"
				  id="newSaleForm">

				@Html.AntiForgeryToken()

				<div class="modal-body row g-3">

					<!-- Production Order -->
					<div class="col-12">
						<label class="form-label fw-bold">
							اختر أمر الإنتاج المتاح
							<span class="text-danger">*</span>
						</label>

						<select name="ProductionOrderId"
								id="selectProductionOrder"
								required
								class="form-select form-select-lg fw-bold"
								onchange="onOrderSelected()">

							<option value="">
								-- اختر أمر إنتاج --
							</option>

							@foreach (var order in availableOrders)
							{
								<option value="@order.Id"
										data-available="@order.ActualBaskets"
										data-price="@order.BasketSellingPrice">
									أمر #@order.Id -
									@order.SelectedProductTypeName
									(المتاح: @order.ActualBaskets.ToString("0.##") باسكت)
								</option>
							}

						</select>
					</div>

					<!-- Sold Baskets -->
					<div class="col-md-6">
						<label class="form-label fw-bold">
							عدد الباسكيت المباع
							<span class="text-danger">*</span>
						</label>

						<input type="number"
							   step="0.01"
							   name="SoldBaskets"
							   id="saleSoldBaskets"
							   min="0.01"
							   value="1"
							   required
							   class="form-control form-control-lg fw-bold text-success"
							   oninput="calculateSaleTotal()" />
					</div>

					<!-- Basket Price -->
					<div class="col-md-6">
						<label class="form-label fw-bold">
							سعر الباسكيت (ج.م)
						</label>

						<input type="number"
							   step="0.01"
							   name="BasketSellingPrice"
							   id="saleBasketPrice"
							   min="0.01"
							   required
							   class="form-control form-control-lg fw-bold"
							   oninput="calculateSaleTotal()" />
					</div>

					<!-- Payment Method -->
					<div class="col-md-6">
						<label class="form-label fw-bold">
							طريقة الدفع
							<span class="text-danger">*</span>
						</label>

						<select name="PaymentMethod"
								id="salePaymentMethod"
								class="form-select fw-bold"
								onchange="togglePaidAmount()">

							<option value="1">كاش (نقدي)</option>
							<option value="2">تحويل بنكي</option>
							<option value="3">دفع جزئي</option>
							<option value="4">آجل (غير مدفوع)</option>

						</select>
					</div>

					<!-- Paid Amount -->
					<div class="col-md-6 d-none" id="salePaidContainer">
						<label class="form-label fw-bold">
							المبلغ المدفوع حالياً (ج.م)
							<span class="text-danger">*</span>
						</label>

						<input type="number"
							   step="0.01"
							   min="0"
							   name="PaidAmount"
							   id="salePaidAmount"
							   value="0"
							   class="form-control form-control-lg fw-bold text-primary"
							   autocomplete="off"
							   oninput="validatePartialPayment()" />

						<div id="paidAmountError" class="text-danger small fw-bold mt-1 d-none">
							المبلغ المدفوع يجب أن يكون أقل من إجمالي البيع.
						</div>

						<div id="paidAmountHint" class="text-muted small mt-1"></div>
					</div>

					<!-- Total -->
					<div class="col-12">
						<div class="p-3 bg-light rounded text-center border">
							<span class="text-muted d-block mb-1">إجمالي قيمة البيع</span>
							<span id="saleTotalAmount" class="fs-4 fw-bold text-success">0.00</span> ج.م
						</div>
					</div>

					<!-- Remaining -->
					<div class="col-12 d-none" id="saleRemainingContainer">
						<div class="p-3 bg-danger bg-opacity-10 rounded text-center border border-danger">
							<span class="text-muted d-block mb-1">المبلغ المتبقي</span>
							<span id="saleRemainingAmount" class="fs-5 fw-bold text-danger">0.00</span> ج.م
						</div>
					</div>

					<!-- Notes -->
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات</label>
						<input type="text" name="Notes" class="form-control" placeholder="أي ملاحظات إضافية..." />
					</div>

				</div>

				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" id="submitSaleBtn" class="btn btn-primary fw-bold">
						<i class="fa-solid fa-check me-1"></i> إتمام البيع والتسجيل بالخزينة
					</button>
				</div>

			</form>

		</div>
	</div>
</div>

<!-- Modal Collect Remaining -->
<div class="modal fade" id="collectModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-1"></i> تحصيل المبلغ المتبقي</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="CollectRemaining" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" name="transactionId" id="collectTxId" />
				<div class="modal-body row g-3">
					<div class="col-12">
						<div class="p-2 border rounded bg-light text-center">
							<strong>المبلغ المتبقي الحالي: </strong>
							<span id="collectRemainingText" class="text-danger fw-bold fs-5"></span> ج.م
						</div>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">المبلغ المحصل الآن (ج.م) <span class="text-danger">*</span></label>
						<input type="number" min="0.01" step="0.01" name="amountToCollect" id="collectAmountInput" required class="form-control form-control-lg fw-bold text-success" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
						<select name="paymentMethod" class="form-select fw-bold">
							<option value="1">كاش (نقدي)</option>
							<option value="2">تحويل بنكي</option>
						</select>
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات التحصيل</label>
						<input type="text" name="notes" class="form-control" placeholder="مثال: تسديد دفعة أخيرة..." />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-success fw-bold"><i class="fa-solid fa-floppy-disk me-1"></i> تأكيد التحصيل بالخزينة</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		// 1. Date Picker - اختيار تاريخ اليوم
		function selectToday() {
			const today = new Date();
			const year = today.getFullYear();
			const month = String(today.getMonth() + 1).padStart(2, '0');
			const day = String(today.getDate()).padStart(2, '0');

			const selectedDate = document.getElementById('selectedDate');
			if (selectedDate) {
				selectedDate.value = `${year}-${month}-${day}`;
			}

			const dateFilterForm = document.getElementById('dateFilterForm');
			if (dateFilterForm) {
				dateFilterForm.submit();
			}
		}

		// 2. Cancel Sale Modal
		function openConfirmCancelModal(id, productName, baskets) {
			const saleId = document.getElementById('cancelSaleId');
			const details = document.getElementById('cancelModalDetailsText');

			if (saleId) {
				saleId.value = id;
			}

			if (details) {
				details.innerText = `سيتم إلغاء بيع عدد (${baskets} باسكت) من منتج (${productName})، وتصحيح الخزينة والمخزون.`;
			}

			const modalElement = document.getElementById('cancelConfirmModal');
			if (modalElement) {
				new bootstrap.Modal(modalElement).show();
			}
		}

		// 3. Collect Remaining Sale Amount
		function openCollectModal(txId, remainingAmount) {
			document.getElementById('collectTxId').value = txId;
			document.getElementById('collectRemainingText').innerText = Number(remainingAmount).toFixed(2);
			
			const input = document.getElementById('collectAmountInput');
			input.value = remainingAmount;
			input.max = remainingAmount;

			const modalElement = document.getElementById('collectModal');
			if (modalElement) {
				new bootstrap.Modal(modalElement).show();
			}
		}

		// 4. Production Order Selected - Sale Modal
		function onOrderSelected() {
			const select = document.getElementById('selectProductionOrder');
			if (!select) return;

			const selectedOption = select.options[select.selectedIndex];
			if (!selectedOption.value) return;

			const available = parseFloat(selectedOption.getAttribute('data-available')) || 0;
			const price = parseFloat(selectedOption.getAttribute('data-price')) || 0;

			const qtyInput = document.getElementById('saleSoldBaskets');
			qtyInput.max = available;

			if (parseFloat(qtyInput.value) > available) {
				qtyInput.value = available;
			}

			document.getElementById('saleBasketPrice').value = price;
			calculateSaleTotal();
		}

		// 5. Calculate Sale Total
		function calculateSaleTotal() {
			const qty = parseFloat(document.getElementById('saleSoldBaskets').value) || 0;
			const price = parseFloat(document.getElementById('saleBasketPrice').value) || 0;
			const total = qty * price;

			document.getElementById('saleTotalAmount').innerText = total.toFixed(2);
			togglePaidAmount();
		}

		// 6. Payment Method - Sale Modal
		function togglePaidAmount() {
			const method = document.getElementById('salePaymentMethod').value;
			const paidContainer = document.getElementById('salePaidContainer');
			const paidInput = document.getElementById('salePaidAmount');
			const remainingContainer = document.getElementById('saleRemainingContainer');
			const submitBtn = document.getElementById('submitSaleBtn');

			const qty = parseFloat(document.getElementById('saleSoldBaskets').value) || 0;
			const price = parseFloat(document.getElementById('saleBasketPrice').value) || 0;
			const total = qty * price;

			// Cash, BankTransfer, or Unpaid
			if (method === "1" || method === "2") {
				paidContainer.classList.add('d-none');
				remainingContainer.classList.add('d-none');
				paidInput.value = total.toFixed(2);
				paidInput.required = false;
				submitBtn.disabled = false;
				clearPaymentError();
				return;
			}

			if (method === "4") {
				paidContainer.classList.add('d-none');
				remainingContainer.classList.add('d-none');
				paidInput.value = "0";
				paidInput.required = false;
				submitBtn.disabled = false;
				clearPaymentError();
				return;
			}

			// Partially paid
			if (method === "3") {
				paidContainer.classList.remove('d-none');
				remainingContainer.classList.remove('d-none');
				paidInput.required = true;

				const currentPaid = parseFloat(paidInput.value) || 0;

				if (currentPaid <= 0 || currentPaid >= total) {
					paidInput.value = total > 0 ? (total / 2).toFixed(2) : "0";
				}

				updateRemainingAmount();
				validatePartialPayment();
			}
		}

		// 7. Validate Partial Payment
		function validatePartialPayment() {
			const qty = parseFloat(document.getElementById('saleSoldBaskets').value) || 0;
			const price = parseFloat(document.getElementById('saleBasketPrice').value) || 0;
			const total = qty * price;
			const paid = parseFloat(document.getElementById('salePaidAmount').value) || 0;

			if (paid <= 0) {
				showPaymentError("يجب إدخال مبلغ أكبر من صفر.");
				return false;
			}

			if (paid >= total && total > 0) {
				showPaymentError("في الدفع الجزئي، المبلغ المدفوع يجب أن يكون أقل من إجمالي البيع.");
				return false;
			}

			clearPaymentError();
			updateRemainingAmount();
			return true;
		}

		// 8. Calculate Remaining Amount
		function updateRemainingAmount() {
			const qty = parseFloat(document.getElementById('saleSoldBaskets').value) || 0;
			const price = parseFloat(document.getElementById('saleBasketPrice').value) || 0;
			const total = qty * price;
			const paid = parseFloat(document.getElementById('salePaidAmount').value) || 0;
			const remaining = Math.max(total - paid, 0);

			const remainingAmount = document.getElementById('saleRemainingAmount');
			if (remainingAmount) {
				remainingAmount.innerText = remaining.toFixed(2);
			}

			const hint = document.getElementById('paidAmountHint');
			if (hint) {
				hint.innerText = `الإجمالي: ${total.toFixed(2)} ج.م - المتبقي: ${remaining.toFixed(2)} ج.م`;
			}
		}

		// 9. Show Payment Error
		function showPaymentError(message) {
			const error = document.getElementById('paidAmountError');
			const submitBtn = document.getElementById('submitSaleBtn');

			if (error) {
				error.innerText = message;
				error.classList.remove('d-none');
			}

			if (submitBtn) {
				submitBtn.disabled = true;
			}
		}

		// 10. Clear Payment Error
		function clearPaymentError() {
			const error = document.getElementById('paidAmountError');
			const submitBtn = document.getElementById('submitSaleBtn');

			if (error) {
				error.classList.add('d-none');
			}

			if (submitBtn) {
				submitBtn.disabled = false;
			}
		}

		// 11. Validate Sale Form Before Submit
		const newSaleForm = document.getElementById('newSaleForm');
		if (newSaleForm) {
			newSaleForm.addEventListener('submit', function(e) {
				const method = document.getElementById('salePaymentMethod').value;
				if (method === "3") {
					const isValid = validatePartialPayment();
					if (!isValid) {
						e.preventDefault();
						return false;
					}
				}
				return true;
			});
		}

		// 12. Reset Sale Modal
		const newSaleModal = document.getElementById('newSaleModal');
		if (newSaleModal) {
			newSaleModal.addEventListener('hidden.bs.modal', function() {
				if (newSaleForm) {
					newSaleForm.reset();
				}

				const paidContainer = document.getElementById('salePaidContainer');
				if (paidContainer) paidContainer.classList.add('d-none');

				const remainingContainer = document.getElementById('saleRemainingContainer');
				if (remainingContainer) remainingContainer.classList.add('d-none');

				const total = document.getElementById('saleTotalAmount');
				if (total) total.innerText = "0.00";

				clearPaymentError();
			});
		}
	</script>
}