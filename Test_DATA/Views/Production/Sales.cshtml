@using Bakery.Domain.Enums
@model IEnumerable<Bakery.Business.DTOs.ProductOrderSalesHistoryDto>
@{
	ViewData["Title"] = "المبيعات";
	var agents = ViewBag.Agents as IEnumerable<Bakery.Business.DTOs.AgentDto> ?? new List<Bakery.Business.DTOs.AgentDto>();
	var availableOrders = ViewBag.AvailableOrders as IEnumerable<Bakery.Business.DTOs.ProductionOrderDto> ?? new List<Bakery.Business.DTOs.ProductionOrderDto>();

	// الوكيل الرئيسي (أول وكيل أو الأكثر نشاطاً)
	var mainAgent = agents.FirstOrDefault();

	// إجمالي كل الوكلاء
	decimal totalBaskets = agents.Sum(a => a.TotalBasketsSold);
	decimal totalSales   = agents.Sum(a => a.TotalSalesAmount);
	decimal totalPaid    = agents.Sum(a => a.TotalPaidAmount);
	decimal totalRemain  = agents.Sum(a => a.TotalRemainingAmount);
}

<!-- Header -->
<div class="page-header-box mb-3 p-3 bg-white rounded-4 border shadow-sm">
	<div class="row align-items-center gy-3">
		<div class="col-md d-flex align-items-center gap-3">
			<div class="rounded-3 d-flex align-items-center justify-content-center"
				 style="width: 48px; height: 48px; background-color: #e3f2fd; color: #0d6efd; flex-shrink: 0;">
				<i class="fa-solid fa-cart-shopping fs-4"></i>
			</div>
			<div>
				<h3 class="fw-bold text-dark mb-1 fs-5">المبيعات</h3>
				<p class="text-muted mb-0 fs-7">تسجيل حركات البيع للوكلاء، ومتابعة الرصيد والتحصيل</p>
			</div>
		</div>
		<div class="col-md-auto ms-auto d-flex gap-2">
			<a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-bold fs-7">
				<i class="fa-solid fa-industry me-1"></i> أوامر الإنتاج
			</a>
			<button class="btn btn-success rounded-3 shadow-sm px-3 py-2 fw-bold fs-7 d-flex align-items-center gap-2"
					data-bs-toggle="modal" data-bs-target="#manageAgentsModal">
				<i class="fa-solid fa-users-gear"></i>
				<span>إدارة الوكلاء</span>
			</button>
			<button class="btn btn-primary rounded-3 shadow-sm px-3 py-2 fw-bold fs-7 d-flex align-items-center gap-2"
					data-bs-toggle="modal" data-bs-target="#newSaleModal">
				<i class="fa-solid fa-cart-plus"></i>
				<span>تسجيل حركة بيع جديدة</span>
			</button>
		</div>
	</div>
</div>

<!-- 📦 Available Baskets Stock Cards (Up-To-Date) 📦 -->
<div class="row g-3 mb-4">
	<div class="col-md-4">
		<div class="card border-0 shadow-sm rounded-4 text-white" style="background: linear-gradient(135deg, #1565c0, #1e88e5);">
			<div class="card-body p-3 d-flex align-items-center justify-content-between">
				<div>
					<span class="small opacity-75 d-block mb-1">رصيد مبروم متاح للبيع</span>
					<span class="fs-3 fw-bold">@((ViewBag.MabroumStock as decimal? ?? 0).ToString("0.##")) <small class="fs-6 fw-normal">باسكت</small></span>
				</div>
				<div class="fs-1 opacity-25">
					<i class="fa-solid fa-cookie"></i>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card border-0 shadow-sm rounded-4 text-white" style="background: linear-gradient(135deg, #2e7d32, #43a047);">
			<div class="card-body p-3 d-flex align-items-center justify-content-between">
				<div>
					<span class="small opacity-75 d-block mb-1">رصيد بانيه متاح للبيع</span>
					<span class="fs-3 fw-bold">@((ViewBag.PaneStock as decimal? ?? 0).ToString("0.##")) <small class="fs-6 fw-normal">باسكت</small></span>
				</div>
				<div class="fs-1 opacity-25">
					<i class="fa-solid fa-cookie-bite"></i>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card border-0 shadow-sm rounded-4 text-white" style="background: linear-gradient(135deg, #d84315, #f4511e);">
			<div class="card-body p-3 d-flex align-items-center justify-content-between">
				<div>
					<span class="small opacity-75 d-block mb-1">رصيد ساندوتش متاح للبيع</span>
					<span class="fs-3 fw-bold">@((ViewBag.SandwichStock as decimal? ?? 0).ToString("0.##")) <small class="fs-6 fw-normal">باسكت</small></span>
				</div>
				<div class="fs-1 opacity-25">
					<i class="fa-solid fa-bread-slice"></i>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- ==========================================
     Landing Page: بطاقات الوكلاء (ملخص كلي)
     ========================================== -->
@if (agents.Any())
{
	<!-- كروت ملخص كل الوكلاء -->
	<div class="row g-3 mb-4">
		@foreach (var agent in agents)
		{
			<div class="col-md-6 col-xl-4">
				<div class="card border-0 shadow-sm rounded-4 h-100" style="border-right: 5px solid #0d6efd !important;">
					<div class="card-body p-3">
						<!-- Agent Header -->
						<div class="d-flex justify-content-between align-items-start mb-3">
							<div>
								<div class="fw-bold fs-5 text-dark">
									<i class="fa-solid fa-user-tie text-primary me-1"></i>
									@agent.Name
								</div>
								@if (!string.IsNullOrEmpty(agent.Phone))
								{
									<div class="text-muted small"><i class="fa-solid fa-phone me-1"></i>@agent.Phone</div>
								}
							</div>
							<div class="d-flex gap-1">
								<button type="button"
										class="btn btn-sm btn-outline-primary px-2 py-1"
										title="تعديل بيانات الوكيل"
										onclick="openEditAgentModal(@agent.Id, '@agent.Name.Replace("'","\\'")', '@(agent.Phone ?? "")', '@(agent.Notes ?? "")')">
									<i class="fa-solid fa-pen-to-square"></i>
								</button>
								<button type="button"
										class="btn btn-sm btn-outline-danger px-2 py-1"
										title="حذف الوكيل"
										onclick="confirmDelete(@agent.Id, '@Url.Action("DeleteAgent")', 'هل أنت متأكد من حذف الوكيل (@agent.Name.Replace("'", "\\'"))؟')">
									<i class="fa-solid fa-trash"></i>
								</button>
							</div>
						</div>

						<!-- Agent Summary Stats -->
						<div class="row g-2 text-center">
							<div class="col-6">
								<div class="p-2 rounded" style="background-color: #f0f4ff;">
									<div class="small text-muted fw-semibold">عدد البساكت</div>
									<div class="fw-bold fs-5 text-primary">@agent.TotalBasketsSold.ToString("0.##")</div>
									<div class="small text-muted">باسكت</div>
								</div>
							</div>
							<div class="col-6">
								<div class="p-2 rounded" style="background-color: #f0f9f0;">
									<div class="small text-muted fw-semibold">إجمالي قيمة المبيعات</div>
									<div class="fw-bold fs-6 text-dark">@agent.TotalSalesAmount.ToString("N0")</div>
									<div class="small text-muted">ج.م</div>
								</div>
							</div>
							<div class="col-6">
								<div class="p-2 rounded" style="background-color: #f0fff4;">
									<div class="small text-muted fw-semibold">المدفوع</div>
									<div class="fw-bold fs-6 text-success">@agent.TotalPaidAmount.ToString("N0")</div>
									<div class="small text-muted">ج.م</div>
								</div>
							</div>
							<div class="col-6">
								<div class="p-2 rounded @(agent.TotalRemainingAmount > 0 ? "bg-danger bg-opacity-10" : "")" style="@(agent.TotalRemainingAmount == 0 ? "background-color: #f8f9fa;" : "")">
									<div class="small fw-semibold @(agent.TotalRemainingAmount > 0 ? "text-danger" : "text-muted")">عليه (المتبقي)</div>
									<div class="fw-bold fs-6 @(agent.TotalRemainingAmount > 0 ? "text-danger" : "text-muted")">
										@agent.TotalRemainingAmount.ToString("N0")
									</div>
									<div class="small @(agent.TotalRemainingAmount > 0 ? "text-danger" : "text-muted")">ج.م</div>
								</div>
							</div>
						</div>

						<!-- Quick Action: تسجيل بيع لهذا الوكيل -->
						<div class="mt-3 d-grid">
							<button type="button"
									class="btn btn-outline-primary btn-sm fw-bold"
									onclick="openNewSaleForAgent(@agent.Id, '@agent.Name.Replace("'","\\'")')">
								<i class="fa-solid fa-cart-plus me-1"></i>تسجيل بيع لهذا الوكيل
							</button>
						</div>
					</div>
				</div>
			</div>
		}

		<!-- بطاقة الإجمالي الكلي -->
		@if (agents.Count() > 1)
		{
			<div class="col-md-6 col-xl-4">
				<div class="card border-0 shadow-sm rounded-4 h-100" style="border-right: 5px solid #ffc107 !important; background: #fffef0;">
					<div class="card-body p-3">
						<div class="fw-bold fs-5 mb-3 text-dark">
							<i class="fa-solid fa-layer-group text-warning me-1"></i> الإجمالي الكلي
						</div>
						<div class="row g-2 text-center">
							<div class="col-6">
								<div class="p-2 rounded bg-white">
									<div class="small text-muted fw-semibold">إجمالي البساكت</div>
									<div class="fw-bold fs-5 text-primary">@totalBaskets.ToString("0.##")</div>
									<div class="small text-muted">باسكت</div>
								</div>
							</div>
							<div class="col-6">
								<div class="p-2 rounded bg-white">
									<div class="small text-muted fw-semibold">إجمالي المبيعات</div>
									<div class="fw-bold fs-6 text-dark">@totalSales.ToString("N0")</div>
									<div class="small text-muted">ج.م</div>
								</div>
							</div>
							<div class="col-6">
								<div class="p-2 rounded bg-white">
									<div class="small text-muted fw-semibold">إجمالي المدفوع</div>
									<div class="fw-bold fs-6 text-success">@totalPaid.ToString("N0")</div>
									<div class="small text-muted">ج.م</div>
								</div>
							</div>
							<div class="col-6">
								<div class="p-2 rounded bg-white">
									<div class="small fw-semibold @(totalRemain > 0 ? "text-danger" : "text-muted")">إجمالي المتبقي</div>
									<div class="fw-bold fs-6 @(totalRemain > 0 ? "text-danger" : "text-muted")">@totalRemain.ToString("N0")</div>
									<div class="small @(totalRemain > 0 ? "text-danger" : "text-muted")">ج.م</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}
else
{
	<div class="alert alert-info rounded-4 shadow-sm mb-4">
		<i class="fa-solid fa-circle-info me-2"></i>
		لم يتم إضافة أي وكيل بعد. أضف وكيلاً أولاً لتتمكن من تسجيل عمليات البيع.
		<button class="btn btn-sm btn-primary ms-3 fw-bold" data-bs-toggle="modal" data-bs-target="#manageAgentsModal">
			<i class="fa-solid fa-plus me-1"></i>إضافة وكيل
		</button>
	</div>
}

<!-- ==========================================
     سجل الحركات التفصيلي (Collapsible)
     ========================================== -->
<div class="card card-custom border-0 shadow-sm rounded-4">
	<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
		<h6 class="fw-bold text-dark mb-0">
			<i class="fa-solid fa-history me-1 text-primary"></i> سجل الحركات التفصيلي
			@if (Model != null && Model.Any())
			{
				<span class="badge bg-primary-subtle text-primary ms-1">@Model.Count() حركة</span>
			}
		</h6>
		<!-- Date Filter -->
		<form asp-action="Sales" method="get" id="dateFilterForm" class="d-flex align-items-center gap-2">
			<label class="fw-bold fs-7 text-dark text-nowrap mb-0">
				<i class="fa-regular fa-calendar-days text-primary me-1"></i> تاريخ:
			</label>
			<input type="date" name="filterDate" id="filterDate"
				   class="form-control form-control-sm bg-white fw-bold shadow-sm"
				   style="max-width: 150px;"
				   value="@(Context.Request.Query["filterDate"].ToString())"
				   onchange="document.getElementById('dateFilterForm').submit();" />
			<button type="button" class="btn btn-sm btn-primary fw-bold px-2 fs-7" onclick="selectToday()">
				<i class="fa-solid fa-calendar-day me-1"></i>اليوم
			</button>
			<a asp-action="Sales" class="btn btn-sm btn-outline-secondary fw-bold px-2 fs-7">
				<i class="fa-solid fa-list me-1"></i>الكل
			</a>
		</form>
	</div>
	<div class="card-body p-0">
		<div class="table-responsive">
			<table class="table table-hover table-bakery mb-0 align-middle text-center">
				<thead class="table-light text-nowrap">
					<tr>
						<th style="min-width: 100px;">التاريخ</th>
						<th style="min-width: 120px;" class="text-start">الوكيل</th>
						<th style="min-width: 130px;" class="text-start">المنتج / الأمر</th>
						<th style="min-width: 90px;">عدد البساكت</th>
						<th style="min-width: 90px;">سعر الباسكيت</th>
						<th style="min-width: 100px;">إجمالي البيع</th>
						<th style="min-width: 90px;">المدفوع</th>
						<th style="min-width: 90px;">المتبقي</th>
						<th style="min-width: 110px;" class="text-center">الإجراءات</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.Any())
					{
						@foreach (var sale in Model)
						{
							<tr>
								<!-- التاريخ -->
								<td class="text-nowrap">
									<div class="fw-bold text-primary fs-7"><i class="fa-regular fa-calendar me-1"></i>@sale.ProductSoldAt.ToString("yyyy/MM/dd")</div>
									<div class="small text-muted fs-7"><i class="fa-regular fa-clock me-1"></i>@sale.ProductSoldAt.ToString("hh:mm tt")</div>
								</td>

								<!-- الوكيل -->
								<td class="text-start">
									<div class="fw-bold text-dark">
										<i class="fa-solid fa-user-tie text-primary me-1"></i>
										@(string.IsNullOrEmpty(sale.AgentName) ? "—" : sale.AgentName)
									</div>
								</td>

								<!-- المنتج / الأمر -->
								<td class="text-start">
									<div class="fw-bold text-dark">بيع <span class="badge bg-amber text-dark px-2 py-1">@sale.SelectedProductTypeName</span></div>
									<small class="text-muted">أمر <span class="fw-bold text-secondary">#@sale.ProductionOrderId</span></small>
								</td>

								<!-- عدد البساكت -->
								<td>
									<span class="fw-bold text-primary fs-6">@sale.SoldBaskets.ToString("0.##")</span>
									<small class="text-muted d-block fs-7">باسكت</small>
								</td>

								<!-- سعر الباسكيت -->
								<td class="text-nowrap fw-bold">@sale.BasketSellingPrice.ToString("N2") <small class="text-muted fs-7">ج.م</small></td>

								<!-- إجمالي البيع -->
								<td class="fw-bold text-dark text-nowrap">@sale.TotalAmount.ToString("N2") <small class="text-muted fs-7">ج.م</small></td>

								<!-- المدفوع -->
								<td class="text-nowrap">
									<div class="fw-bold text-success">@sale.PaidAmount.ToString("N2") <small class="fs-7">ج.م</small></div>
									@switch (sale.PaymentMethod)
									{
										case PaymentMethod.Cash:
											<span class="badge bg-success-subtle text-success border border-success-subtle fs-7 px-2 py-0">كاش</span>
											break;
										case PaymentMethod.BankTransfer:
											<span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-7 px-2 py-0">تحويل</span>
											break;
										case PaymentMethod.PartiallyPaid:
											<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-7 px-2 py-0">جزئي</span>
											break;
										case PaymentMethod.Unpaid:
											<span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-7 px-2 py-0">آجل</span>
											break;
									}
								</td>

								<!-- المتبقي -->
								<td class="text-nowrap">
									@if (sale.RemainingAmount > 0)
									{
										<div class="fw-bold text-danger fs-7">@sale.RemainingAmount.ToString("N2") <small>ج.م</small></div>
									}
									else
									{
										<span class="badge bg-light text-muted border px-2 py-1 fs-7"><i class="fa-solid fa-check me-1"></i>خالص</span>
									}
								</td>

								<!-- الإجراءات -->
								<td class="text-center">
									<div class="d-flex justify-content-center gap-1 align-items-center">
										@if (sale.RemainingAmount > 0)
										{
											<button type="button"
													class="btn btn-sm btn-success fw-bold px-2 py-1 fs-7"
													title="تحصيل المتبقي"
													onclick="openCollectModal(@sale.Id, @sale.RemainingAmount)">
												<i class="fa-solid fa-hand-holding-dollar me-1"></i>تحصيل
											</button>
										}
										<button type="button"
												class="btn btn-sm btn-outline-danger px-2 py-1 fs-7"
												title="إلغاء الحركة"
												onclick="openConfirmCancelModal(@sale.Id, '@sale.SelectedProductTypeName', '@sale.SoldBaskets')">
											<i class="fa-solid fa-rotate-left"></i> إلغاء
										</button>
									</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="9" class="text-center p-4 text-muted">
								<i class="fa-solid fa-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
								لا توجد حركات بيع مسجلة حالياً.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- ==========================================
     Modal: تسجيل عملية بيع جديدة
     ========================================== -->
<div class="modal fade" id="newSaleModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title fw-bold">
					<i class="fa-solid fa-cart-plus me-1"></i> تسجيل عملية بيع جديدة
				</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>

			<form asp-action="RecordSale" method="post" id="newSaleForm">
				@Html.AntiForgeryToken()
				<div class="modal-body row g-3">

					<!-- الوكيل -->
					<div class="col-12">
						<label class="form-label fw-bold">
							الوكيل <span class="text-danger">*</span>
						</label>
						<select name="AgentId" id="saleAgentId" required class="form-select form-select-lg fw-bold">
							<option value="">-- اختر الوكيل --</option>
							@foreach (var agent in agents)
							{
								<option value="@agent.Id">@agent.Name @(!string.IsNullOrEmpty(agent.Phone) ? $"({agent.Phone})" : "")</option>
							}
						</select>
					</div>

					<!-- أمر الإنتاج -->
					<div class="col-12">
						<label class="form-label fw-bold">
							أمر الإنتاج المتاح <span class="text-danger">*</span>
						</label>
						<select name="ProductionOrderId" id="selectProductionOrder" required
								class="form-select form-select-lg fw-bold" onchange="onOrderSelected()">
							<option value="">-- اختر أمر إنتاج --</option>
							@foreach (var order in availableOrders)
							{
								<option value="@order.Id"
										data-available="@order.ActualBaskets"
										data-price="@order.BasketSellingPrice">
									أمر #@order.Id - @order.SelectedProductTypeName
									(المتاح: @order.ActualBaskets.ToString("0.##") باسكت)
								</option>
							}
						</select>
					</div>

					<!-- عدد البساكت -->
					<div class="col-md-6">
						<label class="form-label fw-bold">عدد البساكت <span class="text-danger">*</span></label>
						<input type="number" step="0.01" name="SoldBaskets" id="saleSoldBaskets"
							   min="0.01" value="1" required
							   class="form-control form-control-lg fw-bold text-success"
							   oninput="calculateSaleTotal()" />
					</div>

					<!-- سعر الباسكيت -->
					<div class="col-md-6">
						<label class="form-label fw-bold">سعر الباسكيت (ج.م)</label>
						<input type="number" step="0.01" name="BasketSellingPrice" id="saleBasketPrice"
							   min="0.01" required
							   class="form-control form-control-lg fw-bold"
							   oninput="calculateSaleTotal()" />
					</div>

					<!-- إجمالي قيمة البيع -->
					<div class="col-12">
						<div class="p-3 bg-light rounded text-center border">
							<span class="text-muted d-block mb-1">إجمالي قيمة البيع</span>
							<span id="saleTotalAmount" class="fs-4 fw-bold text-success">0.00</span> ج.م
						</div>
					</div>

					<!-- طريقة الدفع -->
					<div class="col-md-6">
						<label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
						<select name="PaymentMethod" id="salePaymentMethod" class="form-select fw-bold" onchange="togglePaidAmount()">
							<option value="1">كاش (نقدي)</option>
							<option value="2">تحويل بنكي</option>
							<option value="3">دفع جزئي</option>
							<option value="4">آجل (غير مدفوع)</option>
						</select>
					</div>

					<!-- المبلغ المدفوع -->
					<div class="col-md-6 d-none" id="salePaidContainer">
						<label class="form-label fw-bold">المبلغ المدفوع الآن (ج.م) <span class="text-danger">*</span></label>
						<input type="number" step="0.01" min="0" name="PaidAmount" id="salePaidAmount"
							   value="0" class="form-control form-control-lg fw-bold text-primary"
							   autocomplete="off" oninput="validatePartialPayment()" />
						<div id="paidAmountError" class="text-danger small fw-bold mt-1 d-none">
							المبلغ المدفوع يجب أن يكون أقل من إجمالي البيع.
						</div>
						<div id="paidAmountHint" class="text-muted small mt-1"></div>
					</div>

					<!-- المتبقي -->
					<div class="col-12 d-none" id="saleRemainingContainer">
						<div class="p-3 bg-danger bg-opacity-10 rounded text-center border border-danger">
							<span class="text-muted d-block mb-1">المبلغ المتبقي</span>
							<span id="saleRemainingAmount" class="fs-5 fw-bold text-danger">0.00</span> ج.م
						</div>
					</div>

					<!-- ملاحظات -->
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات</label>
						<input type="text" name="Notes" class="form-control" placeholder="أي ملاحظات إضافية..." />
					</div>
				</div>

				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" id="submitSaleBtn" class="btn btn-primary fw-bold">
						<i class="fa-solid fa-check me-1"></i> تسجيل البيع
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- ==========================================
     Modal: إدارة الوكلاء
     ========================================== -->
<div class="modal fade" id="manageAgentsModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-users-gear me-1"></i> إدارة الوكلاء</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<!-- إضافة وكيل جديد -->
				<form asp-action="CreateAgent" method="post" class="mb-4">
					@Html.AntiForgeryToken()
					<h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-plus-circle text-success me-1"></i>إضافة وكيل جديد</h6>
					<div class="row g-2">
						<div class="col-md-4">
							<input type="text" name="Name" required class="form-control fw-bold" placeholder="اسم الوكيل *" />
						</div>
						<div class="col-md-3">
							<input type="text" name="Phone" class="form-control" placeholder="رقم الهاتف" />
						</div>
						<div class="col-md-3">
							<input type="text" name="Notes" class="form-control" placeholder="ملاحظات" />
						</div>
						<div class="col-md-2">
							<button type="submit" class="btn btn-success fw-bold w-100">
								<i class="fa-solid fa-plus me-1"></i>إضافة
							</button>
						</div>
					</div>
				</form>

				<!-- قائمة الوكلاء الحاليين -->
				<h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-list me-1"></i>الوكلاء الحاليون</h6>
				@if (agents.Any())
				{
					<div class="table-responsive">
						<table class="table table-sm align-middle">
							<thead class="table-light">
								<tr>
									<th>الاسم</th>
									<th>الهاتف</th>
									<th>البساكت</th>
									<th>المتبقي</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var agent in agents)
								{
									<tr>
										<td class="fw-bold">@agent.Name</td>
										<td class="text-muted">@(agent.Phone ?? "—")</td>
										<td class="fw-bold text-primary">@agent.TotalBasketsSold.ToString("0.##")</td>
										<td class="fw-bold @(agent.TotalRemainingAmount > 0 ? "text-danger" : "text-muted")">
											@agent.TotalRemainingAmount.ToString("N0") ج.م
										</td>
										<td class="text-end">
											<button type="button"
													class="btn btn-sm btn-outline-primary px-2 py-1"
													onclick="openEditAgentModal(@agent.Id, '@agent.Name.Replace("'", "\\'")', '@(agent.Phone ?? "")', '@(agent.Notes ?? "")')">
												<i class="fa-solid fa-pen"></i>
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				else
				{
					<p class="text-muted text-center">لا يوجد وكلاء حالياً.</p>
				}
			</div>
		</div>
	</div>
</div>

<!-- ==========================================
     Modal: تعديل بيانات الوكيل
     ========================================== -->
<div class="modal fade" id="editAgentModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-1"></i>تعديل بيانات الوكيل</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="UpdateAgent" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" name="Id" id="editAgentId" />
				<div class="modal-body row g-3">
					<div class="col-12">
						<label class="form-label fw-bold">اسم الوكيل <span class="text-danger">*</span></label>
						<input type="text" name="Name" id="editAgentName" required class="form-control form-control-lg fw-bold" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">رقم الهاتف</label>
						<input type="text" name="Phone" id="editAgentPhone" class="form-control" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">ملاحظات</label>
						<input type="text" name="Notes" id="editAgentNotes" class="form-control" />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-primary fw-bold">
						<i class="fa-solid fa-floppy-disk me-1"></i>حفظ التعديلات
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modal: إلغاء حركة البيع -->
<div class="modal fade" id="cancelConfirmModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-danger text-white">
				<h5 class="modal-title fs-6 fw-bold">
					<i class="fa-solid fa-triangle-exclamation me-1"></i> تأكيد إلغاء حركة البيع
				</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body text-center p-4">
				<div class="text-danger mb-3"><i class="fa-solid fa-circle-xmark fs-1"></i></div>
				<h6 class="fw-bold text-dark mb-2">هل أنت متأكد من إلغاء حركة البيع هذه؟</h6>
				<p class="text-muted small mb-0" id="cancelModalDetailsText">
					سيتم خصم المبالغ من الخزينة وإعادة الباسكيتات المباعة لحساب أمر الإنتاج مرة أخرى.
				</p>
			</div>
			<div class="modal-footer bg-light justify-content-center">
				<form id="cancelSaleForm" asp-action="CancelSale" method="post">
					@Html.AntiForgeryToken()
					<input type="hidden" name="id" id="cancelSaleId" />
					<button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">تراجع</button>
					<button type="submit" class="btn btn-danger px-4 fw-bold">
						<i class="fa-solid fa-trash me-1"></i> تأكيد الإلغاء
					</button>
				</form>
			</div>
		</div>
	</div>
</div>

<!-- Modal: تحصيل المتبقي -->
<div class="modal fade" id="collectModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-1"></i> تحصيل المبلغ المتبقي</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="CollectRemaining" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" name="transactionId" id="collectTxId" />
				<div class="modal-body row g-3">
					<div class="col-12">
						<div class="p-2 border rounded bg-light text-center">
							<strong>المبلغ المتبقي الحالي: </strong>
							<span id="collectRemainingText" class="text-danger fw-bold fs-5"></span> ج.م
						</div>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">المبلغ المحصل الآن (ج.م) <span class="text-danger">*</span></label>
						<input type="number" min="0.01" step="0.01" name="amountToCollect" id="collectAmountInput"
							   required class="form-control form-control-lg fw-bold text-success" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
						<select name="paymentMethod" class="form-select fw-bold">
							<option value="1">كاش (نقدي)</option>
							<option value="2">تحويل بنكي</option>
						</select>
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات التحصيل</label>
						<input type="text" name="notes" class="form-control" placeholder="مثال: تسديد دفعة أخيرة..." />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-success fw-bold">
						<i class="fa-solid fa-floppy-disk me-1"></i> تأكيد التحصيل بالخزينة
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		// ── اليوم ──
		function selectToday() {
			const today = new Date();
			const d = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
			const el = document.getElementById('filterDate');
			if (el) { el.value = d; }
			document.getElementById('dateFilterForm').submit();
		}

		// ── فتح نافذة البيع مع تحديد الوكيل مسبقاً ──
		function openNewSaleForAgent(agentId, agentName) {
			const sel = document.getElementById('saleAgentId');
			if (sel) sel.value = agentId;
			const modal = new bootstrap.Modal(document.getElementById('newSaleModal'));
			modal.show();
		}

		// ── أمر الإنتاج ──
		function onOrderSelected() {
			const select = document.getElementById('selectProductionOrder');
			if (!select) return;
			const opt = select.options[select.selectedIndex];
			if (!opt.value) return;
			const available = parseFloat(opt.getAttribute('data-available')) || 0;
			const price = parseFloat(opt.getAttribute('data-price')) || 0;
			const qtyInput = document.getElementById('saleSoldBaskets');
			qtyInput.max = available;
			if (parseFloat(qtyInput.value) > available) qtyInput.value = available;
			document.getElementById('saleBasketPrice').value = price;
			calculateSaleTotal();
		}

		// ── حساب إجمالي البيع ──
		function calculateSaleTotal() {
			const qty = parseFloat(document.getElementById('saleSoldBaskets').value) || 0;
			const price = parseFloat(document.getElementById('saleBasketPrice').value) || 0;
			document.getElementById('saleTotalAmount').innerText = (qty * price).toFixed(2);
			togglePaidAmount();
		}

		// ── طريقة الدفع ──
		function togglePaidAmount() {
			const method = document.getElementById('salePaymentMethod').value;
			const paidContainer = document.getElementById('salePaidContainer');
			const paidInput = document.getElementById('salePaidAmount');
			const remainingContainer = document.getElementById('saleRemainingContainer');
			const submitBtn = document.getElementById('submitSaleBtn');
			const qty = parseFloat(document.getElementById('saleSoldBaskets').value) || 0;
			const price = parseFloat(document.getElementById('saleBasketPrice').value) || 0;
			const total = qty * price;

			if (method === "1" || method === "2") {
				paidContainer.classList.add('d-none');
				remainingContainer.classList.add('d-none');
				paidInput.value = total.toFixed(2);
				paidInput.required = false;
				submitBtn.disabled = false;
				clearPaymentError();
				return;
			}
			if (method === "4") {
				paidContainer.classList.add('d-none');
				remainingContainer.classList.add('d-none');
				paidInput.value = "0";
				paidInput.required = false;
				submitBtn.disabled = false;
				clearPaymentError();
				return;
			}
			// دفع جزئي
			if (method === "3") {
				paidContainer.classList.remove('d-none');
				remainingContainer.classList.remove('d-none');
				paidInput.required = true;
				const currentPaid = parseFloat(paidInput.value) || 0;
				if (currentPaid <= 0 || currentPaid >= total) {
					paidInput.value = total > 0 ? (total / 2).toFixed(2) : "0";
				}
				updateRemainingAmount();
				validatePartialPayment();
			}
		}

		function validatePartialPayment() {
			const qty = parseFloat(document.getElementById('saleSoldBaskets').value) || 0;
			const price = parseFloat(document.getElementById('saleBasketPrice').value) || 0;
			const total = qty * price;
			const paid = parseFloat(document.getElementById('salePaidAmount').value) || 0;
			if (paid <= 0) { showPaymentError("يجب إدخال مبلغ أكبر من صفر."); return false; }
			if (paid >= total && total > 0) { showPaymentError("في الدفع الجزئي، المبلغ المدفوع يجب أن يكون أقل من إجمالي البيع."); return false; }
			clearPaymentError();
			updateRemainingAmount();
			return true;
		}

		function updateRemainingAmount() {
			const qty = parseFloat(document.getElementById('saleSoldBaskets').value) || 0;
			const price = parseFloat(document.getElementById('saleBasketPrice').value) || 0;
			const total = qty * price;
			const paid = parseFloat(document.getElementById('salePaidAmount').value) || 0;
			const remaining = Math.max(total - paid, 0);
			const el = document.getElementById('saleRemainingAmount');
			if (el) el.innerText = remaining.toFixed(2);
			const hint = document.getElementById('paidAmountHint');
			if (hint) hint.innerText = `الإجمالي: ${total.toFixed(2)} ج.م - المتبقي: ${remaining.toFixed(2)} ج.م`;
		}

		function showPaymentError(message) {
			const error = document.getElementById('paidAmountError');
			const submitBtn = document.getElementById('submitSaleBtn');
			if (error) { error.innerText = message; error.classList.remove('d-none'); }
			if (submitBtn) submitBtn.disabled = true;
		}

		function clearPaymentError() {
			const error = document.getElementById('paidAmountError');
			const submitBtn = document.getElementById('submitSaleBtn');
			if (error) error.classList.add('d-none');
			if (submitBtn) submitBtn.disabled = false;
		}

		// ── إلغاء حركة ──
		function openConfirmCancelModal(id, productName, baskets) {
			document.getElementById('cancelSaleId').value = id;
			const details = document.getElementById('cancelModalDetailsText');
			if (details) details.innerText = `سيتم إلغاء بيع عدد (${baskets} باسكت) من منتج (${productName})، وتصحيح الخزينة والمخزون.`;
			new bootstrap.Modal(document.getElementById('cancelConfirmModal')).show();
		}

		// ── تحصيل ──
		function openCollectModal(txId, remainingAmount) {
			document.getElementById('collectTxId').value = txId;
			document.getElementById('collectRemainingText').innerText = Number(remainingAmount).toFixed(2);
			const input = document.getElementById('collectAmountInput');
			input.value = remainingAmount;
			input.max = remainingAmount;
			new bootstrap.Modal(document.getElementById('collectModal')).show();
		}

		// ── تعديل الوكيل ──
		function openEditAgentModal(id, name, phone, notes) {
			document.getElementById('editAgentId').value = id;
			document.getElementById('editAgentName').value = name;
			document.getElementById('editAgentPhone').value = phone;
			document.getElementById('editAgentNotes').value = notes;
			new bootstrap.Modal(document.getElementById('editAgentModal')).show();
		}

		// ── Reset Sale Modal ──
		const newSaleModal = document.getElementById('newSaleModal');
		if (newSaleModal) {
			newSaleModal.addEventListener('hidden.bs.modal', function () {
				document.getElementById('newSaleForm')?.reset();
				document.getElementById('salePaidContainer')?.classList.add('d-none');
				document.getElementById('saleRemainingContainer')?.classList.add('d-none');
				const total = document.getElementById('saleTotalAmount');
				if (total) total.innerText = "0.00";
				clearPaymentError();
			});
		}

		// ── Validate before submit ──
		document.getElementById('newSaleForm')?.addEventListener('submit', function (e) {
			const method = document.getElementById('salePaymentMethod').value;
			if (method === "3") {
				if (!validatePartialPayment()) { e.preventDefault(); return false; }
			}
		});
	</script>
}