@model IEnumerable<Bakery.Business.DTOs.ProductionOrderDto>
@{
	ViewData["Title"] = "الإنتاج اليومي والشكاير";
	var settings = ViewBag.Settings as Bakery.Domain.Entities.ProductionSetting ?? new Bakery.Domain.Entities.ProductionSetting();
}

<div class="page-header-box mb-4 p-3 bg-white rounded-4 border shadow-sm">
	<div class="row align-items-center gy-3">
		<div class="col-md d-flex align-items-center gap-3">
			<div class="rounded-3 d-flex align-items-center justify-content-center"
				 style="width: 52px; height: 52px; background-color: #fff3cd; color: #ffc107; flex-shrink: 0;">
				<i class="fa-solid fa-industry fs-3"></i>
			</div>
			<div>
				<h3 class="fw-bold text-dark mb-1 fs-4">حركة الإنتاج اليومي والتصنيع</h3>
				<p class="text-muted mb-0 small">
					حساب المستهدف تلقائياً بناءً على عدد الشكاير ونوع المنتج، وتسجيل الناتج الفعلي وتأكيد الخصم من المخزن
				</p>
			</div>
		</div>
		<div class="col-md-auto ms-auto d-flex gap-2">
			<!-- زر الانتقال لصفحة المبيعات -->
			<a asp-controller="Production" asp-action="Sales" class="btn btn-outline-primary rounded-3 px-3 py-2 fw-bold d-flex align-items-center gap-2">
				<i class="fa-solid fa-cart-shopping"></i>
				<span>شاشة وسجل المبيعات</span>
			</a>

			<!-- زر فتح أمر إنتاج جديد -->
			<button class="btn btn-bakery rounded-3 shadow-sm px-3 py-2 fw-bold d-flex align-items-center gap-2"
					data-bs-toggle="modal"
					data-bs-target="#newProductionModal">
				<i class="fa-solid fa-plus"></i>
				<span>فتح أمر إنتاج جديد اليوم</span>
			</button>
		</div>
	</div>
</div>

<!-- Config Banner -->
<div class="card card-custom mb-4 p-3 bg-light">
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
		<div class="d-flex align-items-center gap-3">
			<span class="badge bg-amber fs-6">معايير الشكارة الراهنة (بالباسكيت):</span>
			<span class="small fw-bold">مبروم: @(settings.PiecesPerBasket > 0 ? (settings.MabroumPiecesPerSack / (decimal)settings.PiecesPerBasket).ToString("0.##") : 0) باسكت</span> |
			<span class="small fw-bold">بانيه: @(settings.PiecesPerBasket > 0 ? (settings.PanePiecesPerSack / (decimal)settings.PiecesPerBasket).ToString("0.##") : 0) باسكت</span> |
			<span class="small fw-bold">ساندوتش: @(settings.PiecesPerBasket > 0 ? (settings.SandwichPiecesPerSack / (decimal)settings.PiecesPerBasket).ToString("0.##") : 0) باسكت</span> |
			<span class="small fw-bold">قطع الباسكيت: @settings.PiecesPerBasket قطعة</span>
			<span class="badge bg-success fs-6"><i class="fa-solid fa-tag me-1"></i> سعر الباسكيت: @settings.BasketSellingPrice ج.م</span>
		</div>
		<div>
			<a asp-controller="Settings" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-bold">تعديل الإعدادات</a>
		</div>
	</div>
</div>

<!--  Compact Date Filter Box -->
<div class="card border-0 shadow-sm rounded-4 mb-3">
	<div class="card-body p-2 px-3 bg-light rounded-4 border">
		<form asp-action="Index" method="get" id="productionDateFilterForm" class="d-flex align-items-center justify-content-between flex-wrap gap-2">
			<div class="d-flex align-items-center gap-2">
				<label for="startDate" class="fw-bold fs-7 text-dark text-nowrap mb-0">
					<i class="fa-regular fa-calendar-days text-primary me-1"></i> عرض الأوامر من تاريخ:
				</label>
				<input type="date"
					   name="startDate"
					   id="startDate"
					   class="form-control form-control-sm bg-white fw-bold shadow-sm"
					   style="max-width: 150px;"
					   value="@(Context.Request.Query["startDate"].ToString())"
					   onchange="document.getElementById('productionDateFilterForm').submit();" />

				<label for="endDate" class="fw-bold fs-7 text-dark text-nowrap mb-0 ms-2">إلى:</label>
				<input type="date"
					   name="endDate"
					   id="endDate"
					   class="form-control form-control-sm bg-white fw-bold shadow-sm"
					   style="max-width: 150px;"
					   value="@(Context.Request.Query["endDate"].ToString())"
					   onchange="document.getElementById('productionDateFilterForm').submit();" />
			</div>

			<div class="d-flex gap-2 align-items-center">
				<button type="button" class="btn btn-sm btn-primary fw-bold px-3 fs-7" onclick="selectTodayProduction()">
					<i class="fa-solid fa-calendar-day me-1"></i> اليوم
				</button>
				<a asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 fs-7" title="عرض كل الأوامر">
					<i class="fa-solid fa-list me-1"></i> كافة الأوامر
				</a>
			</div>
		</form>
	</div>
</div>

<!-- Production Orders Table -->
<div class="card card-custom">
	<div class="card-body p-0">
		<div class="table-responsive">
			<table class="table table-bakery align-middle mb-0">
				<thead>
					<tr>
						<th>رقم الأمر / التاريخ</th>
						<th>النوع</th>
						<th>عدد الشكاير</th>
						<th>المستهدف (قطع / باسكت)</th>
						<th>الإنتاج الفعلي</th>
						<th>الكمية المباعة </th>
						<th>القيمة المتوقعة</th>
						<th>قيمة المباع فعلياً</th>
						<th>حالة التشغيل</th>
						<th class="text-center" style="min-width: 210px;">الإجراءات والاعتماد</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Any())
					{
						foreach (var order in Model)
						{
							<tr>
								<!-- رقم الأمر والتاريخ -->
								<td>
									<div class="fw-bold text-primary">#@order.Id</div>
									<div class="small text-muted"><i class="fa-regular fa-calendar me-1"></i>@order.ProductionDate.ToString("yyyy/MM/dd")</div>
								</td>

								<!-- النوع -->
								<td><span class="badge bg-amber">@order.SelectedProductTypeName</span></td>

								<!-- عدد الشكاير -->
								<td class="fw-bold fs-6">@order.FlourSackCount <small class="text-muted fw-normal">شكارة</small></td>

								<!-- المستهدف -->
								<td>
									<div class="fw-bold text-dark">@order.TotalTargetPieces <small class="fw-normal">قطعة</small></div>
									<span class="badge bg-light text-dark border">@order.ExpectedBaskets باسكت + @order.RemainingPieces قطعة</span>
								</td>

								<!-- الإنتاج الفعلي -->
								<td>
									@if (order.TotalActualPieces > 0)
									{
										var piecesPerBasket = settings.PiecesPerBasket > 0 ? settings.PiecesPerBasket : 28;
										var totalActualBasketsCalc = order.TotalActualPieces / piecesPerBasket;

										<div class="fw-bold text-dark">@order.TotalActualPieces <small class="fw-normal">قطعة</small></div>
										<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
											(@totalActualBasketsCalc باسكت + @order.RemainingPieces قطعة)
										</span>
									}
									else
									{
										<span class="text-muted fst-italic">لم يسجل بعد</span>
									}
								</td>

								<!-- الكمية المباعة والمتاحة -->
								<td>
									@if (order.SoldBaskets > 0)
									{
										<div class="fw-bold text-primary fs-6">@order.SoldBaskets.ToString("0.##") <small class="text-muted fw-normal">باسكت مباع</small></div>
									}
									else
									{
										<div class="text-muted small mb-1">0 باسكت مباع</div>
									}

									@if (order.TotalActualPieces > 0)
									{
										<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 d-inline-block">
											المتاح: (@order.ActualBaskets باسكت + @order.RemainingPieces قطعة)
										</span>
									}
								</td>

								<!-- المبيعات المتوقعة والفعلية -->
								<td class="fw-bold">@order.TotalExpectedSalesValue.ToString("N2") <small class="text-muted fw-normal">ج.م</small></td>
								<td class="fw-bold text-success">@order.TotalActualSalesValue.ToString("N2") <small class="fw-normal">ج.م</small></td>

								<!-- حالة التشغيل -->
								<td>
									@if (order.Status == ProductionStatus.Confirmed)
									{
										<span class="badge bg-success p-2">
											<i class="fa-solid fa-circle-check me-1"></i> مؤكد ومخصوم
										</span>
									}
									else
									{
										<span class="badge bg-warning text-dark p-2">
											<i class="fa-solid fa-clock me-1"></i> مسودة
										</span>
									}
								</td>

								<!-- الإجراءات والاعتماد -->
								<td class="text-center">
									<div class="d-inline-flex align-items-center justify-content-center gap-1">
										@if (order.Status == ProductionStatus.Draft)
										{
											<button type="button"
													class="btn btn-sm btn-primary fw-bold text-white py-1 px-2"
													title="إدخال وتسجيل الكميات الفعلية"
													onclick="viewOrderDetails(@order.Id)">
												<i class="fa-solid fa-pen-to-square me-1"></i>الإنتاج الفعلي
											</button>

											<button type="button"
													class="btn btn-sm btn-success fw-bold py-1 px-2"
													title="تأكيد الإنتاج"
													onclick="openConfirmProductionModal(@order.Id)">
												<i class="fa-solid fa-check me-1"></i>تأكيد
											</button>

											<button type="button"
													class="btn btn-sm btn-outline-danger py-1 px-2"
													title="حذف الأمر"
													onclick="confirmDelete(@order.Id, '@Url.Action("Delete", "Production")', 'هل أنت متأكد من حذف هذا الأمر؟')">
												<i class="fa-solid fa-trash"></i>
											</button>
										}
										else
										{
											<button type="button"
													class="btn btn-sm btn-outline-info fw-bold py-1 px-2"
													title="عرض تفاصيل أمر الإنتاج"
													onclick="viewOrderDetails(@order.Id)">
												<i class="fa-solid fa-eye me-1"></i>عرض التفاصيل
											</button>
										}
									</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="10" class="text-center p-4 text-muted">لا توجد أوامر إنتاج سابقة. اضغط على فتح أمر إنتاج جديد للبدء.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- Modal Create Production Order -->
<div class="modal fade" id="newProductionModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-amber text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-industry me-1"></i> إنشاء أمر إنتاج يومي جديد</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="Create" method="post">
				<div class="modal-body row g-3">
					<div class="col-md-6">
						<label class="form-label fw-bold">نوع المنتج <span class="text-danger">*</span></label>
						<select name="productType" id="inputProductType" required class="form-select form-select-lg fw-bold" onchange="calculateTargetsLive()">
							<option value="1">مبروم</option>
							<option value="2">بانيه</option>
							<option value="3">ساندوتش</option>
						</select>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">عدد شكاير الدقيق <span class="text-danger">*</span></label>
						<input type="number" step="0.5" name="flourSackCount" id="inputSackCount" required class="form-control form-control-lg fw-bold text-primary" placeholder="مثال: 10" oninput="calculateTargetsLive()" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">سعر بيع الباسكيت لهذا الأمر</label>
						<input type="number" step="0.01" name="customBasketPrice" id="inputBasketPrice" value="@settings.BasketSellingPrice" class="form-control form-control-lg fw-bold" oninput="calculateTargetsLive()" />
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات التشغيل</label>
						<input type="text" name="notes" class="form-control" placeholder="أي ملاحظات عن العجينة أو الوردية..." />
					</div>

					<!-- Live Calculated Target Card -->
					<div class="col-12 mt-3" id="liveCalcCard" style="display: none;">
						<div class="card p-3 bg-light border-primary">
							<h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-calculator me-1"></i> الحسابات التلقائية للمستهدف:</h6>
							<div class="row text-center g-2 mb-3">
								<div class="col-12">
									<div class="p-3 bg-white rounded border">
										<small class="text-muted d-block mb-1">النوع المختار</small>
										<span class="fw-bold text-dark fs-4" id="liveProductTypeName">-</span>
									</div>
								</div>
							</div>
							<div class="row text-center g-2">
								<div class="col-md-4">
									<div class="p-2 bg-warning bg-opacity-25 rounded border">
										<small class="d-block fw-bold text-dark">إجمالي قطع المستهدف</small>
										<span class="fw-bold fs-5" id="liveTotalPieces">0</span>
									</div>
								</div>
								<div class="col-md-4">
									<div class="p-2 bg-info bg-opacity-25 rounded border">
										<small class="d-block fw-bold text-dark">عدد الباسكيت المتوقع</small>
										<span class="fw-bold fs-5" id="liveBaskets">0</span>
									</div>
								</div>
								<div class="col-md-4">
									<div class="p-2 bg-success bg-opacity-25 rounded border">
										<small class="d-block fw-bold text-dark">إجمالي القيمة المتوقعة</small>
										<span class="fw-bold fs-5" id="liveSalesVal">0</span> ج.م
									</div>
								</div>
							</div>
							<h6 class="fw-bold text-dark mt-3 mb-2"><i class="fa-solid fa-boxes-stacked me-1"></i> الخامات المطلوبة ومدى توافرها بالمخزن:</h6>
							<div id="liveMaterialsTableContainer"></div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" id="submitProductionBtn" class="btn btn-bakery fw-bold">حفظ أمر الإنتاج (مسودة)</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modal View & Edit Actual Production -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-dark text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-list-check me-1"></i> تفاصيل أمر الإنتاج وإدخال الفعلي</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="UpdateActual" method="post">
				<input type="hidden" name="id" id="modalOrderId" />
				<div class="modal-body">
					<div id="modalOrderContent">
						<div class="text-center p-4"><span class="spinner-border text-warning"></span> جاري التحميل...</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
					<button type="submit" class="btn btn-success fw-bold" id="saveActualBtn"><i class="fa-solid fa-floppy-disk me-1"></i> حفظ الإنتاج الفعلي والنتائج</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Confirm Production Modal -->
<div class="modal fade" id="confirmProductionModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content border-0">

			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold">
					<i class="fa-solid fa-circle-check me-2"></i>
					تأكيد أمر الإنتاج
				</h5>

				<button type="button"
						class="btn-close btn-close-white ms-0 me-auto"
						data-bs-dismiss="modal">
				</button>
			</div>

			<div class="modal-body text-center p-4">


				<div class="alert alert-warning text-end mb-3">
					<div class="fw-bold mb-1">
						<i class="fa-solid fa-circle-info me-1"></i>
						تنبيه
					</div>

					<h5>
						بعد التأكيد لن يكون بالإمكان تعديل بيانات الإنتاج الفعلية.
					</h5>
				</div>

				<div class="mb-3">
					<i class="fa-solid fa-triangle-exclamation text-warning fs-1"></i>
				</div>

				
				<h5 class="fw-bold mb-3">
					هل أنت متأكد من اعتماد أمر الإنتاج؟
				</h5>

				<p class="text-muted mb-3">
					سيتم اعتماد أمر الإنتاج وخصم الخامات من المخزن.
					يمكن بعد ذلك تسجيل عمليات البيع من شاشة المبيعات.
				</p>

				

				<div class="mt-3 p-3 bg-light rounded border text-end">
					<div>
						<strong>رقم أمر الإنتاج:</strong>
						<span id="confirmProductionOrderId"
							  class="text-primary fw-bold">
							-
						</span>
					</div>
				</div>

			</div>

			<div class="modal-footer">

				<button type="button"
						class="btn btn-secondary"
						data-bs-dismiss="modal">
					إلغاء
				</button>

				<form asp-action="Confirm" method="post" id="confirmProductionForm">
					@Html.AntiForgeryToken()

					<input type="hidden"
						   name="id"
						   id="confirmProductionId" />

					<button type="submit"
							class="btn btn-success fw-bold">

						<i class="fa-solid fa-check me-1"></i>
						نعم، اعتماد أمر الإنتاج
					</button>
				</form>

			</div>

		</div>
	</div>
</div>

@section Scripts {
	<script>
		function calculateTargetsLive() {
			const sacks = parseFloat(document.getElementById('inputSackCount').value) || 0;
			const price = parseFloat(document.getElementById('inputBasketPrice').value) || 0;
			const productType = document.getElementById('inputProductType').value;
			const calcCard = document.getElementById('liveCalcCard');

			if (sacks <= 0) {
				calcCard.style.display = 'none';
				return;
			}

			calcCard.style.display = 'block';

			fetch(`/Production/CalculateApi?flourSackCount=${sacks}&productType=${productType}&customBasketPrice=${price}`)
				.then(res => res.json())
				.then(res => {
					if (res.success) {
						const d = res.data;
						document.getElementById('liveProductTypeName').innerText = d.productTypeName;
						document.getElementById('liveTotalPieces').innerText = d.totalTargetPieces;
						document.getElementById('liveBaskets').innerText = d.expectedBaskets + " باسيكت (" + d.remainingPieces + " قطعة متبقية)";
						document.getElementById('liveSalesVal').innerText = d.totalExpectedSalesValue.toFixed(2);

						let hasShortage = false;
						let matHtml = `<table class="table table-sm table-bordered bg-white text-end mb-0"><thead><tr class="table-secondary"><th>المادة الخام</th><th>المطلوب لـ ${sacks} شكارة</th><th>المتاح بالمخزن</th><th>الحالة</th></tr></thead><tbody>`;
						d.requiredMaterials.forEach(m => {
							if (!m.isSufficient) hasShortage = true;
							const badge = m.isSufficient ? '<span class="badge bg-success">متوفر بالمخزن</span>' : `<span class="badge bg-danger">عجز: ${m.shortage} ${m.measurementUnitName}</span>`;
							matHtml += `<tr><td>${m.materialName}</td><td class="fw-bold">${m.totalRequiredQuantity} ${m.measurementUnitName}</td><td>${m.availableQuantity} ${m.measurementUnitName}</td><td>${badge}</td></tr>`;
						});
						matHtml += `</tbody></table>`;

						if (hasShortage) {
							matHtml += `<div class="alert alert-danger mb-0 mt-2 p-2 fw-bold small"><i class="fa-solid fa-triangle-exclamation me-1"></i> تنبيه: لا يمكن بدء الإنتاج اليومي بسبب وجود عجز في بعض الخامات بالمخزن! يرجى توريد الخامات أولاً.</div>`;
						}

						document.getElementById('liveMaterialsTableContainer').innerHTML = matHtml;

						const submitBtn = document.getElementById('submitProductionBtn');
						if (submitBtn) {
							submitBtn.disabled = hasShortage;
							if (hasShortage) {
								submitBtn.classList.remove('btn-bakery');
								submitBtn.classList.add('btn-secondary');
							} else {
								submitBtn.classList.remove('btn-secondary');
								submitBtn.classList.add('btn-bakery');
							}
						}
					}
				});
		}

		const ordersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

		function viewOrderDetails(id) {
			const order = ordersData.find(o => o.Id === id);
			if (!order) return;

			document.getElementById('modalOrderId').value = order.Id;

			const isConfirmed = order.Status === 2;
			const readonlyAttr = isConfirmed ? "readonly" : "";
			const result = order.OrderResults[0];

			let html = `
				<div class="row g-3 mb-3">
					<div class="col-md-4"><div class="p-2 border rounded bg-light"><strong>النوع:</strong> ${order.SelectedProductTypeName}</div></div>
					<div class="col-md-4"><div class="p-2 border rounded bg-light"><strong>عدد الشكاير:</strong> ${order.FlourSackCount} شكارة</div></div>
					<div class="col-md-4"><div class="p-2 border rounded bg-light"><strong>الحالة:</strong> ${order.StatusName}</div></div>
				</div>
				<h6 class="fw-bold text-primary mb-2">المستهدف مقابل الفعلي:</h6>
				<div class="table-responsive mb-3">
					<table class="table table-bordered align-middle text-center">
						<thead class="table-dark">
							<tr>
								<th>النوع</th>
								<th>الكمية المستهدفة</th>
								<th>الكمية الفعلية المُنتجة</th>
								<th>الفرق</th>
								<th>نسبة الإنجاز</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td class="fw-bold">${result.ProductTypeName}</td>
								<td class="fw-bold text-primary">${result.TargetQuantity} قطعة</td>
								<td>
									<!-- يعرض الفعلي فقط ويمنع السوالب -->
									<input type="number"
										   id="actualQuantityInput"
										   name="actualQuantity"
										   value="${result.ActualQuantity || 0}"
										   min="0"
										   required
										   oninput="if(this.value < 0) this.value = 0; recalculateOrderModal(${result.TargetQuantity}, ${order.ExpectedBaskets}, ${order.TotalExpectedSalesValue});"
										   ${readonlyAttr}
										   class="form-control form-control-sm text-center fw-bold text-success"
										   style="max-width: 120px; margin: 0 auto;" />
								</td>
								<td id="calcDifferenceCell" class="fw-bold">0 قطعة</td>
								<td><span id="calcBadgeCell" class="badge bg-success">0%</span></td>
							</tr>
						</tbody>
					</table>
				</div>
				<div class="row g-2 mt-2 bg-light p-3 rounded">
					<div class="col-md-6"><strong>الباسكت المستهدف:</strong> ${order.ExpectedBaskets} باسكت</div>
					<div class="col-md-6"><strong>الباسكت الفعلي:</strong> <span id="calcActualBaskets" class="fw-bold text-success">0 باسكت</span></div>
					<div class="col-md-6"><strong>قيمة المبيعات المتوقعة:</strong> ${order.TotalExpectedSalesValue.toFixed(2)} ج.م</div>
					<div class="col-md-6"><strong>قيمة المبيعات الفعلية:</strong> <span id="calcActualSalesValue" class="fw-bold text-success">0.00 ج.م</span></div>
				</div>
				<div class="mt-3">
					<label class="form-label fw-bold">ملاحظات أخرى:</label>
					<input type="text" name="notes" value="${order.Notes || ''}" ${isConfirmed ? 'readonly' : ''} class="form-control" />
				</div>
			`;

			document.getElementById('modalOrderContent').innerHTML = html;
			document.getElementById('saveActualBtn').style.display = isConfirmed ? 'none' : 'inline-block';

			// حساب القيم بناءً على القيمة الفعلية
			recalculateOrderModal(result.TargetQuantity, order.ExpectedBaskets, order.TotalExpectedSalesValue);

			new bootstrap.Modal(document.getElementById('orderDetailsModal')).show();
		}

		// دالة الحساب الفوري
		function recalculateOrderModal(targetPieces, expectedBaskets, expectedSalesValue) {
			const input = document.getElementById('actualQuantityInput');
			let actualPieces = parseInt(input.value);

			if (isNaN(actualPieces) || actualPieces < 0) {
				actualPieces = 0;
			}

			// 1. حساب الفرق
			const difference = actualPieces - targetPieces;
			const diffCell = document.getElementById('calcDifferenceCell');
			diffCell.innerText = (difference >= 0 ? `+${difference}` : difference) + " قطعة";
			diffCell.className = `fw-bold ${difference >= 0 ? 'text-success' : 'text-danger'}`;

			// 2. حساب نسبة الإنجاز
			const achievement = targetPieces > 0 ? Math.round((actualPieces / targetPieces) * 100) : 0;
			const badgeCell = document.getElementById('calcBadgeCell');
			badgeCell.innerText = achievement + "%";
			badgeCell.className = `badge ${achievement >= 100 ? 'bg-success' : 'bg-warning text-dark'}`;

			// 3. حساب الباسكت الفعلي والمبيعات الفعلية
			const piecesPerBasket = targetPieces > 0 && expectedBaskets > 0 ? (targetPieces / expectedBaskets) : 28;
			const actualBaskets = (actualPieces / piecesPerBasket).toFixed(1);
			const pricePerPiece = targetPieces > 0 ? (expectedSalesValue / targetPieces) : 0;
			const actualSalesValue = (actualPieces * pricePerPiece).toFixed(2);

			document.getElementById('calcActualBaskets').innerText = `${actualBaskets} باسكت`;
			document.getElementById('calcActualSalesValue').innerText = `${actualSalesValue} ج.م`;
		}



		function openConfirmProductionModal(id) {

			document.getElementById('confirmProductionId').value = id;

			document.getElementById('confirmProductionOrderId').innerText = '#' + id;

			const modalElement = document.getElementById('confirmProductionModal');

			const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

			modal.show();
		}


		function selectTodayProduction() {
			const today = new Date();
			const year = today.getFullYear();
			const month = String(today.getMonth() + 1).padStart(2, '0');
			const day = String(today.getDate()).padStart(2, '0');

			const formattedDate = `${year}-${month}-${day}`;

			const startDate = document.getElementById('startDate');
			const endDate = document.getElementById('endDate');

			if (startDate && endDate) {
				startDate.value = formattedDate;
				endDate.value = formattedDate;
			}

			const form = document.getElementById('productionDateFilterForm');
			if (form) {
				form.submit();
			}
		}

	</script>
}