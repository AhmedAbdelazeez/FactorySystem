@{
	ViewData["Title"] = "الجداول المرجعية للأكواد";
	var categories = ViewBag.Categories as IEnumerable<Bakery.Domain.Entities.ExpenseCategory> ?? new List<Bakery.Domain.Entities.ExpenseCategory>();
	var units = ViewBag.Units as IEnumerable<Bakery.Domain.Entities.MeasurementUnit> ?? new List<Bakery.Domain.Entities.MeasurementUnit>();
	var materialTypes = ViewBag.MaterialTypes as IEnumerable<Bakery.Domain.Entities.MaterialType> ?? new List<Bakery.Domain.Entities.MaterialType>();
}

<div class="page-header-box mb-4 p-3 bg-white rounded-4 border shadow-sm">
	<div class="row align-items-center gy-3">
		<!-- العنوان والأيقونة على اليمين -->
		<div class="col-md d-flex align-items-center gap-3">
			<!-- مربع الأيقونة الأصفر -->
			<div class="rounded-3 d-flex align-items-center justify-content-center"
				 style="width: 52px; height: 52px; background-color: #fff3cd; color: #ffc107; flex-shrink: 0;">
				<i class="fa-solid fa-list fs-3"></i>
			</div>

			<!-- النصوص -->
			<div>
				<h3 class="fw-bold text-dark mb-1 fs-4">الجداول المرجعية والأكواد</h3>
				<p class="text-muted mb-0 small">
					إدارة تصنيفات المصروفات، وحدات القياس، والمواد الخام المستخدمة في الإنتاج
				</p>
			</div>
		</div>
	</div>
</div>

<div class="row g-4">
	<!-- Expense Categories Card -->
	<div class="col-md-4">
		<div class="card card-custom h-100">
			<div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center py-3">
				<span><i class="fa-solid fa-tags text-primary me-2"></i> تصنيفات المصروفات</span>
				<button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
					<i class="fa-solid fa-plus me-1"></i> إضافة تصنيف
				</button>
			</div>
			<div class="card-body p-0">
				<ul class="list-group list-group-flush p-0">
					@foreach (var cat in categories)
					{
						<li class="list-group-item d-flex justify-content-between align-items-center p-3">
							<span class="fw-bold text-dark">@cat.Name</span>
							@if (cat.IsSystem)
							{
								<span class="badge bg-secondary">تصنيف رئيسي بالنظام</span>
							}
							else
							{
								<span class="badge bg-light text-dark border">مُخصص</span>
							}
						</li>
					}
				</ul>
			</div>
		</div>
	</div>

	<!-- Measurement Units Card -->
	<div class="col-md-4">
		<div class="card card-custom h-100">
			<div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center py-3">
				<span><i class="fa-solid fa-scale-balanced text-success me-2"></i> وحدات القياس (المخزن والوصفات)</span>
				<button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#addUnitModal">
					<i class="fa-solid fa-plus me-1"></i> إضافة وحدة
				</button>
			</div>
			<div class="card-body p-0">
				<ul class="list-group list-group-flush p-0">
					@foreach (var u in units)
					{
						<li class="list-group-item d-flex justify-content-between align-items-center p-3">
							<span class="fw-bold text-dark">@u.Name</span>
							<div class="d-flex align-items-center gap-2">
								<button class="btn btn-sm btn-outline-secondary py-1 px-2"
										data-bs-toggle="modal"
										data-bs-target="#editUnitModal-@u.Id"
										title="تعديل">
									<i class="fa-solid fa-pen-to-square"></i>
								</button>

								<button type="button"
										class="btn btn-sm btn-outline-danger py-1 px-2"
										onclick="confirmDelete('@u.Id', '@Url.Action("DeleteUnit", "Lookups")', 'هل أنت متأكد من حذف وحدة القياس (@u.Name)؟')"
										title="حذف">
									<i class="fa-solid fa-trash-can"></i>
								</button>
							</div>
						</li>
					}
				</ul>
			</div>
		</div>
	</div>

	<!-- Material Card -->
	<div class="col-md-4">
		<div class="card card-custom h-100">
			<div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center py-3">
				<span><i class="fa-solid fa-wheat-awn text-warning me-2"></i> المواد الخام</span>
				<button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#addMaterialTypeModal">
					<i class="fa-solid fa-plus me-1"></i> إضافة مادة
				</button>
			</div>
			<div class="card-body p-0">
				<ul class="list-group list-group-flush p-0">
					@foreach (var type in materialTypes)
					{
						<li class="list-group-item d-flex justify-content-between align-items-center p-3">
							<span class="fw-bold text-dark">@type.Name</span>
							<div class="d-flex align-items-center gap-2">
								<button class="btn btn-sm btn-outline-secondary py-1 px-2"
										data-bs-toggle="modal"
										data-bs-target="#editMaterialTypeModal-@type.Id"
										title="تعديل">
									<i class="fa-solid fa-pen-to-square"></i>
								</button>

								<button type="button"
										class="btn btn-sm btn-outline-danger py-1 px-2"
										onclick="confirmDelete('@type.Id', '@Url.Action("DeleteMaterialType", "Lookups")', 'هل أنت متأكد من حذف المادة الخام (@type.Name)؟')"
										title="حذف">
									<i class="fa-solid fa-trash-can"></i>
								</button>
							</div>
						</li>
					}
				</ul>
			</div>
		</div>
	</div>
</div>

<!-- Modal Add Category -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-plus me-1"></i> إضافة تصنيف مصروف جديد</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="AddCategory" method="post">
				<div class="modal-body">
					<label class="form-label fw-bold">اسم التصنيف الجديد <span class="text-danger">*</span></label>
					<input type="text" name="name" required class="form-control" placeholder="مثال: مصاريف صيانة معدات..." />
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-primary">إضافة التصنيف</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modal Add Unit -->
<div class="modal fade" id="addUnitModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-plus me-1"></i> إضافة وحدة قياس جديدة</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="AddUnit" method="post">
				<div class="modal-body">
					<label class="form-label fw-bold">اسم وحدة القياس <span class="text-danger">*</span></label>
					<input type="text" name="name" required class="form-control" placeholder="مثال: عبوة / شوال / كرتونة..." />
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-success">إضافة الوحدة</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modals Edit Measurement Units -->
@foreach (var u in units)
{
	<div class="modal fade" id="editUnitModal-@u.Id" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header bg-success text-white">
					<h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-1"></i> تعديل وحدة القياس</h5>
					<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
				</div>
				<form asp-action="EditUnit" method="post">
					<div class="modal-body">
						<!-- Hidden ID -->
						<input type="hidden" name="Id" value="@u.Id" />

						<div class="mb-3 text-start">
							<label class="form-label fw-bold">اسم وحدة القياس <span class="text-danger">*</span></label>
							<input type="text" name="Name" value="@u.Name" required class="form-control" />
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
						<button type="submit" class="btn btn-success fw-bold">حفظ التعديلات</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

<!-- Modal Add material -->
<div class="modal fade" id="addMaterialTypeModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-warning text-dark">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-plus me-1"></i> إضافة مادة خام جديدة</h5>
				<button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="AddMaterialType" method="post">
				<div class="modal-body">
					<label class="form-label fw-bold">اسم المادة الخام <span class="text-danger">*</span></label>
					<input type="text" name="name" required class="form-control" placeholder="مثال: دقيق / سكر / زبدة..." />
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-warning">إضافة المادة</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modals Edit Material Types -->
@foreach (var type in materialTypes)
{
	<div class="modal fade" id="editMaterialTypeModal-@type.Id" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header bg-warning text-dark">
					<h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-1"></i> تعديل المادة الخام</h5>
					<button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
				</div>
				<form asp-action="EditMaterialType" method="post">
					<div class="modal-body">
						<!-- Hidden ID -->
						<input type="hidden" name="Id" value="@type.Id" />

						<div class="mb-3 text-start">
							<label class="form-label fw-bold">اسم المادة الخام <span class="text-danger">*</span></label>
							<input type="text" name="Name" value="@type.Name" required class="form-control" />
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
						<button type="submit" class="btn btn-warning fw-bold">حفظ التعديلات</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}