@model IEnumerable<Bakery.Business.DTOs.EmployeeListItemDto>
@{
	ViewData["Title"] = "إدارة العاملين بالمخبز";
	var weekdays = ViewBag.Weekdays as List<string> ?? new List<string>();
	var jobTitles = ViewBag.JobTitles as List<string> ?? new List<string>();
}

<div class="row mb-4 align-items-center">
	<div class="col">
		<h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-users text-warning me-2"></i> سجل العاملين بالفرن والمصنع</h2>
		<p class="text-muted mb-0">بيانات العمال والموظفين، الإجازات الأسبوعية، وصرف المرتبات مباشرة لمصروفات العمالة</p>
	</div>
	<div class="col-auto">
		<button class="btn btn-bakery" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
			<i class="fa-solid fa-user-plus me-1"></i> إضافة عامل جديد
		</button>
	</div>
</div>

<div class="card card-custom">
	<div class="card-body p-0">
		<div class="table-responsive">
			<table class="table table-bakery mb-0">
				<thead>
					<tr>
						<th>اسم العامل</th>
						<th>الوظيفة</th>
						<th>السن</th>
						<th>الراتب الشهري</th>
						<th>يوم الإجازة الأسبوعية</th>
						<th>أيام الغياب</th>
						<th>سلف معلقة</th>
						<th>رقم الهاتف</th>
						<th>الحالة</th>
						<th>ملاحظات</th>
						<th class="text-center">الإجراءات وصرف الراتب</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Any())
					{
						foreach (var emp in Model)
						{
							<tr>
								<td class="fw-bold">
								<a asp-action="Details"
								   asp-route-id="@emp.Id"
								   class="text-decoration-none text-primary fw-bold emp-link">
									<i class="fa-solid fa-user-tie text-secondary me-2"></i>@emp.Name
								</a>
							</td>
								<td><span class="badge bg-light text-dark border">@emp.JobTitle</span></td>
								<td>@emp.Age سنة</td>
								<td class="fw-bold text-success">@emp.MonthlySalary.ToString("N2") ج.م</td>
								<td><span class="badge bg-amber">@emp.WeeklyDayOff</span></td>
								<td>
									@if (emp.AbsentDaysSinceLastSalary > 0)
									{
										<span class="badge bg-danger">@emp.AbsentDaysSinceLastSalary يوم</span>
									}
									else
									{
										<span class="badge bg-success">لا يوجد</span>
									}
									)
								</td>
								<td>
									@if (emp.PendingAdvanceAmount > 0)
									{
										<span class="badge bg-warning text-dark fw-bold">@emp.PendingAdvanceAmount.ToString("N2") ج.م</span>
									}
									else
									{
										<span class="text-muted">-</span>
									}
								</td>
								<td>@(string.IsNullOrEmpty(emp.PhoneNumber) ? "-" : emp.PhoneNumber)</td>
								<td>
									@if (emp.IsActive)
									{
										<span class="badge bg-success">نشط</span>
									}
									else
									{
										<span class="badge bg-secondary">غير نشط</span>
									}
								</td>
								<td class="small text-secondary">@emp.Notes</td>

								<td class="text-center">
									<div class="d-flex align-items-center justify-content-center gap-1">
										@if (emp.IsActive)
										{
											<button class="btn btn-sm btn-warning text-nowrap" onclick="openAdvanceModal(@emp.Id, '@emp.Name')">
												<i class="fa-solid fa-hand-holding-dollar me-1"></i>صرف سلفة
											</button>
											<button class="btn btn-sm btn-success text-nowrap" onclick="openPaySalaryModal(@emp.Id, '@emp.Name', @emp.MonthlySalary)">
												<i class="fa-solid fa-money-bill-wave me-1"></i>صرف الراتب
											</button>
										}

										<button class="btn btn-sm btn-outline-primary" onclick="openEditEmployeeModal(@emp.Id, '@emp.Name', '@emp.JobTitle', @emp.Age, @emp.MonthlySalary, '@emp.WeeklyDayOff', '@emp.PhoneNumber', '@emp.Notes', @emp.IsActive.ToString().ToLower())">
											<i class="fa-solid fa-pen"></i>
										</button>

										<button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@emp.Id, '@Url.Action("Delete", "Employees")', 'هل أنت متأكد من حذف العامل &quot;@emp.Name&quot;؟')">
											<i class="fa-solid fa-trash"></i>
										</button>
									</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="9" class="text-center p-4 text-muted">لا يوجد عمال مسجلين بعد. اضغط على إضافة عامل جديد للبدء.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- Modal Add Employee -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-amber text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-1"></i> إضافة عامل جديد</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="Create" method="post">
				<div class="modal-body row g-3">
					<div class="col-12">
						<label class="form-label fw-bold">اسم العامل بالكامل <span class="text-danger">*</span></label>
						<input type="text" name="Name" required class="form-control" placeholder="أدخل اسم العامل..." />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">المسمى الوظيفي <span class="text-danger">*</span></label>
						<input type="text" name="JobTitle" list="jobTitlesList" required class="form-control" placeholder="اختر أو اكتب المسمى..." />
						<datalist id="jobTitlesList">
							@foreach (var jt in jobTitles)
							{
								<option value="@jt"></option>
							}
						</datalist>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">السن (بالسنوات)</label>
						<input type="number" name="Age" min="1" max="100" value="25" class="form-control" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">الراتب الشهري (ج.م)</label>
						<input type="number" step="0.01" min="1" max="1000000" name="MonthlySalary" value="0" class="form-control" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">يوم الإجازة الأسبوعية <span class="text-danger">*</span></label>
						<select name="WeeklyDayOff" class="form-select">
							@foreach (var day in weekdays)
							{
								<option value="@day">@day</option>
							}
						</select>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">رقم الهاتف</label>
						<input type="text" name="PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" />
					</div>
					<div class="col-md-6 d-flex align-items-end">
						<div class="form-check form-switch mb-2">
							<input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="isActiveSwitch">
							<label class="form-check-label fw-bold ms-2" for="isActiveSwitch">حالة العامل: نشط بالشغل</label>
						</div>
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات إضافية</label>
						<input type="text" name="Notes" class="form-control" placeholder="ملاحظات الشخصية أو الخبرة..." />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-bakery">حفظ بيانات العامل</button>
				</div>
			</form>
		</div>
	</div>
</div>


<!-- Modal Edit Employee -->
<div class="modal fade" id="editEmployeeModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-user-pen me-1"></i> تعديل بيانات العامل </h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="Edit" method="post">
				<input type="hidden" name="id" id="editEmpId" />
				<div class="modal-body row g-3">
					<div class="col-12">
						<label class="form-label fw-bold">اسم العامل بالكامل <span class="text-danger">*</span></label>
						<input type="text" name="Name" id="editEmpName" required class="form-control" placeholder="أدخل اسم العامل..." />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">المسمى الوظيفي <span class="text-danger">*</span></label>
						<input type="text" name="JobTitle" id="editEmpJobTitle" list="jobTitlesList" required class="form-control" placeholder="اختر أو اكتب المسمى..." />
						<datalist id="editjobTitlesList">
							@foreach (var jt in jobTitles)
							{
								<option value="@jt"></option>
							}
						</datalist>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold"> (السن (بالسنوات</label>
						<input type="number" name="Age" min="1" max="100" id="editEmpAge" class="form-control" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">الراتب الشهري (ج.م)</label>
						<input type="number" step="0.01" min="1" max="1000000" name="MonthlySalary" id="editEmpSalary" class="form-control" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">يوم الإجازة الأسبوعية <span class="text-danger">*</span></label>
						<select name="WeeklyDayOff" id="editEmpDayOff" class="form-select">
							@foreach (var day in weekdays)
							{
								<option value="@day">@day</option>
							}
						</select>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">رقم الهاتف</label>
						<input type="text" name="PhoneNumber" id="editEmpPhone" class="form-control" placeholder="01xxxxxxxxx" />
					</div>
					<div class="col-md-6 d-flex align-items-end">
						<div class="form-check form-switch mb-2">
							<input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editEmpIsActive">
							<label class="form-check-label fw-bold ms-2" for="editEmpIsActive">حالة العامل: نشط بالشغل</label>
						</div>
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات إضافية</label>
						<input type="text" name="Notes" id="editEmpNotes" class="form-control" placeholder="ملاحظات الشخصية أو الخبرة..." />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-primary">حفظ بيانات العامل</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- Modal Pay Salary -->
<div class="modal fade" id="paySalaryModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-success text-white">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-money-bill-wave me-1"></i> صرف راتب عامل</h5>
				<button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="PaySalary" method="post">
				<input type="hidden" name="employeeId" id="salaryEmpId" />
				<div class="modal-body row g-3">
					<div class="col-12">
						<p class="fw-bold mb-1">اسم العامل: <span id="salaryEmpName" class="text-primary fs-5"></span></p>
					</div>
					<div class="col-12">
						<div class="alert alert-info py-2 mb-0 small">
							<i class="fa-solid fa-circle-info me-1"></i>
							سيتم حساب صافي الراتب تلقائيًا بعد خصم أيام الغياب وأي سلف مصروفة هذا الشهر.
						</div>
					</div>

					<div>
						<div class="col-md-6">
							<label class="form-label fw-bold">شهر الراتب<span class="text-danger">*</span></label>
							<input type="month" name="targetMonth" id="salaryTargetMonth" required class="form-control" />
						</div>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">طريقة الدفع</label>
						<select name="paymentMethod" class="form-select">
							<option value="1">كاش</option>
							<option value="2">تحويل بنكي</option>
						</select>
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات</label>
						<input type="text" name="notes" class="form-control" placeholder="مثال: صرف راتب شهر 7" />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-success fw-bold">تأكيد الصرف والترحيل للخزينة</button>
				</div>
			</form>
		</div>
	</div>
</div>
<!-- Modal Add Advance -->


<div class="modal fade" id="addAdvanceModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-warning text-dark">
				<h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-1"></i> صرف سلفة لعامل</h5>
				<button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="AddAdvance" method="post">
				<input type="hidden" name="employeeId" id="advanceEmpId" />
				<div class="modal-body row g-3">
					<div class="col-12">
						<p class="fw-bold mb-1">اسم العامل: <span id="advanceEmpName" class="text-primary fs-5"></span></p>
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">قيمة السلفة (ج.م) <span class="text-danger">*</span></label>
						<input type="number" step="0.01" name="advanceAmount" required class="form-control fw-bold" />
					</div>
					<div class="col-md-6">
						<label class="form-label fw-bold">طريقة الدفع</label>
						<select name="paymentMethod" class="form-select">
							<option value="1">كاش</option>
							<option value="2">تحويل بنكي</option>
						</select>
					</div>
					<div class="col-12">
						<label class="form-label fw-bold">ملاحظات</label>
						<input type="text" name="notes" class="form-control" placeholder="سبب السلفة (اختياري)" />
					</div>
					<div class="col-12">
						<div class="alert alert-warning py-2 mb-0 small">
							<i class="fa-solid fa-circle-info me-1"></i>
							سيتم خصم قيمة السلفة فورًا من الخزينة، وستُخصم تلقائيًا من راتب هذا الشهر.
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
					<button type="submit" class="btn btn-warning fw-bold">تأكيد صرف السلفة</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		function openPaySalaryModal(id, name,) {
			document.getElementById('salaryEmpId').value = id;
			document.getElementById('salaryEmpName').innerText = name;

			const now = new Date();
			const yyyy = now.getFullYear();
			const mm = String(now.getMonth() + 1).padStart(2, '0');
			document.getElementById('salaryTargetMonth').value = `${yyyy}-${mm}`;

			new bootstrap.Modal(document.getElementById('paySalaryModal')).show();
		}

		function openEditEmployeeModal(id, name, jobTitle, age, salary, dayOff, phone, notes, isActive) {
			document.getElementById('editEmpId').value = id;
			document.getElementById('editEmpName').value = name;
			document.getElementById('editEmpJobTitle').value = jobTitle;
			document.getElementById('editEmpAge').value = age;
			document.getElementById('editEmpSalary').value = salary;
			document.getElementById('editEmpDayOff').value = dayOff;
			document.getElementById('editEmpPhone').value = phone === 'None' ? '' : phone;
			document.getElementById('editEmpNotes').value = notes === 'None' ? '' : notes;
			document.getElementById('editEmpIsActive').checked = isActive;

			new bootstrap.Modal(document.getElementById('editEmployeeModal')).show();
		}

		function openAdvanceModal(id, name) {
			document.getElementById('advanceEmpId').value = id;
			document.getElementById('advanceEmpName').innerText = name;
			new bootstrap.Modal(document.getElementById('addAdvanceModal')).show();
		}

	</script>

	<style>
		.emp-link {
			color: var(--primary-hover) !important;
			
		}

			.emp-link:hover {
				color: var(--primary-hover) !important;
				text-decoration: underline !important;
			}
	</style>
}
