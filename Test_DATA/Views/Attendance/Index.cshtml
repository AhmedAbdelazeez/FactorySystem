@model IEnumerable<Bakery.Domain.Entities.EmployeeAttendance>
@{
    ViewData["Title"] = "حضور وانصراف العاملين";
    var selectedDateStr = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    DateTime.TryParse(selectedDateStr, out DateTime selectedDate);
    var dayOfWeek = selectedDate.DayOfWeek;

    Func<string?, bool> isOffDay = (weeklyDayOff) =>
    {
        if (string.IsNullOrWhiteSpace(weeklyDayOff)) return false;
        var dayName = weeklyDayOff.Trim();
        return dayName switch
        {
            "السبت" => dayOfWeek == DayOfWeek.Saturday,
            "الأحد" or "الاحد" => dayOfWeek == DayOfWeek.Sunday,
            "الإثنين" or "الاثنين" => dayOfWeek == DayOfWeek.Monday,
            "الثلاثاء" => dayOfWeek == DayOfWeek.Tuesday,
            "الأربعاء" or "الاربعاء" => dayOfWeek == DayOfWeek.Wednesday,
            "الخميس" => dayOfWeek == DayOfWeek.Thursday,
            "الجمعة" => dayOfWeek == DayOfWeek.Friday,
            _ => false
        };
    };

    var totalEmployees = Model.Count();
    var presentCount = Model.Count(a => a.IsPresent && !isOffDay(a.Employee?.WeeklyDayOff));
    var absentCount = Model.Count(a => !a.IsPresent && !isOffDay(a.Employee?.WeeklyDayOff));
    var offEmployeesCount = Model.Count(a => isOffDay(a.Employee?.WeeklyDayOff));
}



<!-- Page Header -->
<div class="page-header-box mb-4">
    <div class="row align-items-center g-3">
        <div class="col-md-7">
            <div class="d-flex align-items-center">
                <div class="stat-icon-wrapper bg-warning-subtle text-warning me-3">
                    <i class="fa-solid fa-clipboard-user"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-1">سجل حضور وانصراف العاملين</h3>
                    <p class="text-muted small mb-0">إدارة ومتابعة كشف الحضور اليومي للموظفين بسهولة</p>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <form method="get" class="d-flex align-items-center justify-content-md-end gap-2">
                <span class="fw-bold text-secondary text-nowrap small"><i class="fa-regular fa-calendar me-1"></i> اختر التاريخ:</span>
                <input type="date" name="date" value="@selectedDateStr" class="form-control rounded-3 fw-bold border-secondary-subtle shadow-sm" style="max-width: 170px;" onchange="this.form.submit()" />
                <button type="submit" class="btn btn-primary rounded-3 shadow-sm px-3"><i class="fa-solid fa-filter"></i></button>
            </form>
        </div>
    </div>
</div>

<!-- Stats Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="stat-icon-wrapper bg-primary-subtle text-primary me-3">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">إجمالي الموظفين</span>
                    <span class="fs-4 fw-extrabold text-dark">@totalEmployees</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="stat-icon-wrapper bg-success-subtle text-success me-3">
                    <i class="fa-solid fa-user-check"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">الحاضرين اليوم</span>
                    <span class="fs-4 fw-extrabold text-success">@presentCount</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="stat-icon-wrapper bg-danger-subtle text-danger me-3">
                    <i class="fa-solid fa-user-xmark"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">الغائبين اليوم</span>
                    <span class="fs-4 fw-extrabold text-danger">@absentCount</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="stat-icon-wrapper bg-warning-subtle text-warning me-3">
                    <i class="fa-solid fa-mug-hot"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">إجازة أسبوعية</span>
                    <span class="fs-4 fw-extrabold text-warning">@offEmployeesCount</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Main Card -->
<form asp-action="SaveBulk" method="post">
    <input type="hidden" name="date" value="@selectedDateStr" />
    <div class="attendance-card">
        <!-- Table Header Control Toolbar -->
        <div class="bg-white p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-list-check me-2 text-primary fs-5"></i>
                <span class="fw-bold text-dark">كشف يوم: <span class="text-primary fs-6">@selectedDateStr</span></span>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-success btn-action-sm" onclick="selectAll(true)">
                    <i class="fa-solid fa-check-double me-1"></i> تحديد الكل حاضر
                </button>
                <button type="button" class="btn btn-outline-danger btn-action-sm" onclick="selectAll(false)">
                    <i class="fa-solid fa-xmark me-1"></i> إلغاء تحديد الكل
                </button>
                <button type="submit" class="btn btn-primary btn-action-sm px-3 shadow-sm">
                    <i class="fa-solid fa-floppy-disk me-1"></i> حفظ الكشف
                </button>
            </div>
        </div>

        <!-- Table View -->
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 60px;" class="text-center">حضر؟</th>
                        <th>اسم الموظف</th>
                        <th>الوظيفة</th>
                        <th>وقت التسجيل</th>
                        <th>الحالة الراهنة</th>
                        <th>ملاحظات</th>
                        <th class="text-center">إجراء سريع</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var emp = item.Employee;
                            bool isEmpOff = isOffDay(emp?.WeeklyDayOff);

                            <tr class="@(isEmpOff ? "tr-off-day" : "")">
                                <td class="text-center">
                                    <input type="checkbox" name="presentEmployeeIds" value="@item.EmployeeId"
                                           class="form-check-input emp-check fs-5 rounded-3 cursor-pointer"
                                    @(item.IsPresent ? "checked" : "")
                                    @(isEmpOff ? "disabled" : "") />
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm rounded-circle bg-light d-flex align-items-center justify-content-center me-2 text-secondary" style="width: 35px; height: 35px;">
                                            <i class="fa-solid fa-user-tie"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@(emp?.Name ?? "موظف")</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-secondary border rounded-2 px-2 py-1">@(emp?.JobTitle ?? "-")</span></td>
                                <td>
                                    @if (item.IsPresent && item.CheckInTime.HasValue)
                                    {
                                        <span class="text-primary fw-semibold small"><i class="fa-regular fa-clock me-1"></i> @item.CheckInTime.Value.ToString("hh:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (isEmpOff)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis status-badge border border-warning-subtle">
                                            <i class="fa-solid fa-umbrella-beach me-1"></i> إجازة أسبوعية
                                        </span>
                                    }
                                    else if (item.IsPresent)
                                    {
                                        <span class="badge bg-success-subtle text-success status-badge border border-success-subtle">
                                            <i class="fa-solid fa-circle-check me-1"></i> حاضر
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger status-badge border border-danger-subtle">
                                            <i class="fa-solid fa-circle-xmark me-1"></i> غائب
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</span>
                                </td>
                                <td class="text-center">
                                    @if (isEmpOff)
                                    {
                                        <span class="badge bg-light text-muted border px-3 py-2 rounded-3 small">غير متاح (إجازة)</span>
                                    }
                                    else if (item.IsPresent)
                                    {
                                        <form asp-action="Confirm" method="post" class="d-inline">
                                            <input type="hidden" name="employeeId" value="@item.EmployeeId" />
                                            <input type="hidden" name="date" value="@selectedDateStr" />
                                            <input type="hidden" name="isPresent" value="false" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-action-sm">
                                                <i class="fa-solid fa-user-minus me-1"></i> تسجيل كـ غائب
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Confirm" method="post" class="d-inline">
                                            <input type="hidden" name="employeeId" value="@item.EmployeeId" />
                                            <input type="hidden" name="date" value="@selectedDateStr" />
                                            <input type="hidden" name="isPresent" value="true" />
                                            <button type="submit" class="btn btn-sm btn-success btn-action-sm shadow-sm">
                                                <i class="fa-solid fa-user-check me-1"></i> تأكيد الحضور
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-slash fs-1 d-block mb-3 opacity-25"></i>
                                لا يوجد موظفين مسجلين في النظام بعد.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function selectAll(status) {
            const checks = document.querySelectorAll('.emp-check:not(:disabled)');
            checks.forEach(chk => chk.checked = status);
        }
    </script>
}